// اختبارات متطلبات الإصدار (src/registry/requirement.sn).
استورد المكتبة.دخ.println;
استورد المكتبة.إصدار.semver;
استورد سوباكس.support.text;
استورد سوباكس.registry.requirement;

عرف فحص(م: نص, ق: نص, متوقع: منطقي): عدد {
    دع المتطلب: متطلب_إصدار;
    طابق حلل_متطلبا(&م) مع
    | نتيجة.خطأ(س) -> { اطبع_سطر(ضم([«ERR », س])); أرجع 1; }
    | نتيجة.نجح(ت) -> { المتطلب := ت; };
    طابق حلل_إصدارا(&ق) مع
    | اختياري.لا_شيء -> { اطبع_سطر(«bad version»); أرجع 1; }
    | اختياري.موجود(إ) -> {
        إذا (يطابق_المتطلب(&المتطلب, &إ) != متوقع) { اطبع_سطر(ضم([«FAIL », م, « ~ », ق])); أرجع 1; };
    };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    دع خ: متغير عدد = 0;
    خ := خ + فحص(«1.2.3», «1.2.3», صواب) + فحص(«1.2.3», «1.9.0», صواب) + فحص(«1.2.3», «2.0.0», خطأ) + فحص(«1.2.3», «1.2.2», خطأ);
    خ := خ + فحص(«^0.2.3», «0.2.9», صواب) + فحص(«^0.2.3», «0.3.0», خطأ) + فحص(«^0.0.3», «0.0.4», خطأ) + فحص(«^0.0.3», «0.0.3», صواب);
    خ := خ + فحص(«^0.0», «0.0.7», صواب) + فحص(«^0.0», «0.1.0», خطأ) + فحص(«^0», «0.9.0», صواب) + فحص(«^0», «1.0.0», خطأ);
    خ := خ + فحص(«~1.2.3», «1.2.9», صواب) + فحص(«~1.2.3», «1.3.0», خطأ) + فحص(«~1», «1.9.0», صواب) + فحص(«~1», «2.0.0», خطأ);
    خ := خ + فحص(«=1.2.3», «1.2.3», صواب) + فحص(«=1.2.3», «1.2.4», خطأ) + فحص(«=1.2», «1.2.9», صواب) + فحص(«=1.2», «1.3.0», خطأ);
    خ := خ + فحص(«>=1.2, <1.5», «1.4.9», صواب) + فحص(«>=1.2, <1.5», «1.5.0», خطأ) + فحص(«>1.2», «1.2.9», خطأ) + فحص(«>1.2», «1.3.0», صواب);
    خ := خ + فحص(«>1.2.3», «1.2.3», خطأ) + فحص(«<=1.2», «1.2.9», صواب) + فحص(«<=1.2», «1.3.0», خطأ) + فحص(«<=1.2.3», «1.2.3», صواب);
    خ := خ + فحص(«*», «9.9.9», صواب) + فحص(«1.*», «1.7.0», صواب) + فحص(«1.*», «2.0.0», خطأ) + فحص(«1.2.*», «1.2.5», صواب) + فحص(«1.2.*», «1.3.0», خطأ);
    خ := خ + فحص(«1.2», «1.3.0-beta.1», خطأ) + فحص(«^1.3.0-beta.1», «1.3.0-beta.2», صواب) + فحص(«^1.3.0-beta.1», «1.3.0», صواب) + فحص(«^1.3.0-beta.1», «1.4.0-beta.1», خطأ);
    خ := خ + فحص(«1.0.0», «1.0.0+build5», صواب);
    دع ب: نص = «1.x.2»;
    طابق حلل_متطلبا(&ب) مع | نتيجة.نجح(_) -> { اطبع_سطر(«FAIL accepted 1.x.2»); خ := خ + 1; } | نتيجة.خطأ(_) -> { };
    دع ج: نص = «>=abc»;
    طابق حلل_متطلبا(&ج) مع | نتيجة.نجح(_) -> { اطبع_سطر(«FAIL accepted >=abc»); خ := خ + 1; } | نتيجة.خطأ(_) -> { };
    إذا (خ != 0) { اطبع_سطر(ضم([«failures: », رقم_نصا(خ مثل طبيعي)])); };
    أرجع خ;
}
