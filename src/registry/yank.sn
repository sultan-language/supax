// supax yank [<الاسم>@]<الإصدار> [--undo] [--index <دليل>]، مثل cargo yank.
//
// الإصدار المسحوب لا يُختار لحل جديد، ويبقى يعمل لكل Supax.lock ثبّته. ولأن
// الفهرس اليوم مستودع git، يعدّل الأمر نسخة محلية منه (--index، أو الدليل
// الحالي): يضيف `yanked = true` إلى مدخل [[versions]] لذلك الإصدار، أو يحذفه
// مع --undo، ولا يمس شيئا آخر في الملف. ثم يلتزم صاحب الحزمة بالتغيير ويرسل
// طلب دمج إلى الفهرس. وبلا اسم: الحزمة في الدليل الحالي.
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.مجموعات.متجهات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.عمليات.الوسائط;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.اخرج;
استورد المكتبة.تومل.محلل;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.أذونات;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.support.status;
استورد سوباكس.manifest.toml;
استورد سوباكس.manifest.manifest;
استورد سوباكس.cli.args;
استورد سوباكس.cli.project;
استورد سوباكس.build.compiler;
استورد سوباكس.registry.requirement;
استورد سوباكس.registry.index;
استورد سوباكس.source.git;
استورد سوباكس.support.names;
استورد سوباكس.resolve.resolver;

// أسطر النص بلا محارف السطر الجديد؛ يُحفظ \r إن وُجد ليعود كما كان.
عرف أسطر_الملف(النص: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == 10) {
            ألحق(الناتج, شريحة_نص(النص, البداية, ف));
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    إذا (البداية < طول_النص(النص)) { ألحق(الناتج, شريحة_نص(النص, البداية, طول_النص(النص))); };
    أرجع الناتج;
}

عرف صل_أسطر_الملف(الأسطر: &متجه نص): نص {
    دع الفاصل: نص = سطر_جديد();
    أرجع ضم([صل_النصوص(الأسطر, &الفاصل), سطر_جديد()]);
}

// المفتاح في سطر «مفتاح = قيمة» (مقصوصا)، أو «» إن لم يكن كذلك.
عرف مفتاح_السطر(السطر: &نص): نص {
    دع م: نص = قص_النص(السطر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(&م) && م[ف] != 61 && م[ف] != 32 && م[ف] != 9) { ف := ف + 1; }
    دع المفتاح: نص = شريحة_نص(&م, 0, ف);
    طالما (ف < طول_النص(&م) && (م[ف] == 32 || م[ف] == 9)) { ف := ف + 1; }
    إذا (ف >= طول_النص(&م) || م[ف] != 61) { أرجع «»; };
    أرجع المفتاح;
}

// القيمة بعد «=» مقصوصة، بلا تعليق في آخرها.
عرف قيمة_السطر(السطر: &نص): نص {
    دع م: نص = قص_النص(السطر);
    دع المساواة: طبيعي = موضع_بايت(&م, 61, 0);
    إذا (المساواة >= طول_النص(&م)) { أرجع «»; };
    دع القيمة: نص = قص_النص(&شريحة_نص(&م, المساواة + 1, طول_النص(&م)));
    // سلسلة بين علامتي تنصيص: ما بينهما.
    إذا (طول_النص(&القيمة) > 0 && القيمة[0] == 34) {
        دع النهاية: طبيعي = موضع_بايت(&القيمة, 34, 1);
        أرجع شريحة_نص(&القيمة, 1, النهاية);
    };
    دع التعليق: طبيعي = موضع_بايت(&القيمة, 35, 0);
    أرجع قص_النص(&شريحة_نص(&القيمة, 0, التعليق));
}

عرف ترويسة(السطر: &نص): منطقي {
    دع م: نص = قص_النص(السطر);
    أرجع طول_النص(&م) > 0 && م[0] == 91;
}

// نتيجة التعديل: النص الجديد، وهل تغير شيء.
نوع تعديل_سحب = { النص: نص, تغير: منطقي };

// يضع yanked = true في مدخل الإصدار أو يحذفه. خطأ إن لم يوجد الإصدار.
عرف عدّل_المدخل(النص: &نص, الإصدار: &نص, سحب: منطقي, الملف: &نص): نتيجة تعديل_سحب, نص {
    دع الأسطر: متجه نص = أسطر_الملف(النص);
    دع العدد: طبيعي = الطول(الأسطر) مثل طبيعي;
    دع الإصدارات: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (يساوي_نصا(&قص_النص(&الأسطر[ف]), «[[versions]]»)) {
            // المدخل: من بعد الترويسة إلى الترويسة التالية أو آخر الملف.
            دع النهاية: متغير طبيعي = ف + 1;
            طالما (النهاية < العدد && !ترويسة(&الأسطر[النهاية])) { النهاية := النهاية + 1; }
            دع سطر_الإصدار: متغير نص = «»;
            دع سطر_السحب: متغير طبيعي = العدد;
            دع ح: متغير طبيعي = ف + 1;
            طالما (ح < النهاية) {
                دع المفتاح: نص = مفتاح_السطر(&الأسطر[ح]);
                إذا (يساوي_نصا(&المفتاح, «version»)) { سطر_الإصدار := قيمة_السطر(&الأسطر[ح]); };
                إذا (يساوي_نصا(&المفتاح, «yanked»)) { سطر_السحب := ح; };
                ح := ح + 1;
            }
            ألحق(الإصدارات, انسخ_نص(&سطر_الإصدار));
            إذا (نصان_متساويان(&سطر_الإصدار, الإصدار)) {
                دع مسحوب_الآن: منطقي = سطر_السحب < العدد && يساوي_نصا(&قيمة_السطر(&الأسطر[سطر_السحب]), «true»);
                إذا (مسحوب_الآن == سحب) {
                    دع ت: تعديل_سحب = { النص: انسخ_نص(النص), تغير: خطأ };
                    أرجع نتيجة.نجح(ت);
                };
                دع الجديد: متغير متجه نص = [];
                إذا (سحب) {
                    // yanked = false يصبح true، وإلا يُضاف السطر بعد آخر سطر غير فارغ في المدخل.
                    دع الموضع: متغير طبيعي = النهاية;
                    طالما (الموضع > ف + 1 && طول_النص(&قص_النص(&الأسطر[الموضع - 1])) == 0) { الموضع := الموضع - 1; }
                    ح := 0;
                    طالما (ح < العدد) {
                        إذا (ح == سطر_السحب) {
                            ألحق(الجديد, «yanked = true»);
                        } وإلا {
                            إذا (ح == الموضع && سطر_السحب == العدد) { ألحق(الجديد, «yanked = true»); };
                            ألحق(الجديد, انسخ_نص(&الأسطر[ح]));
                        };
                        ح := ح + 1;
                    }
                    إذا (الموضع == العدد && سطر_السحب == العدد) { ألحق(الجديد, «yanked = true»); };
                } وإلا {
                    ح := 0;
                    طالما (ح < العدد) {
                        إذا (ح != سطر_السحب) { ألحق(الجديد, انسخ_نص(&الأسطر[ح])); };
                        ح := ح + 1;
                    }
                };
                دع ت: تعديل_سحب = { النص: صل_أسطر_الملف(&الجديد), تغير: صواب };
                أرجع نتيجة.نجح(ت);
            };
            ف := النهاية;
        } وإلا {
            ف := ف + 1;
        };
    }
    دع الفاصل: نص = «, »;
    أرجع نتيجة.خطأ(ضم([انسخ_نص(الملف), رسالة(«: لا يوجد إصدار », «: there is no version »), انسخ_نص(الإصدار),
        رسالة(«. الإصدارات: », «. Versions: »), صل_النصوص(&الإصدارات, &الفاصل)]));
}

// نسخة محلية من الفهرس: config.toml (version = 1) والدليل packages/.
عرف تحقق_من_نسخة_الفهرس(الدليل: &نص): نتيجة نص, نص {
    دع الإعداد: نص = صل_المسار(الدليل, &«config.toml»);
    دع الحزم: نص = صل_المسار(الدليل, &«packages»);
    دع لها_حزم: متغير منطقي = خطأ;
    طابق اقرأ_مدخلات_الدليل(&الحزم) مع
    | نتيجة.نجح(_) -> { لها_حزم := صواب; }
    | نتيجة.خطأ(_) -> { };
    إذا (!ملف_موجود(&الإعداد) || !لها_حزم) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(الدليل), رسالة(« ليس نسخة من فهرس الحزم (لا config.toml ولا packages/). انسخ الفهرس ثم مرر دليله:»,
            « is not a clone of the package index (no config.toml and packages/). Clone the index, then pass its folder:»), سطر_جديد(),
            «  git clone », رابط_الفهرس(), سطر_جديد(),
            «  supax yank <name>@<version> --index <dir>»]));
    };
    دع الوثيقة: وثيقة_تومل;
    طابق اقرأ_الملف(&الإعداد) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة », «cannot read »), الإعداد])); }
    | نتيجة.نجح(النص) -> {
        طابق حلل_تومل(&النص) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([الإعداد, رسالة(«: ليس TOML صالحا», «: not valid TOML»)])); }
        | نتيجة.نجح(و) -> { الوثيقة := و; };
    };
    دع المفتاح: نص = «version»;
    طابق قيمة_مفتاح_تومل(&الوثيقة, الوثيقة.الجذر, &المفتاح) مع
    | اختياري.موجود(قيمة_تومل.عدد(ق)) -> {
        إذا (يساوي_نصا(&ق, «1»)) { أرجع نتيجة.نجح(«»); };
        أرجع نتيجة.خطأ(ضم([الإعداد, رسالة(«: صيغة الفهرس », «: index format version »), انسخ_نص(&ق),
            رسالة(«؛ هذا الإصدار من سوباكس يعرف الصيغة 1 فقط؛ حدّث سوباكس», «; this Supax only knows version 1; update Supax»)]));
    }
    | _ -> { أرجع نتيجة.خطأ(ضم([الإعداد, رسالة(«: يحتاج version = 1», «: needs version = 1»)])); };
}

عام عرف نفّذ_السحب(الطلب: &طلب): نتيجة عدد, نص {
    دع الاستخدام: نص = رسالة(«الاستخدام: supax yank [<الاسم>@]<الإصدار> [--undo] [--index <دليل>]»,
        «usage: supax yank [<name>@]<version> [--undo] [--index <dir>]»);
    // الاسم والإصدار: الاسم@الإصدار، أو الإصدار وحده (أو --version) لحزمة الدليل الحالي.
    دع الاسم: متغير نص = «»;
    دع الإصدار: متغير نص = قيمة_الخيار(الطلب, «version»);
    دع عدد_المسماة: طبيعي = الطول((*الطلب).المسماة) مثل طبيعي;
    إذا (عدد_المسماة > 1 || (عدد_المسماة == 0 && طول_النص(&الإصدار) == 0)) { أرجع نتيجة.خطأ(الاستخدام); };
    إذا (عدد_المسماة == 1) {
        دع الكامل: نص = انسخ_نص(&(*الطلب).المسماة[0]);
        دع آت: طبيعي = موضع_بايت(&الكامل, 64, 0);
        إذا (آت < طول_النص(&الكامل)) {
            الاسم := شريحة_نص(&الكامل, 0, آت);
            إذا (طول_النص(&الإصدار) > 0) {
                أرجع نتيجة.خطأ(رسالة(«اذكر الإصدار مرة واحدة: الاسم@الإصدار أو --version», «give the version once: name@version or --version»));
            };
            الإصدار := شريحة_نص(&الكامل, آت + 1, طول_النص(&الكامل));
        } وإلا إذا (طول_النص(&الإصدار) > 0) {
            الاسم := الكامل;
        } وإلا {
            الإصدار := الكامل;
        };
    };
    إذا (طول_النص(&الاسم) == 0) {
        دع الجذر: نص = ابحث_عن_المشروع()؟;
        دع البيان: بيان = اقرأ_البيان(&الجذر, تحقق_رابط)؟;
        الاسم := انسخ_نص(&البيان.الاسم);
    };
    إذا (!معرف_صالح(&الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«اسم الحزمة "», «package name "»), انسخ_نص(&الاسم), رسالة(«" ليس معرفا صالحا», «" is not a valid identifier»)]));
    };
    طابق حلل_إصدارا(&الإصدار) مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(ضم([رسالة(«الإصدار "», «version "»), انسخ_نص(&الإصدار), رسالة(«" ليس إصدارا دلاليا مثل 1.2.0», «" is not a semantic version such as 1.2.0»)]));
    };
    // نسخة الفهرس.
    دع المعطى: نص = قيمة_الخيار(الطلب, «index»);
    دع الدليل: متغير نص = «»;
    إذا (طول_النص(&المعطى) > 0) {
        طابق مسار_قانوني(&المعطى) مع
        | نتيجة.نجح(د) -> { الدليل := د; }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«لا يوجد دليل », «no such directory: »), انسخ_نص(&المعطى)])); };
    } وإلا {
        طابق دليل_العمل() مع
        | نتيجة.نجح(د) -> { الدليل := د; }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذرت معرفة دليل العمل», «cannot determine the working directory»)); };
    };
    تحقق_من_نسخة_الفهرس(&الدليل)؟;
    دع النسبي: نص = مسار_في_الفهرس(&الاسم);
    دع الملف: نص = صل_المسار(&الدليل, &النسبي);
    دع النص: نص;
    طابق اقرأ_الملف(&الملف) مع
    | نتيجة.نجح(ق) -> { النص := ق; }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(ضم([رسالة(«لا توجد حزمة باسم "», «no package named "»), انسخ_نص(&الاسم), رسالة(«" في الفهرس: », «" in the index: »), النسبي, رسالة(« غير موجود», « does not exist»)]));
    };
    دع سحب: منطقي = !علم_معطى(الطلب, «undo»);
    دع الناتج: تعديل_سحب = عدّل_المدخل(&النص, &الإصدار, سحب, &النسبي)؟;
    دع الوصف: نص = ضم([انسخ_نص(&الاسم), «@», انسخ_نص(&الإصدار)]);
    إذا (!الناتج.تغير) {
        إذا (سحب) {
            اطبع_سطر(ضم([الوصف, رسالة(« مسحوب من قبل في », « is already yanked in »), النسبي]));
        } وإلا {
            اطبع_سطر(ضم([الوصف, رسالة(« غير مسحوب في », « is not yanked in »), النسبي]));
        };
        أرجع نتيجة.نجح(0);
    };
    // التحقق: النص الجديد TOML صالح قبل أن يُكتب.
    طابق حلل_تومل(&الناتج.النص) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([النسبي, رسالة(«: تعذر التعديل دون كسر TOML؛ عدّله يدويا», «: cannot change it without breaking the TOML; edit it by hand»)])); }
    | نتيجة.نجح(_) -> { };
    اكتب_إن_تغير(&الملف, &الناتج.النص)؟;
    إذا (سحب) {
        أعلن(«يسحب», «Yank», ضم([الوصف, رسالة(« في », « in »), النسبي]));
    } وإلا {
        أعلن(«يعيد», «Unyank», ضم([الوصف, رسالة(« في », « in »), النسبي]));
    };
    اطبع_سطر(ضم([رسالة(«التزم بالتغيير في », «Commit the change in »), الدليل,
        رسالة(« وأرسل طلب دمج إلى الفهرس؛ يسري على الجميع حين يُدمج.», « and open a pull request to the index; it applies to everyone once it is merged.»)]));
    أرجع نتيجة.نجح(0);
}

// supax publish: لا موقع للسجل بعد، فيفحص الإصدار كما يفعل supax package ثم
// يشرح النشر اليدوي. يُعاد كتابته حين يتوفر موقع السجل.
عام عرف اشرح_النشر(الملف: &نص, المدخل: &نص, الاسم: &نص, الإصدار: &نص): فراغ {
    اطبع_سطر(رسالة(«لم يُرفع شيء: موقع سجل الحزم غير متاح بعد. سيرفع supax publish الحزمة مباشرة حين يتوفر.»,
        «Nothing was uploaded: the package registry website is not available yet. supax publish will upload directly once it is ready.»));
    اطبع_سطر(«»);
    اطبع_سطر(ضم([رسالة(«لنشر », «To publish »), انسخ_نص(الاسم), « v», انسخ_نص(الإصدار), رسالة(« الآن:», « now:»)]));
    اطبع_سطر(رسالة(«  1. ادفع هذا الالتزام إلى المستودع العام.», «  1. Push this commit to the public repository.»));
    اطبع_سطر(ضم([رسالة(«  2. انسخ مستودع الفهرس: git clone », «  2. Clone the index repository: git clone »), رابط_الفهرس()]));
    اطبع_سطر(ضم([رسالة(«  3. أضف هذا المدخل إلى الملف », «  3. Add this entry to the file »), انسخ_نص(الملف),
        رسالة(« (ملف جديد يبدأ بالسطر name = "», « (a new file starts with the line name = "»), انسخ_نص(الاسم), «"):»]));
    اطبع_سطر(«»);
    اطبع_سطر(انسخ_نص(المدخل));
    اطبع_سطر(رسالة(«  4. التزم بالتغيير وأرسل طلب دمج إلى الفهرس.», «  4. Commit it and open a pull request to the index.»));
}
