// فهرس الحزم: مستودع git فيه ملف لكل حزمة يسرد إصداراتها. لا يستضيف الفهرس
// الشيفرة: كل إصدار يشير إلى مستودع git والتزام وبصمة محتوى.
//
// الرابط الافتراضي https://github.com/sultan-language/index، ويغيّره
// المتغير SUPAX_INDEX.
//
// في جذر الفهرس config.toml (version = 1) وREADME، والحزم كلها تحت packages/.
// مسار ملف الحزمة، بمفتاح الاسم (تطبيع الهوية، وأحرف ASCII صغيرة):
//   حرف واحد      packages/1/<الاسم>.toml
//   حرفان         packages/2/<الاسم>.toml
//   ثلاثة أحرف    packages/3/<الحرف الأول>/<الاسم>.toml
//   أكثر          packages/<أول حرفين>/<الحرفان التاليان>/<الاسم>.toml
//   غير ASCII     packages/hash/<أول حرفين من البصمة>/<sha256 المفتاح>.toml   (أسماء ملفات ASCII فقط)
//
// ملف الحزمة (TOML):
//   name = "json"
//
//   [[versions]]
//   version = "1.2.0"
//   git = "https://github.com/someone/sn-json"
//   commit = "<40 محرفا ست عشريا>"
//   checksum = "sha256:<64 محرفا>"     (بصمة سوباكس للنسخة)
//   yanked = true                       (اختياري: لا يُختار لحل جديد)
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.تومل.محلل;
استورد المكتبة.إصدار.إصدار_دلالي;
استورد المكتبة.ملفات.مقبض;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.manifest.manifest;
استورد سوباكس.support.messages;
استورد سوباكس.support.names;
استورد سوباكس.manifest.toml;
استورد سوباكس.cache.checksum;
استورد سوباكس.cache.store;
استورد سوباكس.source.git;
استورد سوباكس.registry.requirement;

عام عرف الفهرس_الافتراضي(): نص { أرجع «https://github.com/sultan-language/index»; }

عام عرف رابط_الفهرس(): نص {
    دع الاسم: نص = «SUPAX_INDEX»;
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(ق)) -> { إذا (طول_النص(&ق) > 0) { أرجع ق; }; }
    | _ -> { };
    أرجع الفهرس_الافتراضي();
}

// فهرس مجلوب: رابطه، ومستودعه في المخبأ، والتزام رأسه المقروء.
عام نوع فهرس = { الرابط: نص, الهوية: نص, المستودع: نص, الالتزام: نص };

عام نوع إصدار_مفهرس = {
    الإصدار: نص,
    المحلل: إصدار_دلالي,
    الرابط: نص,
    الالتزام: نص,
    البصمة: نص,
    مسحوب: منطقي
};

عام نوع مدخل_فهرس = { الاسم: نص, الملف: نص, الإصدارات: متجه إصدار_مفهرس };

عرف ascii_بسيط(النص: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        دع ب: ط8 = (*النص)[ف];
        إذا (!((ب >= 97 && ب <= 122) || (ب >= 48 && ب <= 57) || ب == 95 || ب == 45)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// مفتاح الاسم في الفهرس: تطبيع الهوية ثم أحرف ASCII صغيرة.
عام عرف مفتاح_الفهرس(الاسم: &نص): نص {
    دع م: نص = مفتاح_الهوية(الاسم);
    أرجع حول_النص_إلى_صغير_أسكي(&م);
}

عام عرف مسار_في_الفهرس(الاسم: &نص): نص {
    أرجع ضم([«packages/», جزء_المسار(الاسم), «.toml»]);
}

عرف جزء_المسار(الاسم: &نص): نص {
    دع م: نص = مفتاح_الفهرس(الاسم);
    دع ل: طبيعي = طول_النص(&م);
    إذا (!ascii_بسيط(&م)) {
        دع ب: نص = بصمة_نص(&م);
        أرجع ضم([«hash/», شريحة_نص(&ب, 0, 2), «/», ب]);
    };
    إذا (ل == 1) { أرجع ضم([«1/», م]); };
    إذا (ل == 2) { أرجع ضم([«2/», م]); };
    إذا (ل == 3) { أرجع ضم([«3/», شريحة_نص(&م, 0, 1), «/», م]); };
    أرجع ضم([شريحة_نص(&م, 0, 2), «/», شريحة_نص(&م, 2, 4), «/», م]);
}

// يجلب الفهرس (إلا مع --offline) ويقرأ التزام رأسه.
عام عرف افتح_الفهرس(بلا_شبكة: منطقي): نتيجة فهرس, نص {
    دع الرابط: نص = رابط_الفهرس();
    دع الهوية: نص = هوية_رابط_جت(&الرابط)؟;
    دع المخبأ: نص = جذر_المخبأ()؟;
    دع المستودع: نص = مسار_المستودع(&المخبأ, &الهوية);
    دع المقبض: مقبض_ملف = احجز_المستودع(&المخبأ, &الهوية)؟;
    دع الناتج: نتيجة نص, نص = جلب_الفهرس_محجوزا(&المخبأ, &المستودع, &الرابط, بلا_شبكة);
    حرر_المستودع(المقبض);
    دع الالتزام: نص = الناتج؟;
    دع ف: فهرس = { الرابط: الرابط, الهوية: الهوية, المستودع: المستودع, الالتزام: الالتزام };
    تحقق_من_صيغة_الفهرس(&ف)؟;
    أرجع نتيجة.نجح(ف);
}

// config.toml في جذر الفهرس: version = 1. صيغة أحدث تعني أن سوباكس قديم.
عرف تحقق_من_صيغة_الفهرس(الفهرس_: &فهرس): نتيجة نص, نص {
    دع المسار: نص = «config.toml»;
    دع المقروء: اختياري نص = ملف_في_الفهرس(الفهرس_, &المسار)؟;
    دع النص: نص;
    طابق المقروء مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(«»); }
    | اختياري.موجود(ن) -> { النص := ن; };
    دع الوثيقة: وثيقة_تومل;
    طابق حلل_تومل(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«config.toml في فهرس الحزم ليس TOML صالحا», «config.toml in the package index is not valid TOML»)); }
    | نتيجة.نجح(و) -> { الوثيقة := و; };
    دع المفتاح: نص = «version»;
    طابق قيمة_مفتاح_تومل(&الوثيقة, الوثيقة.الجذر, &المفتاح) مع
    | اختياري.موجود(قيمة_تومل.عدد(ق)) -> {
        دع واحد: نص = «1»;
        إذا (نصان_متساويان(&ق, &واحد)) { أرجع نتيجة.نجح(«»); };
        أرجع نتيجة.خطأ(ضم([رسالة(«فهرس الحزم بالصيغة », «the package index uses format version »), انسخ_نص(&ق),
            رسالة(«، وهذا الإصدار من سوباكس يعرف الصيغة 1 فقط؛ حدّث سوباكس», «, and this Supax only knows version 1; update Supax»)]));
    }
    | _ -> { أرجع نتيجة.خطأ(رسالة(«config.toml في فهرس الحزم يحتاج version = 1», «config.toml in the package index needs version = 1»)); };
}

عرف جلب_الفهرس_محجوزا(المخبأ: &نص, المستودع: &نص, الرابط: &نص, بلا_شبكة: منطقي): نتيجة نص, نص {
    جهز_المستودع(المخبأ, المستودع)؟;
    إذا (!بلا_شبكة) {
        طابق اجلب_المستودع(المخبأ, المستودع, الرابط) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(السبب) -> {
            أرجع نتيجة.خطأ(ضم([رسالة(«تعذر تحديث فهرس الحزم: », «cannot update the package index: »), السبب]));
        };
    };
    طابق حل_محليا(المخبأ, المستودع, نوع_مرجع_جت.الفرع_الافتراضي(), &«») مع
    | اختياري.موجود(ق) -> { أرجع نتيجة.نجح(ق); }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(ضم([رسالة(«فهرس الحزم غير موجود في المخبأ، والجلب ممنوع (--offline): », «the package index is not in the cache, and fetching is disabled (--offline): »), انسخ_نص(الرابط)]));
    };
}

// نص ملف في التزام الفهرس، أو لا شيء إن لم يوجد.
عرف ملف_في_الفهرس(الفهرس_: &فهرس, المسار: &نص): نتيجة اختياري نص, نص {
    دع المخبأ: نص = جذر_المخبأ()؟;
    دع الوسائط: متجه نص = [
        ضم([«--git-dir=», انسخ_نص(&(*الفهرس_).المستودع)]), «cat-file», «blob»,
        ضم([انسخ_نص(&(*الفهرس_).الالتزام), «:», انسخ_نص(المسار)])
    ];
    دع بلا_فهرس: نص = «»;
    دع الناتج: ناتج_جت = شغل_جت(&المخبأ, &الوسائط, خطأ, &بلا_فهرس)؟;
    إذا (الناتج.الرمز != 0) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
    أرجع نتيجة.نجح(اختياري.موجود(انسخ_نص(&الناتج.الخرج)));
}

عرف ست_عشري(النص: &نص, الطول: طبيعي): منطقي {
    إذا (طول_النص(النص) != الطول) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول) {
        دع ب: ط8 = (*النص)[ف];
        إذا (!((ب >= 48 && ب <= 57) || (ب >= 97 && ب <= 102))) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// يقرأ ملف الحزمة من الفهرس. لا شيء إن لم تكن الحزمة فيه.
عام عرف اقرأ_مدخل_الفهرس(الفهرس_: &فهرس, الاسم: &نص): نتيجة اختياري مدخل_فهرس, نص {
    دع المسار: نص = مسار_في_الفهرس(الاسم);
    دع النص: نص;
    دع المقروء: اختياري نص = ملف_في_الفهرس(الفهرس_, &المسار)؟;
    طابق المقروء مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | اختياري.موجود(ن) -> { النص := ن; };
    دع الموضع: نص = ضم([رسالة(«فهرس الحزم », «package index »), انسخ_نص(&المسار)]);
    دع الوثيقة: وثيقة_تومل;
    طابق حلل_تومل(&النص) مع
    | نتيجة.خطأ(خ) -> {
        أرجع نتيجة.خطأ(ضم([الموضع, «:», رقم_نصا(سطر_الإزاحة(&النص, خ.الإزاحة)), «: », وصف_خطأ_تومل(خ.الصنف)]));
    }
    | نتيجة.نجح(و) -> { الوثيقة := و; };
    دع الجذر: طبيعي = الوثيقة.الجذر;
    دع اسم_المدخل: نص;
    طابق نص_في_جدول(&الوثيقة, الجذر, «name») مع
    | اختياري.موجود(ق) -> { اسم_المدخل := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([الموضع, رسالة(«: الحقل name مفقود», «: missing name»)])); };
    // ملف واحد قد يحمل مفتاحا لأكثر من اسم (حالة الأحرف): الاسم يجب أن يطابق.
    إذا (!نصان_متساويان(&مفتاح_الهوية(&اسم_المدخل), &مفتاح_الهوية(الاسم))) {
        أرجع نتيجة.نجح(اختياري.لا_شيء());
    };
    دع الإصدارات: متغير متجه إصدار_مفهرس = [];
    دع المفتاح: نص = «versions»;
    طابق قيمة_مفتاح_تومل(&الوثيقة, الجذر, &المفتاح) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        دع المصفوفة: طبيعي;
        طابق قيمة_مصفوفة(&القيمة) مع
        | اختياري.موجود(م) -> { المصفوفة := م; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([الموضع, رسالة(«: [[versions]] يجب أن يكون مصفوفة جداول», «: [[versions]] must be an array of tables»)])); };
        دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(&الوثيقة, المصفوفة);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            دع الجدول: طبيعي;
            طابق قيمة_جدول(&القيم[ف]) مع
            | اختياري.موجود(ج) -> { الجدول := ج; }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([الموضع, رسالة(«: مدخل [[versions]] ليس جدولا», «: a [[versions]] entry is not a table»)])); };
            دع إصدار_نص: نص = نص_أو_فارغ_فهرس(نص_في_جدول(&الوثيقة, الجدول, «version»));
            دع الرابط: نص = نص_أو_فارغ_فهرس(نص_في_جدول(&الوثيقة, الجدول, «git»));
            دع الالتزام: نص = نص_أو_فارغ_فهرس(نص_في_جدول(&الوثيقة, الجدول, «commit»));
            دع البصمة: نص = نص_أو_فارغ_فهرس(نص_في_جدول(&الوثيقة, الجدول, «checksum»));
            دع مسحوب: متغير منطقي = خطأ;
            دع مفتاح_السحب: نص = «yanked»;
            طابق قيمة_مفتاح_تومل(&الوثيقة, الجدول, &مفتاح_السحب) مع
            | اختياري.موجود(ق) -> {
                طابق ق مع | قيمة_تومل.منطق(ب) -> { مسحوب := ب; } | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            دع المحلل: إصدار_دلالي;
            طابق حلل_إصدارا(&إصدار_نص) مع
            | اختياري.موجود(إ) -> { المحلل := إ; }
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([الموضع, رسالة(«: إصدار غير صالح: "», «: invalid version: "»), إصدار_نص, «"»]));
            };
            إذا (طول_النص(&الرابط) == 0 || !ست_عشري(&الالتزام, 40) || !يبدأ_بـ(&البصمة, &«sha256:») || طول_النص(&البصمة) != 71) {
                أرجع نتيجة.خطأ(ضم([الموضع, رسالة(«: الإصدار », «: version »), إصدار_نص,
                    رسالة(« يحتاج git وcommit (40 محرفا ست عشريا) وchecksum (sha256:…)», « needs git, commit (40 hex characters) and checksum (sha256:…)»)]));
            };
            هوية_رابط_جت(&الرابط)؟;
            دع إ: إصدار_مفهرس = { الإصدار: إصدار_نص, المحلل: المحلل, الرابط: الرابط, الالتزام: الالتزام, البصمة: البصمة, مسحوب: مسحوب };
            ألحق(الإصدارات, إ);
            ف := ف + 1;
        }
    };
    دع م: مدخل_فهرس = { الاسم: اسم_المدخل, الملف: المسار, الإصدارات: الإصدارات };
    أرجع نتيجة.نجح(اختياري.موجود(م));
}

عرف نص_أو_فارغ_فهرس(ق: اختياري نص): نص {
    طابق ق مع
    | اختياري.موجود(ن) -> { أرجع ن; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// أعلى إصدار يحقق المتطلب، غير مسحوب. لا شيء إن لم يوجد.
عام عرف أعلى_إصدار_مطابق(المدخل: &مدخل_فهرس, المتطلب: &متطلب_إصدار): اختياري طبيعي {
    دع الأفضل: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المدخل).الإصدارات) مثل طبيعي)) {
        دع إ: &إصدار_مفهرس = &(*المدخل).الإصدارات[ف];
        إذا (!(*إ).مسحوب && يطابق_المتطلب(المتطلب, &(*إ).المحلل)) {
            طابق الأفضل مع
            | اختياري.لا_شيء -> { الأفضل := اختياري.موجود(ف); }
            | اختياري.موجود(ب) -> {
                إذا (قارن_إصدارين_دلاليين(&(*إ).المحلل, &(*المدخل).الإصدارات[ب].المحلل) > 0) { الأفضل := اختياري.موجود(ف); };
            };
        };
        ف := ف + 1;
    }
    أرجع الأفضل;
}

// موضع إصدار بعينه في المدخل.
عام عرف موضع_الإصدار(المدخل: &مدخل_فهرس, الإصدار: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المدخل).الإصدارات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المدخل).الإصدارات[ف].الإصدار, الإصدار)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// الإصدارات غير المسحوبة، مفصولة بفواصل، للرسائل.
عام عرف الإصدارات_المتاحة(المدخل: &مدخل_فهرس): نص {
    دع الأجزاء: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المدخل).الإصدارات) مثل طبيعي)) {
        إذا (!(*المدخل).الإصدارات[ف].مسحوب) { ألحق(الأجزاء, انسخ_نص(&(*المدخل).الإصدارات[ف].الإصدار)); };
        ف := ف + 1;
    }
    إذا ((الطول(الأجزاء) مثل طبيعي) == 0) { أرجع رسالة(«لا شيء», «none»); };
    دع الفاصل: نص = «, »;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}
