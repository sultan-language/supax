// supax package: يجهز إصدار الحزمة لفهرس الحزم ويطبع مدخله، مثل cargo package.
//
// يتحقق من أن:
//   - للحزمة [lib] وإصدار دلالي صالح؛
//   - لا اعتمادية مسارية فيها (لا يصل إليها من يجلب الحزمة)؛
//   - شجرة git نظيفة، فالالتزام HEAD هو ما سيُنشر.
// ثم يجلب HEAD إلى المخبأ ويحسب بصمة المحتوى، ويطبع مسار الملف في الفهرس
// ومدخل [[versions]] الذي يُضاف إليه.
استورد المكتبة.ملفات.مقبض;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.manifest.manifest;
استورد سوباكس.cache.store;
استورد سوباكس.source.git;
استورد سوباكس.registry.requirement;
استورد سوباكس.registry.index;

عام نوع مدخل_منشور = { الملف: نص، النص: نص };

// يشغل git في دليل المشروع (بإعدادات المستخدم: هذا مستودعه هو).
عرف جت_في(المخبأ: &نص، الجذر: &نص، الوسائط: متجه نص، الوصف: نص): نتيجة نص، نص {
    ليكن الكل: متغير متجه نص = [«-C»، انسخ_نص(الجذر)];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوسائط) مثل طبيعي)) { ألحق(الكل، انسخ_نص(&الوسائط[ف])); ف := ف + 1; }
    أرجع جت_ناجح(المخبأ، الكل، خطأ، الوصف);
}

عام عرف جهز_للفهرس(الجذر: &نص، البيان: &بيان، رابط_معطى: &نص): نتيجة مدخل_منشور، نص {
    // البيان.
    إذا (!(*البيان).له_مكتبة) {
        أرجع نتيجة.خطأ(رسالة(«حزم الفهرس مكتبات: أعلن [lib] في Supax.toml»، «index packages are libraries: declare [lib] in Supax.toml»));
    };
    ليكن الإصدار: نص;
    طابق انسخ_اختيار_نص(&(*البيان).الإصدار) مع
    | اختياري.موجود(ق) -> { الإصدار := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(رسالة(«أضف version إلى [package] في Supax.toml»، «add a version to [package] in Supax.toml»)); };
    طابق حلل_إصدارا(&الإصدار) مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(ضم([رسالة(«الإصدار "»، «version "»)، انسخ_نص(&الإصدار)، رسالة(«" ليس إصدارا دلاليا مثل 1.2.0»، «" is not a semantic version such as 1.2.0»)]));
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيان).الاعتماديات) مثل طبيعي)) {
        طابق انسخ_اختيار_نص(&(*البيان).الاعتماديات[ف].المسار) مع
        | اختياري.موجود(_) -> {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*البيان).الاعتماديات[ف].الموضع)، رسالة(«الاعتمادية المسارية "»، «path dependency "»)،
                انسخ_نص(&(*البيان).الاعتماديات[ف].الاسم)، رسالة(«" لا تصل إلى من يجلب الحزمة؛ استخدم version أو git»، «" does not reach people who fetch the package; use version or git»)]));
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // git.
    ليكن المخبأ: نص = جذر_المخبأ()؟;
    ليكن الحالة: نص = جت_في(&المخبأ، الجذر، [«status»، «--porcelain»]، رسالة(«المشروع ليس مستودع git»، «the project is not a git repository»))؟;
    إذا (طول_النص(&الحالة) > 0) {
        أرجع نتيجة.خطأ(ضم([رسالة(«في المستودع تغييرات غير ملتزمة؛ التزم بها أولا حتى يكون HEAD ما يُنشر:»، «the repository has uncommitted changes; commit them first so HEAD is what gets published:»)، سطر_جديد()، الحالة]));
    };
    ليكن الالتزام: نص = جت_في(&المخبأ، الجذر، [«rev-parse»، «HEAD»]، رسالة(«لا التزام في المستودع»، «the repository has no commit»))؟;
    ليكن الرابط: متغير نص = انسخ_نص(رابط_معطى);
    إذا (طول_النص(&الرابط) == 0) {
        طابق جت_في(&المخبأ، الجذر، [«remote»، «get-url»، «origin»]، «») مع
        | نتيجة.نجح(ق) -> { الرابط := ق; }
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(رسالة(«لا يوجد remote باسم origin؛ مرر رابط المستودع العام بـ --git <رابط>»، «no remote named origin; pass the public repository URL with --git <url>»));
        };
    };
    ليكن الهوية: نص = هوية_رابط_جت(&الرابط)؟;
    // البصمة: من نسخة HEAD في المخبأ، كما يراها من يجلب الحزمة.
    ليكن المستودع: نص = مسار_المستودع(&المخبأ، &الهوية);
    ليكن المقبض: مقبض_ملف = احجز_المستودع(&المخبأ، &الهوية)؟;
    ليكن الناتج: نتيجة نسخة_مسحوبة، نص = سحب_محجوز(&المخبأ، &المستودع، &الهوية، الجذر، &الالتزام);
    حرر_المستودع(المقبض);
    ليكن النسخة: نسخة_مسحوبة = الناتج؟;
    ليكن النص: نص = ضم([
        «[[versions]]»، سطر_جديد()،
        «version = »، نص_تومل(&الإصدار)، سطر_جديد()،
        «git = »، نص_تومل(&الرابط)، سطر_جديد()،
        «commit = »، نص_تومل(&الالتزام)، سطر_جديد()،
        «checksum = »، نص_تومل(&النسخة.البصمة)، سطر_جديد()
    ]);
    ليكن م: مدخل_منشور = { الملف: مسار_في_الفهرس(&(*البيان).الاسم)، النص: النص };
    أرجع نتيجة.نجح(م);
}

عرف سحب_محجوز(المخبأ: &نص، المستودع: &نص، الهوية: &نص، الجذر: &نص، الالتزام: &نص): نتيجة نسخة_مسحوبة، نص {
    جهز_المستودع(المخبأ، المستودع)؟;
    إذا (!التزام_موجود(المخبأ، المستودع، الالتزام)) {
        اجلب_المستودع(المخبأ، المستودع، الجذر)؟;
    };
    أرجع اسحب_إلى_المخبأ(المخبأ، الهوية، الالتزام);
}
