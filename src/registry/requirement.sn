// متطلبات الإصدار في Supax.toml، بقواعد Cargo:
//
//   "1.2.3"  ^1.2.3   >=1.2.3, <2.0.0       (بلا عامل: ^)
//   "^0.2.3"          >=0.2.3, <0.3.0
//   "^0.0.3"          >=0.0.3, <0.0.4
//   "~1.2.3"          >=1.2.3, <1.3.0
//   "=1.2.3"          1.2.3 وحده
//   ">=1.2, <1.5"     كل المقارنات معا
//   "*"، "1.*"، "1.2.*"
//
// إصدار قبل الإصدار النهائي (1.3.0-beta.1) لا يطابق إلا إذا ذكر أحد المقارنات
// إصدارا قبل نهائي بالأرقام الثلاثة نفسها.
استورد المكتبة.إصدار.semver;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.number;
استورد المكتبة.نصوص.transform;
استورد المكتبة.نصوص.search;
استورد المكتبة.نصوص.from_bytes;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;

// حد: الإصدار، وهل يدخل في المدى.
عام نوع حد_إصدار = { الإصدار: إصدار_دلالي, شامل: منطقي };

// مقارن واحد مدى [الأدنى، الأعلى]. الأساس: الإصدار المكتوب، لقاعدة ما قبل النهائي.
عام نوع مقارن_إصدار = {
    الأدنى: حد_إصدار,
    له_أعلى: منطقي,
    الأعلى: حد_إصدار,
    الأساس: إصدار_دلالي
};

عام نوع متطلب_إصدار = { النص: نص, المقارنات: متجه مقارن_إصدار };

عام عرف إصدار_من(ر: طبيعي, ث: طبيعي, ت: طبيعي): إصدار_دلالي {
    دع ق: إصدار_دلالي = { الرئيسي: ر, الثانوي: ث, التصحيح: ت, قبل_الإصدار: «», البناء: «» };
    أرجع ق;
}

عرف حد(الإصدار: إصدار_دلالي, شامل: منطقي): حد_إصدار {
    دع ح: حد_إصدار = { الإصدار: الإصدار, شامل: شامل };
    أرجع ح;
}

عرف مقارن(الأدنى: حد_إصدار, له_أعلى: منطقي, الأعلى: حد_إصدار, الأساس: إصدار_دلالي): مقارن_إصدار {
    دع م: مقارن_إصدار = { الأدنى: الأدنى, له_أعلى: له_أعلى, الأعلى: الأعلى, الأساس: الأساس };
    أرجع م;
}

عرف رقم_صالح(النص: &نص): منطقي {
    إذا (طول_النص(النص) == 0 || طول_النص(النص) > 18) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        إذا ((*النص)[ف] < 48 || (*النص)[ف] > 57) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف رقم_من(النص: &نص): طبيعي {
    دع ق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        ق := ق * 10 + (((*النص)[ف] - 48) مثل طبيعي);
        ف := ف + 1;
    }
    أرجع ق;
}

عرف بدل(النص: &نص): منطقي {
    أرجع يساوي_نص(النص, «*») || يساوي_نص(النص, «x») || يساوي_نص(النص, «X»);
}

عرف يساوي_نص(أ: &نص, ب: نص): منطقي {
    دع ث: نص = ب;
    أرجع نصان_متساويان(أ, &ث);
}

عرف خطأ_متطلب(النص: &نص): نص {
    أرجع ضم([رسالة(«متطلب إصدار غير صالح: "», «invalid version requirement: "»), انسخ_نص(النص),
        رسالة(«". أمثلة صالحة: "1.2"، "^1.2.3"، "~1.2"، ">=1.0, <2.0"، "=1.2.3"، "*"», «". Valid examples: "1.2", "^1.2.3", "~1.2", ">=1.0, <2.0", "=1.2.3", "*"»)]);
}

// مقارن واحد مثل «>=1.2» أو «1.*».
عرف حلل_مقارنا(الأصل: &نص, الكل: &نص): نتيجة مقارن_إصدار, نص {
    دع النص: نص = قص_النص(الأصل);
    إذا (طول_النص(&النص) == 0) { أرجع نتيجة.خطأ(خطأ_متطلب(الكل)); };
    إذا (يساوي_نص(&النص, «*»)) { أرجع نتيجة.نجح(مقارن(حد(إصدار_من(0, 0, 0), صواب), خطأ, حد(إصدار_من(0, 0, 0), صواب), إصدار_من(0, 0, 0))); };
    // العامل.
    دع العامل: متغير نص = «^»;
    دع البداية: متغير طبيعي = 0;
    دع العوامل: متجه نص = [«>=», «<=», «>», «<», «=», «^», «~»];
    دع ع: متغير طبيعي = 0;
    دع وُجد: متغير منطقي = خطأ;
    طالما (ع < (الطول(العوامل) مثل طبيعي) && !وُجد) {
        إذا (يبدأ_بـ(&النص, &العوامل[ع])) {
            العامل := انسخ_نص(&العوامل[ع]);
            البداية := طول_النص(&العوامل[ع]);
            وُجد := صواب;
        };
        ع := ع + 1;
    }
    دع البقية_كاملة: نص = شريحة_نص(&النص, البداية, طول_النص(&النص));
    دع البقية: متغير نص = قص_النص(&البقية_كاملة);
    // البناء بعد «+» لا يدخل في المقارنة.
    دع زائد: طبيعي = موضع_بايت(&البقية, 43, 0);
    البقية := شريحة_نص(&البقية, 0, زائد);
    // ما قبل الإصدار بعد أول «-».
    دع شرطة: طبيعي = موضع_بايت(&البقية, 45, 0);
    دع قبل: متغير نص = «»;
    إذا (شرطة < طول_النص(&البقية)) { قبل := شريحة_نص(&البقية, شرطة + 1, طول_النص(&البقية)); };
    دع الأرقام: نص = شريحة_نص(&البقية, 0, شرطة);
    دع النقطة: نص = «.»;
    دع الأجزاء: متجه نص = قسم_النص(&الأرقام, &النقطة);
    إذا ((الطول(الأجزاء) مثل طبيعي) == 0 || (الطول(الأجزاء) مثل طبيعي) > 3) { أرجع نتيجة.خطأ(خطأ_متطلب(الكل)); };
    // عدد المكونات الرقمية قبل أي «*».
    دع ن: متغير طبيعي = 0;
    دع بعد_بدل: متغير منطقي = خطأ;
    دع القيم: متغير متجه طبيعي = [0, 0, 0];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        إذا (بدل(&الأجزاء[ف])) {
            بعد_بدل := صواب;
        } وإلا {
            إذا (بعد_بدل || !رقم_صالح(&الأجزاء[ف])) { أرجع نتيجة.خطأ(خطأ_متطلب(الكل)); };
            القيم[ف] := رقم_من(&الأجزاء[ف]);
            ن := ن + 1;
        };
        ف := ف + 1;
    }
    إذا (طول_النص(&قبل) > 0 && ن != 3) { أرجع نتيجة.خطأ(خطأ_متطلب(الكل)); };
    إذا (ن == 0) {
        // «*.*» وما شابه.
        إذا (يساوي_نص(&العامل, «^») || يساوي_نص(&العامل, «=»)) { أرجع نتيجة.نجح(مقارن(حد(إصدار_من(0, 0, 0), صواب), خطأ, حد(إصدار_من(0, 0, 0), صواب), إصدار_من(0, 0, 0))); };
        أرجع نتيجة.خطأ(خطأ_متطلب(الكل));
    };
    دع ر: طبيعي = القيم[0];
    دع ث: طبيعي = القيم[1];
    دع ت: طبيعي = القيم[2];
    دع الأساس: متغير إصدار_دلالي = إصدار_من(ر, ث, ت);
    الأساس.قبل_الإصدار := انسخ_نص(&قبل);
    // مع «*» بلا عامل صريح: مثل «=».
    إذا (بعد_بدل && !وُجد) { العامل := «=»; };
    دع الأدنى_الكامل: إصدار_دلالي = استنسخ(&الأساس);
    // الحد الأعلى لكل عدد من المكونات.
    دع أعلى_رئيسي: إصدار_دلالي = إصدار_من(ر + 1, 0, 0);
    دع أعلى_ثانوي: إصدار_دلالي = إصدار_من(ر, ث + 1, 0);
    دع أعلى_تصحيح: إصدار_دلالي = إصدار_من(ر, ث, ت + 1);
    // الحد الأعلى لمكون أو مكونين: الرئيسي التالي، أو الثانوي التالي.
    دع أعلى_جزئي: متغير إصدار_دلالي = إصدار_من(ر, ث + 1, 0);
    إذا (ن == 1) { أعلى_جزئي := إصدار_من(ر + 1, 0, 0); };
    إذا (يساوي_نص(&العامل, «^»)) {
        دع الأعلى: متغير إصدار_دلالي = استنسخ(&أعلى_رئيسي);
        إذا (ر == 0 && ن >= 2) {
            إذا (ث > 0 || ن == 2) { الأعلى := استنسخ(&أعلى_ثانوي); } وإلا { الأعلى := استنسخ(&أعلى_تصحيح); };
        };
        أرجع نتيجة.نجح(مقارن(حد(الأدنى_الكامل, صواب), صواب, حد(الأعلى, خطأ), الأساس));
    };
    إذا (يساوي_نص(&العامل, «~»)) {
        أرجع نتيجة.نجح(مقارن(حد(الأدنى_الكامل, صواب), صواب, حد(أعلى_جزئي, خطأ), الأساس));
    };
    إذا (يساوي_نص(&العامل, «=»)) {
        إذا (ن == 3) { أرجع نتيجة.نجح(مقارن(حد(استنسخ(&الأدنى_الكامل), صواب), صواب, حد(الأدنى_الكامل, صواب), الأساس)); };
        أرجع نتيجة.نجح(مقارن(حد(الأدنى_الكامل, صواب), صواب, حد(أعلى_جزئي, خطأ), الأساس));
    };
    إذا (يساوي_نص(&العامل, «>»)) {
        إذا (ن == 3) { أرجع نتيجة.نجح(مقارن(حد(الأدنى_الكامل, خطأ), خطأ, حد(إصدار_من(0, 0, 0), صواب), الأساس)); };
        أرجع نتيجة.نجح(مقارن(حد(أعلى_جزئي, صواب), خطأ, حد(إصدار_من(0, 0, 0), صواب), الأساس));
    };
    إذا (يساوي_نص(&العامل, «>=»)) {
        أرجع نتيجة.نجح(مقارن(حد(الأدنى_الكامل, صواب), خطأ, حد(إصدار_من(0, 0, 0), صواب), الأساس));
    };
    إذا (يساوي_نص(&العامل, «<»)) {
        أرجع نتيجة.نجح(مقارن(حد(إصدار_من(0, 0, 0), صواب), صواب, حد(الأدنى_الكامل, خطأ), الأساس));
    };
    // «<=»
    إذا (ن == 3) { أرجع نتيجة.نجح(مقارن(حد(إصدار_من(0, 0, 0), صواب), صواب, حد(الأدنى_الكامل, صواب), الأساس)); };
    أرجع نتيجة.نجح(مقارن(حد(إصدار_من(0, 0, 0), صواب), صواب, حد(أعلى_جزئي, خطأ), الأساس));
}

عام عرف حلل_متطلبا(النص: &نص): نتيجة متطلب_إصدار, نص {
    دع الفاصل: نص = «,»;
    دع الأجزاء: متجه نص = قسم_النص(النص, &الفاصل);
    دع المقارنات: متغير متجه مقارن_إصدار = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        دع م: مقارن_إصدار = حلل_مقارنا(&الأجزاء[ف], النص)؟;
        ألحق(المقارنات, م);
        ف := ف + 1;
    }
    دع م: متطلب_إصدار = { النص: قص_النص(النص), المقارنات: المقارنات };
    أرجع نتيجة.نجح(م);
}

عرف داخل_المقارن(م: &مقارن_إصدار, الإصدار: &إصدار_دلالي): منطقي {
    دع أ: عدد = قارن_إصدارين_دلاليين(الإصدار, &(*م).الأدنى.الإصدار);
    إذا (أ < 0 || (أ == 0 && !(*م).الأدنى.شامل)) { أرجع خطأ; };
    إذا ((*م).له_أعلى) {
        دع ب: عدد = قارن_إصدارين_دلاليين(الإصدار, &(*م).الأعلى.الإصدار);
        إذا (ب > 0 || (ب == 0 && !(*م).الأعلى.شامل)) { أرجع خطأ; };
    };
    أرجع صواب;
}

// هل يحقق الإصدار كل المقارنات؟
عام عرف يطابق_المتطلب(المتطلب: &متطلب_إصدار, الإصدار: &إصدار_دلالي): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المتطلب).المقارنات) مثل طبيعي)) {
        إذا (!داخل_المقارن(&(*المتطلب).المقارنات[ف], الإصدار)) { أرجع خطأ; };
        ف := ف + 1;
    }
    إذا (طول_النص(&(*الإصدار).قبل_الإصدار) == 0) { أرجع صواب; };
    // قبل النهائي: يلزم مقارن يذكر قبل نهائي بالأرقام نفسها.
    ف := 0;
    طالما (ف < (الطول((*المتطلب).المقارنات) مثل طبيعي)) {
        دع أ: &إصدار_دلالي = &(*المتطلب).المقارنات[ف].الأساس;
        إذا (طول_النص(&(*أ).قبل_الإصدار) > 0 && (*أ).الرئيسي == (*الإصدار).الرئيسي
            && (*أ).الثانوي == (*الإصدار).الثانوي && (*أ).التصحيح == (*الإصدار).التصحيح) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// يحلل إصدارا كاملا مثل «1.2.3» أو «1.2.3-beta.1».
عام عرف حلل_إصدارا(النص: &نص): اختياري إصدار_دلالي {
    طابق حلل_إصدارا_دلاليا(النص) مع
    | نتيجة.نجح(ق) -> { أرجع اختياري.موجود(ق); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// فئة التوافق كما في Cargo: إصداران من الفئة نفسها يحل أحدهما محل الآخر.
//   1.4.2 -> "1"   0.3.1 -> "0.3"   0.0.4 -> "0.0.4"
عام عرف فئة_توافق_نص(النص: &نص): نص {
    طابق حلل_إصدارا(النص) مع
    | اختياري.لا_شيء -> { أرجع انسخ_نص(النص); }
    | اختياري.موجود(إ) -> {
        إذا (إ.الرئيسي > 0) { أرجع رقم_نصا(إ.الرئيسي); };
        إذا (إ.الثانوي > 0) { أرجع ضم([«0.», رقم_نصا(إ.الثانوي)]); };
        أرجع ضم([«0.0.», رقم_نصا(إ.التصحيح)]);
    };
}
