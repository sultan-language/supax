// يبحث صعودا من دليل العمل عن Supax.toml بحالة الأحرف نفسها، ويتوقف عند
// supax.toml (مشروع بناء من نوع آخر).
عام عرف ابحث_عن_المشروع(): نتيجة نص, نص {
    دع الحالي: متغير نص;
    طابق دليل_العمل() مع
    | نتيجة.نجح(د) -> { الحالي := د; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذرت معرفة دليل العمل», «cannot determine the working directory»)); };
    دع البيان: نص = اسم_البيان();
    دع البناء: نص = اسم_بيان_البناء();
    طالما (صواب) {
        إذا (ملف_باسم_دقيق(&الحالي, &البيان)) { أرجع نتيجة.نجح(الحالي); };
        إذا (ملف_باسم_دقيق(&الحالي, &البناء)) {
            أرجع نتيجة.خطأ(ضم([رسالة(«الدليل », «directory »), الحالي, رسالة(« فيه supax.toml (بيان بناء)، وليس Supax.toml لحزمة سلطان», « has supax.toml (a build manifest), not the Supax.toml of a SultanC package»)]));
        };
        طابق أب_المسار(&الحالي) مع
        | اختياري.موجود(الأب) -> {
            إذا (طول_النص(&الأب) == 0 || نصان_متساويان(&الأب, &الحالي)) {
                أرجع نتيجة.خطأ(رسالة(«لا يوجد Supax.toml في هذا الدليل ولا في أي دليل أعلى منه», «no Supax.toml in this directory or any parent directory»));
            };
            الحالي := الأب;
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(رسالة(«لا يوجد Supax.toml في هذا الدليل ولا في أي دليل أعلى منه», «no Supax.toml in this directory or any parent directory»)); };
    }
    أرجع نتيجة.خطأ(«»);
}

// يكتب الملف إن تغير محتواه، عبر ملف مؤقت ثم إعادة تسمية.
عام عرف اكتب_إن_تغير(المسار: &نص, المحتوى: &نص): نتيجة منطقي, نص {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(الحالي) -> {
        إذا (نصان_متساويان(&الحالي, المحتوى)) { أرجع نتيجة.نجح(خطأ); };
    }
    | نتيجة.خطأ(_) -> { };
    دع المؤقت: نص = ضم([انسخ_نص(المسار), «.tmp»]);
    طابق اكتب_الملف(&المؤقت, المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة », «cannot write »), المؤقت])); }
    | نتيجة.نجح(_) -> { };
    طابق أعد_تسمية(&المؤقت, المسار) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صواب); }
    | نتيجة.خطأ(_) -> { };
    // ويندوز لا يستبدل ملفا موجودا بإعادة التسمية.
    طابق أزل_ملفا(المسار) مع | _ -> { };
    طابق أعد_تسمية(&المؤقت, المسار) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صواب); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة », «cannot write »), انسخ_نص(المسار)])); };
}

// مخطط مساحة العمل كاملا: كل الأعضاء جذور فيه (الأرقام 0..ع-1).
عام نوع مخطط_عمل = { الكامل: مخطط, الأعضاء: متجه نص, الجذر: نص, مساحة: منطقي };

// يحل مخطط المشروع أو مساحة العمل التي يقع فيها الدليل، ويحدّث Supax.lock في
// جذرها (أو يتحقق منه مع --locked).
عام عرف حل_وقفل_العمل(الدليل: &نص, الخيارات: &خيارات_الحل, اكتب_القفل: منطقي): نتيجة مخطط_عمل, نص {
    دع جذر_القفل: متغير نص = انسخ_نص(الدليل);
    دع الأعضاء: متغير متجه نص = [انسخ_نص(الدليل)];
    دع مساحة: متغير منطقي = خطأ;
    دع المساحة: اختياري مساحة_عمل = ابحث_عن_مساحة_العمل(الدليل)؟;
    طابق المساحة مع
    | اختياري.موجود(م) -> { جذر_القفل := انسخ_نص(&م.الجذر); الأعضاء := استنسخ(&م.الأعضاء); مساحة := صواب; }
    | اختياري.لا_شيء -> { };
    دع القفل: قفل = اقرأ_القفل(&جذر_القفل)؟;
    إذا ((*الخيارات).مقفول && !القفل.موجود) {
        أرجع نتيجة.خطأ(رسالة(«خيار --locked يتطلب Supax.lock موجودا؛ شغّل supax fetch أولا», «--locked needs an existing Supax.lock; run supax fetch first»));
    };
    دع المخطط: مخطط = حل_مخطط_الجذور(&جذر_القفل, &الأعضاء, &القفل, الخيارات)؟;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأعضاء) مثل طبيعي)) { حذر_من_المرادفات(&المخطط.الحزم[ف]); ف := ف + 1; }
    دع النص: نص = اكتب_نص_القفل(&المخطط);
    دع اسم: نص = اسم_القفل();
    دع المسار: نص = صل_المسار(&جذر_القفل, &اسم);
    إذا ((*الخيارات).مقفول) {
        طابق اقرأ_الملف(&المسار) مع
        | نتيجة.نجح(الحالي) -> {
            إذا (!نصان_متساويان(&الحالي, &النص)) {
                أرجع نتيجة.خطأ(رسالة(«Supax.lock لا يطابق Supax.toml ويحتاج تحديثا، وخيار --locked يمنع ذلك. شغّل supax fetch», «Supax.lock does not match Supax.toml and needs updating, but --locked forbids that. Run supax fetch»));
            };
        }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذرت قراءة Supax.lock», «cannot read Supax.lock»)); };
    } وإلا إذا (اكتب_القفل) {
        اكتب_إن_تغير(&المسار, &النص)؟;
    };
    دع الناتج: مخطط_عمل = { الكامل: المخطط, الأعضاء: الأعضاء, الجذر: جذر_القفل, مساحة: مساحة };
    أرجع نتيجة.نجح(الناتج);
}

// المخطط كما تراه حزمة الدليل. في مساحة عمل: يُحل كل الأعضاء معا ويُكتب
// القفل في الجذر، ثم يُستخرج مخطط هذا العضو.
عام عرف حل_وقفل(الجذر: &نص, الخيارات: &خيارات_الحل, اكتب_القفل: منطقي): نتيجة مخطط, نص {
    دع العمل: مخطط_عمل = حل_وقفل_العمل(الجذر, الخيارات, اكتب_القفل)؟;
    إذا (!العمل.مساحة) { أرجع نتيجة.نجح(استنسخ(&العمل.الكامل)); };
    دع الدليل: نص = قانوني(الجذر)؟;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العمل.الأعضاء) مثل طبيعي)) {
        إذا (نصان_متساويان(&العمل.الكامل.الحزم[ف].الدليل, &الدليل)) { أرجع نتيجة.نجح(مخطط_فرعي(&العمل.الكامل, ف)); };
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(ضم([الدليل, رسالة(«: جذر مساحة عمل بلا [package]؛ اختر عضوا بـ -p <الاسم> أو شغّل الأمر داخل عضو», «: a workspace root without [package]; pick a member with -p <name> or run the command inside a member»)]));
}

عام عرف عدد_الحزم_الخارجية(المخطط: &مخطط): طبيعي {
    أرجع (الطول((*المخطط).الحزم) مثل طبيعي) - 1;
}

// [imports-alias] لم يعد المترجم يقرؤه (منذ e1d4bca): تحذير بالسطر المطلوب لكل مدخل وملفه.
عرف حذر_من_المرادفات(الحزمة: &حزمة): فراغ {
    دع الأسطر: متجه نص = أسطر_تحذير_المرادفات(&(*الحزمة).الاسم, &(*الحزمة).الدليل, &(*الحزمة).جذر_المصدر, &(*الحزمة).المرادفات);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الأسطر) مثل طبيعي)) {
        اطبع_سطر_خطأ(انسخ_نص(&الأسطر[ك]));
        ك := ك + 1;
    }
}
