عام عرف نفّذ(الطلب: &طلب): نتيجة عدد، نص {
    طابق (*الطلب).الأمر مع
    | أمر_سوباكس.مساعدة -> { اطبع_سطر(المساعدة()); أرجع نتيجة.نجح(0); }
    | أمر_سوباكس.إصدار -> { اطبع_سطر(ضم([«supax »، الإصدار()])); أرجع نتيجة.نجح(0); }
    | أمر_سوباكس.مخبأ -> { أرجع نفّذ_المخبأ(الطلب); }
    | أمر_سوباكس.سحب_إصدار -> { أرجع نفّذ_السحب(الطلب); }
    | أمر_سوباكس.تثبيت -> { أرجع ثبّت(الطلب); }
    | أمر_سوباكس.إلغاء_تثبيت -> { أرجع ألغ_التثبيت(الطلب); }
    | أمر_سوباكس.جديد -> {
        ليكن الاسم: نص = الاسم_الأول(الطلب);
        ليكن الناتج: نص = حزمة_جديدة(&الاسم، علم_معطى(الطلب، «lib»))؟;
        اطبع_سطر(الناتج);
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.تهيئة -> {
        ليكن الاسم: نص = الاسم_الأول(الطلب);
        ليكن الناتج: نص = هيئ_الدليل_الحالي(&الاسم، علم_معطى(الطلب، «lib»))؟;
        اطبع_سطر(الناتج);
        أرجع نتيجة.نجح(0);
    }
    | _ -> { };
    ليكن الأقرب: نص = ابحث_عن_المشروع()؟;
    // أوامر المخطط كله: تعمل في أي مكان من مساحة العمل.
    طابق (*الطلب).الأمر مع
    | أمر_سوباكس.جلب -> { أرجع نفّذ_في(الطلب، &الأقرب); }
    | أمر_سوباكس.تحديث -> { أرجع نفّذ_في(الطلب، &الأقرب); }
    | أمر_سوباكس.تحقق -> { أرجع نفّذ_في(الطلب، &الأقرب); }
    | أمر_سوباكس.شجرة -> { أرجع نفّذ_في(الطلب، &الأقرب); }
    | أمر_سوباكس.تنظيف -> { أرجع نفّذ_في(الطلب، &الأقرب); }
    | _ -> { };
    ليكن الأدلة: متجه نص = أدلة_الأعضاء(الطلب، &الأقرب)؟;
    // check و build و test: كل عضو مختار بالترتيب، ويتوقف عند أول فشل.
    ليكن متعدد: منطقي = طابق_متعدد(&(*الطلب).الأمر);
    إذا (!متعدد && (الطول(الأدلة) مثل طبيعي) != 1) {
        أرجع نتيجة.خطأ(ضم([رسالة(«هذا جذر مساحة عمل بلا [package]؛ اختر عضوا بـ -p <الاسم>: »، «this is a workspace root without [package]; pick a member with -p <name>: »)،
            أسماء_الأعضاء(&الأدلة)]));
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأدلة) مثل طبيعي)) {
        ليكن الرمز: متغير عدد = 0;
        ليكن ملف_المكتبة: نص = مكتبة_بلا_برامج(الطلب، &الأدلة[ف]);
        إذا (طول_النص(&ملف_المكتبة) > 0) {
            // عضو مكتبة فقط في build أو check: يُفحص ملف جذرها، كما يترجم cargo build المكتبات.
            ليكن طلب_الفحص: متغير طلب = استنسخ(الطلب);
            طلب_الفحص.الأمر := أمر_سوباكس.فحص();
            طلب_الفحص.المدخل := ملف_المكتبة;
            الرمز := نفّذ_في(&طلب_الفحص، &الأدلة[ف])؟;
        } وإلا إذا ((الطول(الأدلة) مثل طبيعي) == 1 || !تخطى_العضو(الطلب، &الأدلة[ف])) {
            الرمز := نفّذ_في(الطلب، &الأدلة[ف])؟;
        };
        إذا (الرمز != 0) { أرجع نتيجة.نجح(الرمز); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}

// هل في الدليل برنامج: src/main.sn أو main.sn أو src/bin/*.sn؟
عرف له_برامج(الدليل: &نص): منطقي {
    إذا (ملف_موجود(&صل_المسار(الدليل، &«src/main.sn»)) || ملف_موجود(&صل_المسار(الدليل، &«main.sn»))) { أرجع صواب; };
    طابق اقرأ_مدخلات_الدليل(&صل_المسار(الدليل، &«src/bin»)) مع
    | نتيجة.نجح(المداخل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            إذا (ينتهي_بـ(&المداخل[ف].الاسم، &«.sn»)) { أرجع صواب; };
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    أرجع خطأ;
}

// لـ build و check بلا ملف مسمى: ملف جذر المكتبة لعضو بلا برامج، وإلا «».
عرف مكتبة_بلا_برامج(الطلب: &طلب، الدليل: &نص): نص {
    إذا (طول_النص(&(*الطلب).المدخل) > 0 || له_برامج(الدليل)) { أرجع «»; };
    طابق (*الطلب).الأمر مع
    | أمر_سوباكس.بناء -> { }
    | أمر_سوباكس.فحص -> { }
    | _ -> { أرجع «»; };
    طابق اقرأ_البيان(الدليل، تحقق_رابط) مع
    | نتيجة.خطأ(_) -> { أرجع «»; }
    | نتيجة.نجح(ب) -> {
        إذا (!ب.له_مكتبة) { أرجع «»; };
        ليكن الملف: متغير نص = «»;
        طابق انسخ_اختيار_نص(&ب.المدخل) مع
        | اختياري.موجود(م) -> { الملف := صل_المسار(&ب.جذر_المصدر، &ضم([م، «.sn»])); }
        | اختياري.لا_شيء -> { الملف := صل_المسار(&ب.جذر_المصدر، &ضم([انسخ_نص(&ب.الاسم)، «.sn»])); };
        إذا (ملف_موجود(&الملف)) { أرجع الملف; };
        أرجع «»;
    };
}

// عضو بلا برامج ولا ملف جذر مكتبة في build أو check: لا شيء يُترجم.
عرف تخطى_العضو(الطلب: &طلب، الدليل: &نص): منطقي {
    إذا (طول_النص(&(*الطلب).المدخل) > 0 || له_برامج(الدليل)) { أرجع خطأ; };
    طابق (*الطلب).الأمر مع
    | أمر_سوباكس.بناء -> { أرجع صواب; }
    | أمر_سوباكس.فحص -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف طابق_متعدد(الأمر: &أمر_سوباكس): منطقي {
    طابق *الأمر مع
    | أمر_سوباكس.فحص -> { أرجع صواب; }
    | أمر_سوباكس.بناء -> { أرجع صواب; }
    | أمر_سوباكس.اختبار -> { أرجع صواب; }
    | أمر_سوباكس.تنسيق -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// اسم الحزمة في دليل، أو الدليل نفسه إن تعذرت القراءة.
عرف اسم_حزمة_الدليل(الدليل: &نص): نص {
    طابق اقرأ_البيان(الدليل، تحقق_رابط) مع
    | نتيجة.نجح(ب) -> { أرجع انسخ_نص(&ب.الاسم); }
    | نتيجة.خطأ(_) -> { أرجع انسخ_نص(الدليل); };
}

عرف أسماء_الأعضاء(الأدلة: &متجه نص): نص {
    ليكن الأسماء: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأدلة) مثل طبيعي)) { ألحق(الأسماء، اسم_حزمة_الدليل(&(*الأدلة)[ف])); ف := ف + 1; }
    ليكن الفاصل: نص = «, »;
    أرجع صل_النصوص(&الأسماء، &الفاصل);
}

// الحزم التي يعمل عليها الأمر، كما في Cargo:
//   -p <الاسم>            ذلك العضو
//   داخل عضو              ذلك العضو
//   جذر بلا [package]      كل الأعضاء
//   جذر فيه [package]      الحزمة الجذر
عرف أدلة_الأعضاء(الطلب: &طلب، الأقرب: &نص): نتيجة متجه نص، نص {
    ليكن المساحة: اختياري مساحة_عمل = ابحث_عن_مساحة_العمل(الأقرب)؟;
    ليكن المختار: نص = قيمة_الخيار(الطلب، «package»);
    ليكن الأعضاء: متغير متجه نص = [انسخ_نص(الأقرب)];
    ليكن افتراضية: متغير منطقي = خطأ;
    ليكن جذر_المساحة: متغير نص = انسخ_نص(الأقرب);
    طابق المساحة مع
    | اختياري.موجود(م) -> { الأعضاء := استنسخ(&م.الأعضاء); افتراضية := م.افتراضية; جذر_المساحة := انسخ_نص(&م.الجذر); }
    | اختياري.لا_شيء -> { };
    إذا (طول_النص(&المختار) > 0) {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأعضاء) مثل طبيعي)) {
            إذا (نصان_متساويان(&اسم_حزمة_الدليل(&الأعضاء[ف])، &المختار)) {
                ليكن واحد: متجه نص = [انسخ_نص(&الأعضاء[ف])];
                أرجع نتيجة.نجح(واحد);
            };
            ف := ف + 1;
        }
        أرجع نتيجة.خطأ(ضم([رسالة(«لا توجد حزمة باسم "»، «no package named "»)، المختار، رسالة(«" في مساحة العمل. الحزم: »، «" in the workspace. Packages: »)،
            أسماء_الأعضاء(&الأعضاء)]));
    };
    ليكن الحالي: نص = قانوني(الأقرب)؟;
    إذا (افتراضية && نصان_متساويان(&الحالي، &جذر_المساحة)) { أرجع نتيجة.نجح(الأعضاء); };
    ليكن واحد: متجه نص = [انسخ_نص(الأقرب)];
    أرجع نتيجة.نجح(واحد);
}

// ينفذ الأمر لحزمة دليل واحد (أو للمخطط كله في أوامره).
عرف نفّذ_في(الطلب: &طلب، الجذر_م: &نص): نتيجة عدد، نص {
    ليكن الجذر: نص = انسخ_نص(الجذر_م);
    طابق (*الطلب).الأمر مع
    | أمر_سوباكس.بيانات -> {
        ليكن الكامل: مخطط = حل_وقفل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        ليكن المخطط: مخطط = بلا_التطوير(&الكامل);
        أرجع اكتب_البيانات(الطلب، &المخطط);
    }
    | أمر_سوباكس.إضافة -> { أرجع أضف_اعتمادية(الطلب، &الجذر); }
    | أمر_سوباكس.تنسيق -> { أرجع نسق_الحزمة(الطلب، &الجذر); }
    | أمر_سوباكس.إزالة -> { أرجع أزل_اعتمادية(الطلب، &الجذر); }
    | أمر_سوباكس.تنظيف -> {
        // في مساحة عمل: build/ في جذرها، لكل أعضائها (كما يفعل cargo clean).
        ليكن build: نص = صل_المسار(&جذر_البناء(&الجذر)، &«build»);
        احذف_شجرة(&build);
        أعلن(«أزال»، «Removed»، «build/»);
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.نشر -> {
        ليكن البيان: بيان = اقرأ_البيان(&الجذر، تحقق_رابط)؟;
        ليكن الرابط: نص = قيمة_الخيار(الطلب، «git»);
        ليكن المدخل: مدخل_منشور = جهز_للفهرس(&الجذر، &البيان، &الرابط)؟;
        ليكن الإصدار: نص = نص_أو_فارغ(انسخ_اختيار_نص(&البيان.الإصدار));
        أعلن(«حزّم»، «Packaged»، ضم([انسخ_نص(&البيان.الاسم)، « v»، انسخ_نص(&الإصدار)]));
        اشرح_النشر(&المدخل.الملف، &المدخل.النص، &البيان.الاسم، &الإصدار);
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.تحزيم -> {
        ليكن البيان: بيان = اقرأ_البيان(&الجذر، تحقق_رابط)؟;
        ليكن الرابط: نص = قيمة_الخيار(الطلب، «git»);
        ليكن المدخل: مدخل_منشور = جهز_للفهرس(&الجذر، &البيان، &الرابط)؟;
        ليكن الإصدار: نص = نص_أو_فارغ(انسخ_اختيار_نص(&البيان.الإصدار));
        أعلن(«حزّم»، «Packaged»، ضم([انسخ_نص(&البيان.الاسم)، « v»، الإصدار]));
        اطبع_سطر(ضم([«# »، انسخ_نص(&المدخل.الملف)]));
        اطبع_سطر(انسخ_نص(&المدخل.النص));
        اطبع_سطر_خطأ(ضم([رسالة(«ادفع الالتزام إلى المستودع العام، ثم أضف هذا المدخل إلى الملف »، «Push the commit to the public repository, then add this entry to the file »)،
            انسخ_نص(&المدخل.الملف)، رسالة(« في مستودع الفهرس»، « in the index repository»)]));
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.ترحيل -> {
        ليكن البيان: بيان = اقرأ_البيان(&الجذر، تحقق_رابط)؟;
        ليكن المتغيرة: متجه نص = رحّل_المرادفات(&البيان)؟;
        إذا ((الطول(المتغيرة) مثل طبيعي) == 0) {
            اطبع_سطر(رسالة(«لا شيء للترحيل: لا يوجد [imports-alias] في Supax.toml»، «nothing to migrate: Supax.toml has no [imports-alias]»));
            أرجع نتيجة.نجح(0);
        };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المتغيرة) مثل طبيعي)) {
            أعلن(«عدّل»، «Updated»، مسار_للعرض(&الجذر، &المتغيرة[ف]));
            ف := ف + 1;
        }
        اطبع_سطر(رسالة(«نُقلت تهجئات [imports-alias] إلى ملفات الجذر وحُذف القسم من Supax.toml»، «moved the [imports-alias] spellings into the root files and removed the section from Supax.toml»));
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.جلب -> {
        ليكن العمل: مخطط_عمل = حل_وقفل_العمل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        اطبع_سطر(ضم([رسالة(«جاهز: »، «ready: »)، عدد_الحزم(خارجية_العمل(&العمل))، رسالة(« في Supax.lock»، « in Supax.lock»)]));
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.تحديث -> {
        إذا ((*الطلب).الخيارات.مقفول) { أرجع نتيجة.خطأ(رسالة(«الأمر update لا يعمل مع --locked»، «update cannot be used with --locked»)); };
        ليكن العمل: مخطط_عمل = حل_وقفل_العمل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        اطبع_سطر(ضم([رسالة(«حُدّث Supax.lock: »، «updated Supax.lock: »)، عدد_الحزم(خارجية_العمل(&العمل))]));
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.شجرة -> {
        // في مساحة عمل: شجرة لكل عضو، يفصل بينها سطر فارغ.
        ليكن العمل: مخطط_عمل = حل_وقفل_العمل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العمل.الأعضاء) مثل طبيعي)) {
            إذا (ف > 0) { اطبع_سطر(«»); };
            ليكن الفرعي: مخطط = مخطط_فرعي(&العمل.الكامل، ف);
            اطبع_سطر(قص_النص(&نص_الشجرة(&الفرعي)));
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.تحقق -> {
        ليكن فارغة: متجه نص = [];
        ليكن الخيارات: خيارات_الحل = { بلا_شبكة: صواب، مقفول: صواب، تحديث_الكل: خطأ، تحديث: فارغة، للتثبيت: خطأ };
        ليكن العمل: مخطط_عمل = حل_وقفل_العمل(&الجذر، &الخيارات، خطأ)؟;
        اطبع_سطر(ضم([رسالة(«سليم: »، «ok: »)، عدد_الحزم(خارجية_العمل(&العمل))، رسالة(« تطابق Supax.lock والمخبأ»، « match Supax.lock and the cache»)]));
        أرجع نتيجة.نجح(0);
    }
    | أمر_سوباكس.فحص -> {
        ليكن الكامل: مخطط = حل_وقفل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        ليكن المخطط: مخطط = بلا_التطوير(&الكامل);
        ليكن البرامج: متجه برنامج = برامج_المشروع(الطلب، &الجذر، &المخطط، خطأ)؟;
        أرجع نفّذ_المترجم(الطلب، &الجذر، &المخطط، صواب، &البرامج);
    }
    | أمر_سوباكس.اختبار -> {
        ليكن المخطط: مخطط = حل_وقفل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        ليكن البيان: بيان = اقرأ_البيان(&الجذر، تحقق_رابط)؟;
        أرجع نفّذ_الاختبارات(الطلب، &الجذر، &المخطط، &البيان);
    }
    | أمر_سوباكس.بناء -> {
        ليكن الكامل: مخطط = حل_وقفل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        ليكن المخطط: مخطط = بلا_التطوير(&الكامل);
        ليكن البرامج: متجه برنامج = برامج_المشروع(الطلب، &الجذر، &المخطط، خطأ)؟;
        أرجع نفّذ_المترجم(الطلب، &الجذر، &المخطط، خطأ، &البرامج);
    }
    | أمر_سوباكس.تشغيل -> {
        ليكن الكامل: مخطط = حل_وقفل(&الجذر، &(*الطلب).الخيارات، صواب)؟;
        ليكن المخطط: مخطط = بلا_التطوير(&الكامل);
        ليكن البرامج: متجه برنامج = برامج_المشروع(الطلب، &الجذر، &المخطط، صواب)؟;
        ليكن الرمز: عدد = نفّذ_المترجم(الطلب، &الجذر، &المخطط، خطأ، &البرامج)؟;
        إذا (الرمز != 0) { أرجع نتيجة.نجح(الرمز); };
        ليكن المخرج: نص = مسار_المخرج_للطلب(الطلب، &الجذر، &البرامج[0].الاسم);
        أعلن(«يشغّل»، «Running»، نسبي_للعرض(&الجذر، &المخرج));
        ليكن الهدف: نص = قيمة_الخيار(الطلب، «target»);
        أرجع شغل_البرنامج(&المخرج، &(*الطلب).الإضافية، &الهدف);
    }
    | _ -> { أرجع نتيجة.نجح(0); };
}

// الحزم الخارجية: كل الحزم ما عدا أعضاء المساحة.
عرف خارجية_العمل(العمل: &مخطط_عمل): طبيعي {
    أرجع (الطول((*العمل).الكامل.الحزم) مثل طبيعي) - (الطول((*العمل).الأعضاء) مثل طبيعي);
}

عرف الاسم_الأول(الطلب: &طلب): نص {
    إذا ((الطول((*الطلب).المسماة) مثل طبيعي) == 0) { أرجع «»; };
    أرجع انسخ_نص(&(*الطلب).المسماة[0]);
}

// عدد الحزم بصيغة صحيحة: حزمة واحدة، حزمتان، 3 حزم، 11 حزمة؛ و package/packages.
عرف عدد_الحزم(العدد: طبيعي): نص {
    إذا (بالإنجليزية()) {
        إذا (العدد == 1) { أرجع «1 package»; };
        أرجع ضم([رقم_نصا(العدد)، « packages»]);
    };
    إذا (العدد == 0) { أرجع «لا حزم»; };
    إذا (العدد == 1) { أرجع «حزمة واحدة»; };
    إذا (العدد == 2) { أرجع «حزمتان»; };
    إذا (العدد <= 10) { أرجع ضم([رقم_نصا(العدد)، « حزم»]); };
    أرجع ضم([رقم_نصا(العدد)، « حزمة»]);
}

// supax metadata: مخطط الحزم إلى الخرج القياسي أو إلى --output. مع --relative
// تُكتب المسارات نسبةً إلى دليل ملف الخرج (أو دليل العمل إن لم يُعط).
عرف اكتب_البيانات(الطلب: &طلب، المخطط: &مخطط): نتيجة عدد، نص {
    ليكن الأساس: متغير نص = «»;
    ليكن المخرج: نص = انسخ_نص(&(*الطلب).المخرج);
    ليكن المخرج_المطلق: متغير نص = «»;
    إذا (طول_النص(&المخرج) > 0) {
        طابق حول_إلى_مسار_مطلق(&المخرج) مع
        | نتيجة.نجح(ق) -> { المخرج_المطلق := ق; }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة »، «cannot write »)، انسخ_نص(&المخرج)])); };
    };
    إذا ((*الطلب).نسبي) {
        إذا (طول_النص(&المخرج_المطلق) > 0) {
            طابق أب_المسار(&المخرج_المطلق) مع
            | اختياري.موجود(ق) -> { الأساس := ق; }
            | اختياري.لا_شيء -> { };
        } وإلا {
            طابق دليل_العمل() مع
            | نتيجة.نجح(ق) -> { الأساس := ق; }
            | نتيجة.خطأ(_) -> { };
        };
    };
    ليكن النص: نص = اكتب_نص_مخطط_الحزم(المخطط، &الأساس);
    إذا (طول_النص(&المخرج_المطلق) == 0) {
        اطبع(النص);
        أرجع نتيجة.نجح(0);
    };
    طابق أب_المسار(&المخرج_المطلق) مع
    | اختياري.موجود(الأب) -> { طابق أنشئ_مسار_الدليل(&الأب) مع | _ -> { }; }
    | اختياري.لا_شيء -> { };
    اكتب_إن_تغير(&المخرج_المطلق، &النص)؟;
    أرجع نتيجة.نجح(0);
}

// supax add <الاسم>[@<متطلب>] | <الاسم> (--path <مسار> | --git <رابط> [--tag|--branch|--rev <مرجع>])
عرف أضف_اعتمادية(الطلب: &طلب، الجذر: &نص): نتيجة عدد، نص {
    إذا ((الطول((*الطلب).المسماة) مثل طبيعي) != 1) {
        أرجع نتيجة.خطأ(رسالة(«الاستخدام: supax add <الاسم>[@<إصدار>] | <الاسم> (--path <مسار> | --git <رابط> [--tag <وسم>])»،
            «usage: supax add <name>[@<version>] | <name> (--path <path> | --git <url> [--tag <tag>])»));
    };
    // الاسم@المتطلب: من فهرس الحزم.
    ليكن الكامل: نص = انسخ_نص(&(*الطلب).المسماة[0]);
    ليكن آت: طبيعي = موضع_بايت(&الكامل، 64، 0);
    ليكن الاسم: نص = شريحة_نص(&الكامل، 0، آت);
    ليكن المتطلب: متغير نص = «»;
    ليكن له_متطلب: منطقي = آت < طول_النص(&الكامل);
    إذا (له_متطلب) { المتطلب := شريحة_نص(&الكامل، آت + 1، طول_النص(&الكامل)); };
    إذا (!معرف_صالح(&الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«اسم الاعتمادية "»، «dependency name "»)، انسخ_نص(&الاسم)،
            رسالة(«" ليس معرفا صالحا»، «" is not a valid identifier»)]));
    };
    ليكن المسار: نص = قيمة_الخيار(الطلب، «path»);
    ليكن الجت: نص = قيمة_الخيار(الطلب، «git»);
    إذا (طول_النص(&المسار) > 0 && طول_النص(&الجت) > 0) {
        أرجع نتيجة.خطأ(رسالة(«حدد مصدرا واحدا: الفهرس (الاسم@الإصدار)، أو --path <مسار>، أو --git <رابط>»،
            «give exactly one source: the index (name@version), --path <path> or --git <url>»));
    };
    ليكن من_الفهرس: منطقي = طول_النص(&المسار) == 0 && طول_النص(&الجت) == 0;
    إذا (له_متطلب && !من_الفهرس) {
        أرجع نتيجة.خطأ(رسالة(«الاسم@الإصدار للحزم من الفهرس فقط، لا مع --path أو --git»، «name@version is for index packages only, not with --path or --git»));
    };
    ليكن القيمة: متغير نص = «»;
    إذا (من_الفهرس) {
        إذا (!له_متطلب) {
            // بلا متطلب: أعلى إصدار نهائي غير مسحوب، كما يفعل cargo add.
            ليكن الفهرس_: فهرس = افتح_الفهرس((*الطلب).الخيارات.بلا_شبكة)؟;
            ليكن المدخل: مدخل_فهرس;
            ليكن المقروء: اختياري مدخل_فهرس = اقرأ_مدخل_الفهرس(&الفهرس_، &الاسم)؟;
            طابق المقروء مع
            | اختياري.موجود(م) -> { المدخل := م; }
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([رسالة(«لا توجد حزمة باسم "»، «no package named "»)، انسخ_نص(&الاسم)، رسالة(«" في فهرس الحزم »، «" in the package index »)، انسخ_نص(&الفهرس_.الرابط)]));
            };
            ليكن الكل: نص = «*»;
            ليكن كل_إصدار: متطلب_إصدار = حلل_متطلبا(&الكل)؟;
            طابق أعلى_إصدار_مطابق(&المدخل، &كل_إصدار) مع
            | اختياري.موجود(ف) -> { المتطلب := انسخ_نص(&المدخل.الإصدارات[ف].الإصدار); }
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([رسالة(«لا يوجد إصدار نهائي متاح من "»، «no released version of "»)، انسخ_نص(&الاسم)، «"»]));
            };
        } وإلا {
            حلل_متطلبا(&المتطلب)؟;
        };
        القيمة := نص_تومل(&المتطلب);
    } وإلا إذا (طول_النص(&المسار) > 0) {
        القيمة := ضم([«{ path = »، نص_تومل(&المسار)، « }»]);
    } وإلا {
        ليكن الأجزاء: متغير متجه نص = [«{ git = »، نص_تومل(&الجت)];
        ليكن المراجع: متجه نص = [«tag»، «branch»، «rev»];
        ليكن العدد: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < 3) {
            ليكن ق: نص = قيمة_الخيار(الطلب، انسخ_نص(&المراجع[ف]));
            إذا (طول_النص(&ق) > 0) {
                ألحق(الأجزاء، ضم([«, »، انسخ_نص(&المراجع[ف])، « = »، نص_تومل(&ق)]));
                العدد := العدد + 1;
            };
            ف := ف + 1;
        }
        إذا (العدد > 1) {
            أرجع نتيجة.خطأ(رسالة(«حدد واحدا فقط من --tag و --branch و --rev»، «give only one of --tag, --branch and --rev»));
        };
        ألحق(الأجزاء، « }»);
        القيمة := ضم(الأجزاء);
    };
    عدّل_البيان(الطلب، الجذر، &الاسم، &القيمة، صواب)؟;
    ليكن في_الجدول: متغير نص = «»;
    إذا (علم_معطى(الطلب، «dev»)) { في_الجدول := رسالة(« في [dev-dependencies]»، « to [dev-dependencies]»); };
    أعلن(«أضاف»، «Added»، ضم([مفتاح_الاعتمادية(&الاسم)، « = »، القيمة، في_الجدول]));
    أرجع نتيجة.نجح(0);
}

// supax remove <الاسم>
عرف أزل_اعتمادية(الطلب: &طلب، الجذر: &نص): نتيجة عدد، نص {
    إذا ((الطول((*الطلب).المسماة) مثل طبيعي) != 1) {
        أرجع نتيجة.خطأ(رسالة(«الاستخدام: supax remove <الاسم>»، «usage: supax remove <name>»));
    };
    ليكن الاسم: نص = انسخ_نص(&(*الطلب).المسماة[0]);
    ليكن فارغ: نص = «»;
    عدّل_البيان(الطلب، الجذر، &الاسم، &فارغ، خطأ)؟;
    ليكن من_الجدول: متغير نص = «»;
    إذا (علم_معطى(الطلب، «dev»)) { من_الجدول := رسالة(« من [dev-dependencies]»، « from [dev-dependencies]»); };
    أعلن(«أزال»، «Removed»، ضم([الاسم، من_الجدول]));
    أرجع نتيجة.نجح(0);
}

// supax fmt [--check]: sultanc fmt على مصادر الحزمة: src/ و tests/ و main.sn في
// الجذر، ودليل [lib] إن كان خارج src/. لا يحتاج حل الاعتماديات.
عرف نسق_الحزمة(الطلب: &طلب، الجذر: &نص): نتيجة عدد، نص {
    ليكن البيان: بيان = اقرأ_البيان(الجذر، تحقق_رابط)؟;
    ليكن المسارات: متغير متجه نص = [];
    ليكن src: نص = صل_المسار(الجذر، &«src»);
    ليكن الأسماء: متجه نص = [«src»، «tests»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن الدليل: نص = صل_المسار(الجذر، &الأسماء[ف]);
        طابق اقرأ_مدخلات_الدليل(&الدليل) مع
        | نتيجة.نجح(_) -> { ألحق(المسارات، الدليل); }
        | نتيجة.خطأ(_) -> { };
        ف := ف + 1;
    }
    ليكن رئيسي: نص = صل_المسار(الجذر، &«main.sn»);
    إذا (ملف_موجود(&رئيسي)) { ألحق(المسارات، رئيسي); };
    ليكن جذر_المصدر: نص = انسخ_نص(&البيان.جذر_المصدر);
    إذا (!نصان_متساويان(&جذر_المصدر، الجذر) && !نصان_متساويان(&جذر_المصدر، &src)
        && !يبدأ_بـ(&جذر_المصدر، &ضم([انسخ_نص(&src)، «/»]))) {
        ألحق(المسارات، جذر_المصدر);
    };
    إذا ((الطول(المسارات) مثل طبيعي) == 0) {
        اطبع_سطر_خطأ(رسالة(«لا مصادر للتنسيق: لا src/ ولا tests/ ولا main.sn»، «nothing to format: no src/, tests/ or main.sn»));
        أرجع نتيجة.نجح(0);
    };
    ليكن الوسائط: متغير متجه نص = [ضم([«--lang=»، رسالة(«ar»، «en»)])];
    ليكن الرسائل: متجه نص = وسائط_الرسائل();
    ف := 0;
    طالما (ف < (الطول(الرسائل) مثل طبيعي)) { ألحق(الوسائط، انسخ_نص(&الرسائل[ف])); ف := ف + 1; }
    ألحق(الوسائط، «fmt»);
    إذا (علم_معطى(الطلب، «check»)) { ألحق(الوسائط، «--check»); };
    ف := 0;
    طالما (ف < (الطول(المسارات) مثل طبيعي)) { ألحق(الوسائط، انسخ_نص(&المسارات[ف])); ف := ف + 1; }
    أرجع شغل_المترجم(الوسائط);
}

// supax install: يبني الحزمة (--release) ثم ينسخ برامجها إلى $SUPAX_HOME/bin.
عرف ثبّت(الطلب: &طلب): نتيجة عدد، نص {
    إذا (علم_معطى(الطلب، «list»)) { أرجع اسرد_المثبت(); };
    إذا (طول_النص(&قيمة_الخيار(الطلب، «target»)) > 0) {
        أرجع نتيجة.خطأ(رسالة(«supax install يبني لهذا الجهاز؛ لبرنامج لهدف آخر استخدم supax build --target <هدف>»،
            «supax install builds for this machine; for another target use supax build --target <target>»));
    };
    ليكن المصدر: مصدر_تثبيت = جهز_مصدر_التثبيت(الطلب)؟;
    ليكن الناتج: نتيجة عدد، نص = ثبّت_من(الطلب، &المصدر);
    إذا (طول_النص(&المصدر.المؤقت) > 0) { احذف_شجرة(&المصدر.المؤقت); };
    أرجع الناتج;
}

عرف ثبّت_من(الطلب: &طلب، المصدر: &مصدر_تثبيت): نتيجة عدد، نص {
    ليكن الدليل: نص = انسخ_نص(&(*المصدر).الدليل);
    ليكن البيان: بيان = اقرأ_البيان(&الدليل، تحقق_رابط)؟;
    إذا (!له_برامج(&الدليل)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«لا شيء لتثبيته: الحزمة "»، «nothing to install: the package "»)، انسخ_نص(&البيان.الاسم)،
            رسالة(«" بلا برامج (لا src/main.sn ولا src/bin/*.sn)»، «" has no programs (no src/main.sn and no src/bin/*.sn)»)]));
    };
    ليكن الإصدار: متغير نص = «»;
    طابق انسخ_اختيار_نص(&البيان.الإصدار) مع
    | اختياري.موجود(ق) -> { الإصدار := ق; }
    | اختياري.لا_شيء -> { };
    أعلن(«يثبّت»، «Installing»، ضم([انسخ_نص(&البيان.الاسم)، « v»، انسخ_نص(&الإصدار)]));
    ليكن طلب_البناء: متغير طلب = استنسخ(الطلب);
    طلب_البناء.الأمر := أمر_سوباكس.بناء();
    طلب_البناء.إصدار_نهائي := صواب;
    طلب_البناء.المسماة := [];
    طلب_البناء.الإضافية := [];
    ليكن الرمز: عدد = نفّذ_في(&طلب_البناء، &الدليل)؟;
    إذا (الرمز != 0) { أرجع نتيجة.نجح(الرمز); };
    ليكن الكامل: مخطط = حل_وقفل(&الدليل، &طلب_البناء.الخيارات، خطأ)؟;
    ليكن المخطط: مخطط = بلا_التطوير(&الكامل);
    ليكن البرامج: متجه برنامج = برامج_المشروع(&طلب_البناء، &الدليل، &المخطط، خطأ)؟;
    ليكن المخرجات: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البرامج) مثل طبيعي)) {
        ألحق(المخرجات، مسار_المخرج_للطلب(&طلب_البناء، &الدليل، &البرامج[ف].الاسم));
        ف := ف + 1;
    }
    ثبت_البرامج(&البرامج، &المخرجات، &البيان.الاسم، &الإصدار، المصدر، علم_معطى(الطلب، «force»))؟;
    ليكن bin: نص = دليل_البرامج()؟;
    أعلن(«ثُبّت»، «Installed»، ضم([انسخ_نص(&البيان.الاسم)، « v»، الإصدار، رسالة(« في »، « in »)، bin]));
    أرجع نتيجة.نجح(0);
}

// add و remove: [dev-dependencies] مع --dev، وإلا [dependencies].
عرف جدول_التعديل(الطلب: &طلب): نص {
    إذا (علم_معطى(الطلب، «dev»)) { أرجع «dev-dependencies»; };
    أرجع «dependencies»;
}

// يعدّل Supax.toml ثم يحل المخطط ويحدّث Supax.lock؛ إن فشل شيء أعاد الملفين كما كانا.
عرف عدّل_البيان(الطلب: &طلب، الجذر: &نص، الاسم: &نص، القيمة: &نص، إضافة: منطقي): نتيجة نص، نص {
    ليكن اسم_ب: نص = اسم_البيان();
    ليكن البيان: نص = صل_المسار(الجذر، &اسم_ب);
    // Supax.lock في جذر مساحة العمل إن كانت الحزمة عضوا فيها.
    ليكن اسم_ق: نص = اسم_القفل();
    ليكن دليل_القفل: متغير نص = انسخ_نص(الجذر);
    ليكن المساحة: اختياري مساحة_عمل = ابحث_عن_مساحة_العمل(الجذر)؟;
    طابق المساحة مع
    | اختياري.موجود(م) -> { دليل_القفل := انسخ_نص(&م.الجذر); }
    | اختياري.لا_شيء -> { };
    ليكن القفل: نص = صل_المسار(&دليل_القفل، &اسم_ق);
    ليكن الأصل: نص;
    طابق اقرأ_الملف(&البيان) مع
    | نتيجة.نجح(ق) -> { الأصل := ق; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة »، «cannot read »)، البيان])); };
    ليكن قفل_الأصل: اختياري نص = قراءة_اختيارية(&القفل);
    ليكن الجديد: نص;
    ليكن الجدول: نص = جدول_التعديل(الطلب);
    إذا (إضافة) { الجديد := أضف_إلى_البيان(&الأصل، الاسم، القيمة، &الجدول)؟; } وإلا { الجديد := احذف_من_البيان(&الأصل، الاسم، &الجدول)؟; };
    اكتب_إن_تغير(&البيان، &الجديد)؟;
    طابق حل_وقفل(الجذر، &(*الطلب).الخيارات، صواب) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(«»); }
    | نتيجة.خطأ(السبب) -> {
        طابق اكتب_إن_تغير(&البيان، &الأصل) مع | _ -> { };
        طابق قفل_الأصل مع
        | اختياري.موجود(ق) -> { طابق اكتب_إن_تغير(&القفل، &ق) مع | _ -> { }; }
        | اختياري.لا_شيء -> { طابق أزل_ملفا(&القفل) مع | _ -> { }; };
        أرجع نتيجة.خطأ(ضم([السبب، سطر_جديد()، رسالة(«لم يتغير Supax.toml.»، «Supax.toml was not changed.»)]));
    };
}

عرف قراءة_اختيارية(المسار: &نص): اختياري نص {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(ق) -> { أرجع اختياري.موجود(ق); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// supax cache info | clean — لا يحتاج مشروعا.
عرف نفّذ_المخبأ(الطلب: &طلب): نتيجة عدد، نص {
    ليكن الفعل: نص = الاسم_الأول(الطلب);
    ليكن الجذر: نص = جذر_المخبأ()؟;
    إذا (يساوي_نصا(&الفعل، «info») || يساوي_نصا(&الفعل، «معلومات») || طول_النص(&الفعل) == 0) {
        ليكن م: معلومات_المخبأ = معلومات_مخبأ(&الجذر);
        ليكن الحجم: متغير نص = «»;
        إذا (م.البايتات < 1048576) {
            ليكن كيلو: عدد = (م.البايتات + 512) / 1024;
            الحجم := ضم([رقم_نصا(كيلو مثل طبيعي)، رسالة(« كيلوبايت»، « KB»)]);
        } وإلا {
            ليكن ميغا: عدد = (م.البايتات + 524288) / 1048576;
            الحجم := ضم([رقم_نصا(ميغا مثل طبيعي)، رسالة(« ميغابايت»، « MB»)]);
        };
        اطبع_سطر(ضم([رسالة(«المخبأ: »، «cache: »)، انسخ_نص(&م.الجذر)]));
        اطبع_سطر(ضم([رسالة(«المستودعات: »، «repositories: »)، رقم_نصا(م.المستودعات)]));
        اطبع_سطر(ضم([رسالة(«النسخ المسحوبة: »، «checkouts: »)، رقم_نصا(م.النسخ)]));
        اطبع_سطر(ضم([رسالة(«الحجم: »، «size: »)، الحجم]));
        أرجع نتيجة.نجح(0);
    };
    إذا (يساوي_نصا(&الفعل، «clean») || يساوي_نصا(&الفعل، «نظف»)) {
        نظف_المخبأ(&الجذر)؟;
        أعلن(«أزال»، «Removed»، رسالة(«مخبأ git؛ يُجلب ما يلزم من جديد عند الحاجة»، «the git cache; whatever is needed is fetched again»));
        أرجع نتيجة.نجح(0);
    };
    أرجع نتيجة.خطأ(رسالة(«الاستخدام: supax cache [info | clean]»، «usage: supax cache [info | clean]»));
}
