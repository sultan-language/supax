عام نوع أمر_سوباكس =
    | جلب
    | تحديث
    | شجرة
    | تحقق
    | فحص
    | بناء
    | تشغيل
    | جديد
    | تهيئة
    | بيانات
    | إضافة
    | إزالة
    | تنظيف
    | مخبأ
    | ترحيل
    | تحزيم
    | اختبار
    | مساعدة
    | إصدار
;

عام نوع طلب = {
    الأمر: أمر_سوباكس,
    الخيارات: خيارات_الحل,
    المسماة: متجه نص,
    الإضافية: متجه نص,
    المدخل: نص,
    // supax metadata: --output=<ملف> و --relative.
    المخرج: نص,
    نسبي: منطقي,
    // الخيارات ذات القيمة (--path و --git و --tag و --branch و --rev و --target).
    القيم: متجه خيار_بقيمة,
    // --release: بناء محسَّن عبر المترجم.
    إصدار_نهائي: منطقي,
    // أعلام بلا قيمة لأمر بعينه (supax test: --lib و --no-fail-fast و --list)، بلا «--».
    الأعلام: متجه نص
};

// هل أُعطي العلم (بلا «--»)؟
عام عرف علم_معطى(الطلب: &طلب, الاسم: نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطلب).الأعلام) مثل طبيعي)) {
        إذا (يساوي_نصا(&(*الطلب).الأعلام[ف], انسخ_نص(&الاسم))) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام نوع خيار_بقيمة = { الاسم: نص, القيمة: نص };

// قيمة خيار، أو «» إن لم يُعط.
عام عرف قيمة_الخيار(الطلب: &طلب, الاسم: نص): نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطلب).القيم) مثل طبيعي)) {
        إذا (يساوي_نصا(&(*الطلب).القيم[ف].الاسم, انسخ_نص(&الاسم))) { أرجع انسخ_نص(&(*الطلب).القيم[ف].القيمة); };
        ف := ف + 1;
    }
    أرجع «»;
}

// الخيارات التي تأخذ قيمة، بالصيغتين --x=قيمة و --x قيمة.
عرف خيار_بقيمة_معروف(الاسم: &نص): منطقي {
    أرجع يساوي_نصا(الاسم, «--output») || يساوي_نصا(الاسم, «--path») || يساوي_نصا(الاسم, «--git»)
        || يساوي_نصا(الاسم, «--tag») || يساوي_نصا(الاسم, «--branch») || يساوي_نصا(الاسم, «--rev»)
        || يساوي_نصا(الاسم, «--target») || يساوي_نصا(الاسم, «--bin») || يساوي_نصا(الاسم, «--test») || يساوي_نصا(الاسم, «--package»);
}

عام عرف أمر_من_نص(النص: &نص): اختياري أمر_سوباكس {
    إذا (يساوي_نصا(النص, «fetch») || يساوي_نصا(النص, «جلب»)) { أرجع اختياري.موجود(أمر_سوباكس.جلب()); };
    إذا (يساوي_نصا(النص, «update») || يساوي_نصا(النص, «حدث»)) { أرجع اختياري.موجود(أمر_سوباكس.تحديث()); };
    إذا (يساوي_نصا(النص, «tree») || يساوي_نصا(النص, «شجرة»)) { أرجع اختياري.موجود(أمر_سوباكس.شجرة()); };
    إذا (يساوي_نصا(النص, «verify») || يساوي_نصا(النص, «تحقق»)) { أرجع اختياري.موجود(أمر_سوباكس.تحقق()); };
    إذا (يساوي_نصا(النص, «check») || يساوي_نصا(النص, «افحص»)) { أرجع اختياري.موجود(أمر_سوباكس.فحص()); };
    إذا (يساوي_نصا(النص, «build») || يساوي_نصا(النص, «ابن»)) { أرجع اختياري.موجود(أمر_سوباكس.بناء()); };
    إذا (يساوي_نصا(النص, «run») || يساوي_نصا(النص, «شغل»)) { أرجع اختياري.موجود(أمر_سوباكس.تشغيل()); };
    إذا (يساوي_نصا(النص, «add») || يساوي_نصا(النص, «أضف»)) { أرجع اختياري.موجود(أمر_سوباكس.إضافة()); };
    إذا (يساوي_نصا(النص, «remove») || يساوي_نصا(النص, «احذف»)) { أرجع اختياري.موجود(أمر_سوباكس.إزالة()); };
    إذا (يساوي_نصا(النص, «cache») || يساوي_نصا(النص, «مخبأ»)) { أرجع اختياري.موجود(أمر_سوباكس.مخبأ()); };
    إذا (يساوي_نصا(النص, «test») || يساوي_نصا(النص, «اختبر»)) { أرجع اختياري.موجود(أمر_سوباكس.اختبار()); };
    إذا (يساوي_نصا(النص, «package») || يساوي_نصا(النص, «حزّم») || يساوي_نصا(النص, «حزم»)) { أرجع اختياري.موجود(أمر_سوباكس.تحزيم()); };
    إذا (يساوي_نصا(النص, «migrate») || يساوي_نصا(النص, «رحّل») || يساوي_نصا(النص, «رحل»)) { أرجع اختياري.موجود(أمر_سوباكس.ترحيل()); };
    إذا (يساوي_نصا(النص, «clean») || يساوي_نصا(النص, «نظف»)) { أرجع اختياري.موجود(أمر_سوباكس.تنظيف()); };
    إذا (يساوي_نصا(النص, «metadata») || يساوي_نصا(النص, «بيانات»)) { أرجع اختياري.موجود(أمر_سوباكس.بيانات()); };
    إذا (يساوي_نصا(النص, «new») || يساوي_نصا(النص, «جديد»)) { أرجع اختياري.موجود(أمر_سوباكس.جديد()); };
    إذا (يساوي_نصا(النص, «init») || يساوي_نصا(النص, «هيئ»)) { أرجع اختياري.موجود(أمر_سوباكس.تهيئة()); };
    إذا (يساوي_نصا(النص, «help») || يساوي_نصا(النص, «--help») || يساوي_نصا(النص, «-h») || يساوي_نصا(النص, «مساعدة»)) {
        أرجع اختياري.موجود(أمر_سوباكس.مساعدة());
    };
    إذا (يساوي_نصا(النص, «version») || يساوي_نصا(النص, «--version») || يساوي_نصا(النص, «إصدار»)) {
        أرجع اختياري.موجود(أمر_سوباكس.إصدار());
    };
    أرجع اختياري.لا_شيء();
}

عام عرف حلل_الوسائط(الوسائط: &متجه نص): نتيجة طلب, نص {
    دع العدد: طبيعي = الطول(*الوسائط) مثل طبيعي;
    إذا (العدد < 2) {
        دع فارغة: متجه نص = [];
        دع ف1: متجه نص = [];
        دع ف2: متجه نص = [];
        دع ق: متجه خيار_بقيمة = [];
        دع ط: طلب = {
            الأمر: أمر_سوباكس.مساعدة(),
            الخيارات: { بلا_شبكة: خطأ, مقفول: خطأ, تحديث_الكل: خطأ, تحديث: فارغة },
            المسماة: ف1, الإضافية: ف2, المدخل: «», المخرج: «», نسبي: خطأ, القيم: ق, إصدار_نهائي: خطأ, الأعلام: []
        };
        أرجع نتيجة.نجح(ط);
    };
    دع الأمر: أمر_سوباكس;
    طابق أمر_من_نص(&(*الوسائط)[1]) مع
    | اختياري.موجود(أ) -> { الأمر := أ; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(ضم([رسالة(«أمر غير معروف "», «unknown command "»), انسخ_نص(&(*الوسائط)[1]), رسالة(«". شغّل supax help», «". Run supax help»)]));
    };
    دع بلا_شبكة: متغير منطقي = خطأ;
    دع مقفول: متغير منطقي = خطأ;
    دع المسماة: متغير متجه نص = [];
    دع الإضافية: متغير متجه نص = [];
    دع المدخل: متغير نص = «»;
    دع نسبي: متغير منطقي = خطأ;
    دع إصدار_نهائي: متغير منطقي = خطأ;
    دع القيم: متغير متجه خيار_بقيمة = [];
    دع الأعلام: متغير متجه نص = [];
    دع بعد_الفاصل: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 2;
    طالما (ف < العدد) {
        دع و: &نص = &(*الوسائط)[ف];
        إذا (بعد_الفاصل) {
            ألحق(الإضافية, انسخ_نص(و));
        } وإلا إذا (يساوي_نصا(و, «--»)) {
            بعد_الفاصل := صواب;
        } وإلا إذا (يساوي_نصا(و, «--locked»)) {
            مقفول := صواب;
        } وإلا إذا (يساوي_نصا(و, «--offline»)) {
            بلا_شبكة := صواب;
        } وإلا إذا (يساوي_نصا(و, «--frozen»)) {
            مقفول := صواب;
            بلا_شبكة := صواب;
        } وإلا إذا (يساوي_نصا(و, «--relative»)) {
            نسبي := صواب;
        } وإلا إذا (يساوي_نصا(و, «--release»)) {
            إصدار_نهائي := صواب;
        } وإلا إذا (يساوي_نصا(و, «--lib») || يساوي_نصا(و, «--no-fail-fast») || يساوي_نصا(و, «--list»)) {
            ألحق(الأعلام, شريحة_نص(و, 2, طول_النص(و)));
        } وإلا إذا (طول_النص(و) > 2 && (*و)[0] == 45 && (*و)[1] == 45) {
            // --x=قيمة أو --x قيمة.
            دع المساواة: طبيعي = موضع_بايت(و, 61, 0);
            دع الاسم: نص = شريحة_نص(و, 0, المساواة);
            إذا (!خيار_بقيمة_معروف(&الاسم)) {
                أرجع نتيجة.خطأ(ضم([رسالة(«خيار غير معروف "», «unknown option "»), انسخ_نص(و), «"»]));
            };
            دع القيمة: متغير نص = «»;
            إذا (المساواة < طول_النص(و)) {
                القيمة := شريحة_نص(و, المساواة + 1, طول_النص(و));
            } وإلا {
                إذا (ف + 1 >= العدد) {
                    أرجع نتيجة.خطأ(ضم([رسالة(«الخيار يحتاج قيمة: », «the option needs a value: »), الاسم]));
                };
                ف := ف + 1;
                القيمة := انسخ_نص(&(*الوسائط)[ف]);
            };
            دع خ: خيار_بقيمة = { الاسم: شريحة_نص(&الاسم, 2, طول_النص(&الاسم)), القيمة: القيمة };
            ألحق(القيم, خ);
        } وإلا إذا (يساوي_نصا(و, «-p»)) {
            إذا (ف + 1 >= العدد) {
                أرجع نتيجة.خطأ(ضم([رسالة(«الخيار يحتاج قيمة: », «the option needs a value: »), «-p»]));
            };
            ف := ف + 1;
            دع خ: خيار_بقيمة = { الاسم: «package», القيمة: انسخ_نص(&(*الوسائط)[ف]) };
            ألحق(القيم, خ);
        } وإلا إذا (يساوي_نصا(و, «-t»)) {
            إذا (ف + 1 >= العدد) {
                أرجع نتيجة.خطأ(ضم([رسالة(«الخيار يحتاج قيمة: », «the option needs a value: »), «-t»]));
            };
            ف := ف + 1;
            دع خ: خيار_بقيمة = { الاسم: «target», القيمة: انسخ_نص(&(*الوسائط)[ف]) };
            ألحق(القيم, خ);
        } وإلا إذا (طول_النص(و) > 0 && (*و)[0] == 45) {
            أرجع نتيجة.خطأ(ضم([رسالة(«خيار غير معروف "», «unknown option "»), انسخ_نص(و), «"»]));
        } وإلا {
            ألحق(المسماة, انسخ_نص(و));
        };
        ف := ف + 1;
    }
    // المدخل: أول اسم مسمى لأوامر المترجم.
    طابق الأمر مع
    | أمر_سوباكس.فحص -> { إذا ((الطول(المسماة) مثل طبيعي) > 0) { المدخل := انسخ_نص(&المسماة[0]); }; }
    | أمر_سوباكس.بناء -> { إذا ((الطول(المسماة) مثل طبيعي) > 0) { المدخل := انسخ_نص(&المسماة[0]); }; }
    | أمر_سوباكس.تشغيل -> { إذا ((الطول(المسماة) مثل طبيعي) > 0) { المدخل := انسخ_نص(&المسماة[0]); }; }
    | _ -> { };
    دع تحديث_الكل: منطقي = طابق_تحديث_الكل(&الأمر, &المسماة);
    دع التحديث: متجه نص = استنسخ(&المسماة);
    دع الطلب: متغير طلب = {
        الأمر: الأمر,
        الخيارات: { بلا_شبكة: بلا_شبكة, مقفول: مقفول, تحديث_الكل: تحديث_الكل, تحديث: التحديث },
        المسماة: المسماة,
        الإضافية: الإضافية,
        المدخل: المدخل,
        المخرج: «»,
        نسبي: نسبي,
        القيم: القيم,
        إصدار_نهائي: إصدار_نهائي,
        الأعلام: الأعلام
    };
    الطلب.المخرج := قيمة_الخيار(&الطلب, «output»);
    أرجع نتيجة.نجح(الطلب);
}

عام عرف طابق_تحديث_الكل(الأمر: &أمر_سوباكس, المسماة: &متجه نص): منطقي {
    طابق *الأمر مع
    | أمر_سوباكس.تحديث -> { أرجع (الطول(*المسماة) مثل طبيعي) == 0; }
    | _ -> { أرجع خطأ; };
}
