// خيار عام بقيمة: --اسم=قيمة أو --اسم قيمة. يرجع القيمة، ويقدّم الموضع إن أخذ
// القيمة من الوسيط التالي؛ أو لا شيء إن لم يكن الوسيط هذا الخيار.
عرف قيمة_خيار_عام(الوسائط: &متجه نص, الموضع: &متغير طبيعي, الاسم: نص): نتيجة اختياري نص, نص {
    دع و: &نص = &(*الوسائط)[*الموضع];
    دع بمساواة: نص = ضم([انسخ_نص(&الاسم), «=»]);
    إذا (يبدأ_بـ(و, &بمساواة)) {
        أرجع نتيجة.نجح(اختياري.موجود(شريحة_نص(و, طول_النص(&بمساواة), طول_النص(و))));
    };
    إذا (!نصان_متساويان(و, &الاسم)) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
    إذا (*الموضع + 1 >= (الطول(*الوسائط) مثل طبيعي)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«الخيار يحتاج قيمة: », «the option needs a value: »), انسخ_نص(&الاسم)]));
    };
    *الموضع := *الموضع + 1;
    أرجع نتيجة.نجح(اختياري.موجود(انسخ_نص(&(*الوسائط)[*الموضع])));
}

عرف اضبط_البيئة(الاسم: نص, القيمة: &نص): فراغ {
    دع ا: نص = الاسم;
    طابق اضبط_متغير_بيئة(&ا, القيمة) مع | _ -> { };
}

عرف واحد_من(القيمة: &نص, الأول: نص, الثاني: نص, الثالث: نص): منطقي {
    أرجع يساوي_نصا(القيمة, الأول) || يساوي_نصا(القيمة, الثاني) || يساوي_نصا(القيمة, الثالث);
}

// يأخذ الخيارات العامة من الوسائط قبل «--» ويضبط بيئتها قبل أي رسالة:
//   --lang=ar|en                      SUPAX_LANG
//   --quiet، -q                        SUPAX_QUIET=1
//   --message-format=human|short|json  للمترجم --diagnostic-format؛ json يكتم أسطر الحالة
//   --color=auto|always|never          للمترجم --color
// ما بعد «--» للبرنامج أو للمترجم كما هو.
عرف خذ_اللغة(الوسائط: متجه نص): نتيجة متجه نص, نص {
    دع الباقية: متغير متجه نص = [];
    دع البادئة: نص = «--lang=»;
    دع بعد_الفاصل: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوسائط) مثل طبيعي)) {
        دع الصيغة: متغير اختياري نص = اختياري.لا_شيء();
        دع اللون: متغير اختياري نص = اختياري.لا_شيء();
        إذا (!بعد_الفاصل) {
            الصيغة := قيمة_خيار_عام(&الوسائط, &متغير ف, «--message-format»)؟;
        };
        إذا (!بعد_الفاصل && !هل_موجود(&الصيغة)) {
            اللون := قيمة_خيار_عام(&الوسائط, &متغير ف, «--color»)؟;
        };
        إذا (بعد_الفاصل) {
            ألحق(الباقية, انسخ_نص(&الوسائط[ف]));
        } وإلا إذا (هل_موجود(&الصيغة)) {
            دع القيمة: نص = قيمة_أو_فارغ(&الصيغة);
            إذا (!واحد_من(&القيمة, «human», «short», «json»)) {
                أرجع نتيجة.خطأ(ضم([«--message-format: human | short | json», رسالة(« (المعطى: », « (given: »), القيمة, «)»]));
            };
            اضبط_البيئة(«SUPAX_MESSAGE_FORMAT», &القيمة);
            إذا (يساوي_نصا(&القيمة, «json»)) { دع واحد: نص = «1»; اضبط_البيئة(«SUPAX_QUIET», &واحد); };
        } وإلا إذا (هل_موجود(&اللون)) {
            دع القيمة: نص = قيمة_أو_فارغ(&اللون);
            إذا (!واحد_من(&القيمة, «auto», «always», «never»)) {
                أرجع نتيجة.خطأ(ضم([«--color: auto | always | never», رسالة(« (المعطى: », « (given: »), القيمة, «)»]));
            };
            اضبط_البيئة(«SUPAX_COLOR», &القيمة);
        } وإلا إذا (يساوي_نصا(&الوسائط[ف], «--»)) {
            بعد_الفاصل := صواب;
            ألحق(الباقية, انسخ_نص(&الوسائط[ف]));
        } وإلا إذا (يبدأ_بـ(&الوسائط[ف], &البادئة)) {
            دع القيمة: نص = شريحة_نص(&الوسائط[ف], طول_النص(&البادئة), طول_النص(&الوسائط[ف]));
            دع ar: نص = «ar»;
            دع en: نص = «en»;
            إذا (!نصان_متساويان(&القيمة, &ar) && !نصان_متساويان(&القيمة, &en)) {
                أرجع نتيجة.خطأ(«--lang: ar | en»);
            };
            دع الاسم: نص = «SUPAX_LANG»;
            طابق اضبط_متغير_بيئة(&الاسم, &القيمة) مع | _ -> { };
        } وإلا إذا (يساوي_نصا(&الوسائط[ف], «--quiet») || يساوي_نصا(&الوسائط[ف], «-q»)) {
            دع الاسم: نص = «SUPAX_QUIET»;
            دع واحد: نص = «1»;
            طابق اضبط_متغير_بيئة(&الاسم, &واحد) مع | _ -> { };
        } وإلا {
            ألحق(الباقية, انسخ_نص(&الوسائط[ف]));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الباقية);
}

عرف هل_موجود(ق: &اختياري نص): منطقي {
    طابق *ق مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف قيمة_أو_فارغ(ق: &اختياري نص): نص {
    طابق *ق مع
    | اختياري.موجود(ن) -> { أرجع انسخ_نص(&ن); }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف الرئيسية(): عدد {
    دع المعطاة: متجه نص;
    طابق خذ_اللغة(الوسائط()) مع
    | نتيجة.خطأ(السبب) -> { اطبع_سطر_خطأ(ضم([رسالة(«خطأ: », «error: »), السبب])); أرجع 2; }
    | نتيجة.نجح(ق) -> { المعطاة := ق; };
    دع الطلب: طلب;
    طابق حلل_الوسائط(&المعطاة) مع
    | نتيجة.خطأ(السبب) -> { اطبع_سطر_خطأ(ضم([رسالة(«خطأ: », «error: »), السبب])); أرجع 2; }
    | نتيجة.نجح(ط) -> { الطلب := ط; };
    طابق نفّذ(&الطلب) مع
    | نتيجة.خطأ(السبب) -> { اطبع_سطر_خطأ(ضم([رسالة(«خطأ: », «error: »), السبب])); أرجع 1; }
    | نتيجة.نجح(الرمز) -> { أرجع الرمز; };
}
