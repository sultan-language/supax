// supax migrate: ينقل [imports-alias] من Supax.toml إلى أسطر «وحدة» في ملفات الجذر.
//
// منذ SultanC e1d4bca لا يقرأ المترجم [imports-alias]. تُعلن تهجئات الوحدة في ملف
// جذر أبيها:
//   helpers       -> <جذر المصدر>/<اسم الحزمة>.sn   وحدة helpers { ar: مساعدات };
//   text.number   -> <جذر المصدر>/text/text.sn      وحدة number { ar: رقم };
//
// تُكتب ملفات المصدر أولا، ثم يُحذف القسم من Supax.toml؛ وإن فشل شيء أُعيد كل
// ملف إلى ما كان عليه.
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.متجهات;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.manifest.manifest;

// سطر يُضاف إلى ملف جذر: الملف مسار مطلق، والوحدة اسم الابن، والتهجئات «ar: …, fr: …».
عام نوع بند_ترحيل = { الملف: نص, الوحدة: نص, التهجئات: نص };

// نص السطر بالكلمة المعطاة («وحدة» في الملف، أو «module» في رسالة إنجليزية).
عام عرف سطر_البند(البند: &بند_ترحيل, الكلمة: نص): نص {
    أرجع ضم([الكلمة, « », انسخ_نص(&(*البند).الوحدة), « { », انسخ_نص(&(*البند).التهجئات), « };»]);
}

// بند لكل مدخل في [imports-alias].
عام عرف بنود_الترحيل(اسم_الحزمة: &نص, جذر_المصدر: &نص, المرادفات: &متجه مرادف_استيراد): متجه بند_ترحيل {
    دع الناتج: متغير متجه بند_ترحيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرادفات) مثل طبيعي)) {
        دع م: &مرادف_استيراد = &(*المرادفات)[ف];
        دع المسار: &نص = &(*م).المسار;
        // آخر نقطة: ما قبلها الأب، وما بعدها اسم الوحدة.
        دع النقطة: متغير طبيعي = طول_النص(المسار);
        دع ب: متغير طبيعي = 0;
        طالما (ب < طول_النص(المسار)) {
            إذا ((*المسار)[ب] == 46) { النقطة := ب; };
            ب := ب + 1;
        }
        دع الملف: متغير نص = «»;
        دع الوحدة: متغير نص = «»;
        إذا (النقطة == طول_النص(المسار)) {
            الملف := ضم([انسخ_نص(اسم_الحزمة), «.sn»]);
            الوحدة := انسخ_نص(المسار);
        } وإلا {
            دع الأب: نص = شريحة_نص(المسار, 0, النقطة);
            الوحدة := شريحة_نص(المسار, النقطة + 1, طول_النص(المسار));
            // آخر جزء من الأب اسم ملف جذره: text.sub -> text/sub/sub.sn.
            دع بداية_الأخير: متغير طبيعي = 0;
            دع ج: متغير طبيعي = 0;
            طالما (ج < طول_النص(&الأب)) {
                إذا (الأب[ج] == 46) { بداية_الأخير := ج + 1; };
                ج := ج + 1;
            }
            دع الأخير: نص = شريحة_نص(&الأب, بداية_الأخير, طول_النص(&الأب));
            دع المجلد: نص = استبدل_في_النص(&الأب, &«.», &«/»);
            الملف := ضم([المجلد, «/», الأخير, «.sn»]);
        };
        دع التهجئات: متغير متجه نص = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*م).التهجئات) مثل طبيعي)) {
            ألحق(التهجئات, ضم([انسخ_نص(&(*م).التهجئات[ت].اللغة), «: », انسخ_نص(&(*م).التهجئات[ت].التهجئة)]));
            ت := ت + 1;
        }
        دع الفاصل: نص = «, »;
        دع البند: بند_ترحيل = {
            الملف: صل_المسار(جذر_المصدر, &الملف),
            الوحدة: الوحدة,
            التهجئات: صل_النصوص(&التهجئات, &الفاصل)
        };
        ألحق(الناتج, البند);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// المسار للعرض: نسبة إلى دليل المشروع إن أمكن.
عام عرف مسار_للعرض(الدليل: &نص, المسار: &نص): نص {
    طابق مسار_نسبي_من(الدليل, المسار) مع
    | اختياري.موجود(ق) -> { أرجع ق; }
    | اختياري.لا_شيء -> { أرجع انسخ_نص(المسار); };
}

// تحذير [imports-alias]: سطر لكل مدخل، بملفه.
عام عرف أسطر_تحذير_المرادفات(اسم_الحزمة: &نص, الدليل: &نص, جذر_المصدر: &نص, المرادفات: &متجه مرادف_استيراد): متجه نص {
    دع الأسطر: متغير متجه نص = [];
    إذا ((الطول(*المرادفات) مثل طبيعي) == 0) { أرجع الأسطر; };
    ألحق(الأسطر, رسالة(
        «تحذير: لم يعد المترجم يقرأ [imports-alias] في Supax.toml، فلن تعمل هذه التهجئات. شغّل supax migrate لنقلها إلى ملفات الجذر، أو أضف هذه الأسطر بنفسك ثم احذف [imports-alias]:»,
        «warning: the compiler no longer reads [imports-alias] in Supax.toml, so these spellings will not work. Run supax migrate to move them into the root files, or add these lines yourself and delete [imports-alias]:»));
    دع البنود: متجه بند_ترحيل = بنود_الترحيل(اسم_الحزمة, جذر_المصدر, المرادفات);
    دع الكلمة: نص = رسالة(«وحدة», «module»);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البنود) مثل طبيعي)) {
        ألحق(الأسطر, ضم([«  », مسار_للعرض(الدليل, &البنود[ف].الملف), «: », سطر_البند(&البنود[ف], انسخ_نص(&الكلمة))]));
        ف := ف + 1;
    }
    أرجع الأسطر;
}

// هل في النص سطر يعلن هذه الوحدة (بـ«وحدة» أو «module»)؟
عرف معلنة_في(المحتوى: &نص, الوحدة: &نص): منطقي {
    دع الأسطر: متجه نص = أسطر_النص(المحتوى);
    دع الصيغ: متجه نص = [
        ضم([«وحدة », انسخ_نص(الوحدة), « »]), ضم([«module », انسخ_نص(الوحدة), « »]),
        ضم([«وحدة », انسخ_نص(الوحدة), «{»]), ضم([«module », انسخ_نص(الوحدة), «{»])
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        دع م: نص = قص_النص(&الأسطر[ف]);
        دع ص: متغير طبيعي = 0;
        طالما (ص < (الطول(الصيغ) مثل طبيعي)) {
            إذا (يبدأ_بـ(&م, &الصيغ[ص])) { أرجع صواب; };
            ص := ص + 1;
        }
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف آخر_سطر_فارغ(الأسطر: &متجه نص): منطقي {
    دع ع: طبيعي = الطول(*الأسطر) مثل طبيعي;
    إذا (ع == 0) { أرجع خطأ; };
    دع م: نص = قص_النص(&(*الأسطر)[ع - 1]);
    أرجع طول_النص(&م) == 0;
}

// نص البيان بلا القسم [imports-alias] (من ترويسته إلى الترويسة التالية)، وبلا
// الأسطر الفارغة التي قبله.
عام عرف بيان_بلا_مرادفات(النص: &نص): نص {
    دع الأسطر: متجه نص = أسطر_النص(النص);
    دع الناتج: متغير متجه نص = [];
    دع داخل: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        دع م: نص = قص_النص(&الأسطر[ف]);
        دع ترويسة: منطقي = طول_النص(&م) > 0 && م[0] == 91;
        إذا (ترويسة) {
            دع الترويسة: نص = «[imports-alias]»;
            دع كان_داخلا: منطقي = داخل;
            داخل := نصان_متساويان(&م, &الترويسة);
            // سطر فارغ يفصل ما قبل القسم المحذوف عما بعده.
            إذا (كان_داخلا && !داخل && (الطول(الناتج) مثل طبيعي) > 0 && !آخر_سطر_فارغ(&الناتج)) { ألحق(الناتج, «»); };
        };
        إذا (داخل) {
            طالما (آخر_سطر_فارغ(&الناتج)) {
                طابق أزل_عند(&متغير الناتج, (الطول(الناتج) مثل طبيعي) - 1) مع | _ -> { };
            }
        } وإلا {
            ألحق(الناتج, انسخ_نص(&الأسطر[ف]));
        };
        ف := ف + 1;
    }
    دع الفاصل: نص = سطر_جديد();
    أرجع ضم([صل_النصوص(&الناتج, &الفاصل), سطر_جديد()]);
}

// ملف كُتب، ونصه السابق (لا شيء إن لم يكن موجودا) لإعادته عند الفشل.
نوع نسخة_سابقة = { المسار: نص, السابق: اختياري نص };

عرف أعد_الملفات(السوابق: &متجه نسخة_سابقة): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السوابق) مثل طبيعي)) {
        دع س: &نسخة_سابقة = &(*السوابق)[ف];
        طابق انسخ_اختيار_نص(&(*س).السابق) مع
        | اختياري.موجود(ق) -> { طابق اكتب_الملف(&(*س).المسار, &ق) مع | _ -> { }; }
        | اختياري.لا_شيء -> { طابق أزل_ملفا(&(*س).المسار) مع | _ -> { }; };
        ف := ف + 1;
    }
}

// ينقل المرادفات ويرجع الملفات التي تغيرت (مسارات مطلقة). لا يكتب شيئا إن
// لم يكن في البيان [imports-alias].
عام عرف رحّل_المرادفات(البيان: &بيان): نتيجة متجه نص, نص {
    دع المتغيرة: متغير متجه نص = [];
    إذا ((الطول((*البيان).المرادفات) مثل طبيعي) == 0) { أرجع نتيجة.نجح(المتغيرة); };
    دع البنود: متجه بند_ترحيل = بنود_الترحيل(&(*البيان).الاسم, &(*البيان).جذر_المصدر, &(*البيان).المرادفات);
    دع السوابق: متغير متجه نسخة_سابقة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البنود) مثل طبيعي)) {
        دع ب: &بند_ترحيل = &البنود[ف];
        // النص الحالي: ما كُتب في هذا الترحيل، أو ما على القرص.
        دع الحالي: متغير اختياري نص = اختياري.لا_شيء();
        دع سبق: متغير منطقي = خطأ;
        دع س: متغير طبيعي = 0;
        طالما (س < (الطول(المتغيرة) مثل طبيعي)) {
            إذا (نصان_متساويان(&المتغيرة[س], &(*ب).الملف)) { سبق := صواب; };
            س := س + 1;
        }
        طابق اقرأ_الملف(&(*ب).الملف) مع
        | نتيجة.نجح(ن) -> { الحالي := اختياري.موجود(ن); }
        | نتيجة.خطأ(_) -> { };
        إذا (!سبق) {
            دع ن: نسخة_سابقة = { المسار: انسخ_نص(&(*ب).الملف), السابق: انسخ_اختيار_نص(&الحالي) };
            ألحق(السوابق, ن);
        };
        دع المحتوى: متغير نص = «»;
        طابق انسخ_اختيار_نص(&الحالي) مع
        | اختياري.موجود(ن) -> { المحتوى := ن; }
        | اختياري.لا_شيء -> { };
        إذا (!معلنة_في(&المحتوى, &(*ب).الوحدة)) {
            إذا (طول_النص(&المحتوى) > 0 && المحتوى[طول_النص(&المحتوى) - 1] != 10) {
                المحتوى := ضم([المحتوى, سطر_جديد()]);
            };
            المحتوى := ضم([المحتوى, سطر_البند(ب, «وحدة»), سطر_جديد()]);
            طابق اكتب_الملف(&(*ب).الملف, &المحتوى) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(_) -> {
                أعد_الملفات(&السوابق);
                أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة », «cannot write »), انسخ_نص(&(*ب).الملف), رسالة(«؛ لم يتغير شيء», «; nothing was changed»)]));
            };
            إذا (!سبق) { ألحق(المتغيرة, انسخ_نص(&(*ب).الملف)); };
        };
        ف := ف + 1;
    }
    // ثم البيان.
    دع النص: نص;
    طابق اقرأ_الملف(&(*البيان).المسار) مع
    | نتيجة.نجح(ن) -> { النص := ن; }
    | نتيجة.خطأ(_) -> {
        أعد_الملفات(&السوابق);
        أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة », «cannot read »), انسخ_نص(&(*البيان).المسار)]));
    };
    دع الجديد: نص = بيان_بلا_مرادفات(&النص);
    طابق اكتب_الملف(&(*البيان).المسار, &الجديد) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> {
        أعد_الملفات(&السوابق);
        أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة », «cannot write »), انسخ_نص(&(*البيان).المسار), رسالة(«؛ لم يتغير شيء», «; nothing was changed»)]));
    };
    ألحق(المتغيرة, انسخ_نص(&(*البيان).المسار));
    أرجع نتيجة.نجح(المتغيرة);
}
