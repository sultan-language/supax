// supax add و supax remove: تعديل جدول [dependencies] في Supax.toml نصيا،
// فتبقى التعليقات والترتيب كما كتبها المستخدم. يُكتب مفتاح الاعتمادية بين
// علامتي تنصيص إن لم يكن من A-Z a-z 0-9 _ -.
استورد المكتبة.ملفات.path;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.ملفات.write_file;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.transform;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.support.names;
استورد سوباكس.manifest.manifest;

// أسطر النص، بلا محارف السطر الجديد.
عرف أسطر(النص: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == 10) {
            دع النهاية: متغير طبيعي = ف;
            إذا (النهاية > البداية && (*النص)[النهاية - 1] == 13) { النهاية := النهاية - 1; };
            ألحق(الناتج, شريحة_نص(النص, البداية, النهاية));
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    إذا (البداية < طول_النص(النص)) { ألحق(الناتج, شريحة_نص(النص, البداية, طول_النص(النص))); };
    أرجع الناتج;
}

عرف مقصوص(السطر: &نص): نص {
    أرجع قص_النص(السطر);
}

// مفتاح TOML لاسم الاعتمادية.
عام عرف مفتاح_الاعتمادية(الاسم: &نص): نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(الاسم)) {
        دع ب: ط8 = (*الاسم)[ف];
        دع مجرد: منطقي = (ب >= 65 && ب <= 90) || (ب >= 97 && ب <= 122) || (ب >= 48 && ب <= 57) || ب == 95 || ب == 45;
        إذا (!مجرد) { أرجع نص_تومل(الاسم); };
        ف := ف + 1;
    }
    أرجع انسخ_نص(الاسم);
}

// هل يبدأ السطر بتعريف هذا المفتاح (مجردا أو مقتبسا) يليه «=»؟
عرف سطر_المفتاح(السطر: &نص, الاسم: &نص): منطقي {
    دع الصيغ: متجه نص = [انسخ_نص(الاسم), نص_تومل(الاسم), ضم([«'», انسخ_نص(الاسم), «'»])];
    دع المقصوص: نص = مقصوص(السطر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الصيغ) مثل طبيعي)) {
        دع ص: &نص = &الصيغ[ف];
        إذا (طول_النص(&المقصوص) > طول_النص(ص) && نصان_متساويان(&شريحة_نص(&المقصوص, 0, طول_النص(ص)), ص)) {
            دع ب: متغير طبيعي = طول_النص(ص);
            طالما (ب < طول_النص(&المقصوص) && (المقصوص[ب] == 32 || المقصوص[ب] == 9)) { ب := ب + 1; }
            إذا (ب < طول_النص(&المقصوص) && المقصوص[ب] == 61) { أرجع صواب; };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف سطر_ترويسة(السطر: &نص): منطقي {
    دع م: نص = مقصوص(السطر);
    أرجع طول_النص(&م) > 0 && م[0] == 91;
}

// موضع جدول [dependencies] في الأسطر: [البداية، النهاية)، أو لا شيء.
نوع قسم = { الترويسة: طبيعي, النهاية: طبيعي };

عرف قسم_الاعتماديات(الأسطر: &متجه نص): اختياري قسم {
    دع العدد: طبيعي = الطول(*الأسطر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع م: نص = مقصوص(&(*الأسطر)[ف]);
        إذا (إذا_يساوي_نصا(&م, «[dependencies]»)) {
            دع ن: متغير طبيعي = ف + 1;
            طالما (ن < العدد && !سطر_ترويسة(&(*الأسطر)[ن])) { ن := ن + 1; }
            دع ق: قسم = { الترويسة: ف, النهاية: ن };
            أرجع اختياري.موجود(ق);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// هل عُرّفت الاعتمادية بجدول مستقل [dependencies.<الاسم>]؟
عرف جدول_مستقل(الأسطر: &متجه نص, الاسم: &نص): منطقي {
    دع الصيغ: متجه نص = [
        ضم([«[dependencies.», انسخ_نص(الاسم), «]»]),
        ضم([«[dependencies.», نص_تومل(الاسم), «]»])
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        دع م: نص = مقصوص(&(*الأسطر)[ف]);
        إذا (نصان_متساويان(&م, &الصيغ[0]) || نصان_متساويان(&م, &الصيغ[1])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف صل_الأسطر(الأسطر: &متجه نص): نص {
    دع الفاصل: نص = سطر_جديد();
    أرجع ضم([صل_النصوص(الأسطر, &الفاصل), سطر_جديد()]);
}

عرف إذا_يساوي_نصا(أ: &نص, ب: نص): منطقي {
    دع ث: نص = ب;
    أرجع نصان_متساويان(أ, &ث);
}

// نص البيان بعد إضافة سطر الاعتمادية أو استبداله.
عام عرف أضف_إلى_البيان(النص: &نص, الاسم: &نص, سطر_القيمة: &نص): نتيجة نص, نص {
    دع الأسطر: متغير متجه نص = أسطر(النص);
    إذا (جدول_مستقل(&الأسطر, الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم),
            رسالة(«" معرّفة بجدول [dependencies.…] مستقل؛ عدّلها يدويا», «" is defined as its own [dependencies.…] table; edit it by hand»)]));
    };
    دع السطر: نص = ضم([مفتاح_الاعتمادية(الاسم), « = », انسخ_نص(سطر_القيمة)]);
    طابق قسم_الاعتماديات(&الأسطر) مع
    | اختياري.لا_شيء -> {
        دع الجديد: متغير متجه نص = استنسخ(&الأسطر);
        إذا ((الطول(الجديد) مثل طبيعي) > 0 && طول_النص(&مقصوص(&الجديد[(الطول(الجديد) مثل طبيعي) - 1])) > 0) {
            ألحق(الجديد, «»);
        };
        ألحق(الجديد, «[dependencies]»);
        ألحق(الجديد, السطر);
        أرجع نتيجة.نجح(صل_الأسطر(&الجديد));
    }
    | اختياري.موجود(ق) -> {
        // استبدال سطر موجود.
        دع ف: متغير طبيعي = ق.الترويسة + 1;
        طالما (ف < ق.النهاية) {
            إذا (سطر_المفتاح(&الأسطر[ف], الاسم)) {
                الأسطر[ف] := السطر;
                أرجع نتيجة.نجح(صل_الأسطر(&الأسطر));
            };
            ف := ف + 1;
        }
        // إضافة بعد آخر سطر غير فارغ في القسم.
        دع الموضع: متغير طبيعي = ق.النهاية;
        طالما (الموضع > ق.الترويسة + 1 && طول_النص(&مقصوص(&الأسطر[الموضع - 1])) == 0) { الموضع := الموضع - 1; }
        دع الجديد: متغير متجه نص = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الأسطر) مثل طبيعي)) {
            إذا (ح == الموضع) { ألحق(الجديد, انسخ_نص(&السطر)); };
            ألحق(الجديد, انسخ_نص(&الأسطر[ح]));
            ح := ح + 1;
        }
        إذا (الموضع == (الطول(الأسطر) مثل طبيعي)) { ألحق(الجديد, انسخ_نص(&السطر)); };
        أرجع نتيجة.نجح(صل_الأسطر(&الجديد));
    };
}

// نص البيان بعد حذف سطر الاعتمادية.
عام عرف احذف_من_البيان(النص: &نص, الاسم: &نص): نتيجة نص, نص {
    دع الأسطر: متجه نص = أسطر(النص);
    إذا (جدول_مستقل(&الأسطر, الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم),
            رسالة(«" معرّفة بجدول [dependencies.…] مستقل؛ احذفها يدويا», «" is defined as its own [dependencies.…] table; remove it by hand»)]));
    };
    طابق قسم_الاعتماديات(&الأسطر) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(ق) -> {
        دع ف: متغير طبيعي = ق.الترويسة + 1;
        طالما (ف < ق.النهاية) {
            إذا (سطر_المفتاح(&الأسطر[ف], الاسم)) {
                دع الجديد: متغير متجه نص = [];
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الأسطر) مثل طبيعي)) {
                    إذا (ح != ف) { ألحق(الجديد, انسخ_نص(&الأسطر[ح])); };
                    ح := ح + 1;
                }
                أرجع نتيجة.نجح(صل_الأسطر(&الجديد));
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.خطأ(ضم([رسالة(«لا توجد اعتمادية باسم "», «no dependency named "»), انسخ_نص(الاسم), «"»]));
}
