// supax add و supax remove: تعديل جدول [dependencies] (أو [dev-dependencies] مع --dev) في Supax.toml نصيا،
// فتبقى التعليقات والترتيب كما كتبها المستخدم. يُكتب مفتاح الاعتمادية بين
// علامتي تنصيص إن لم يكن من A-Z a-z 0-9 _ -.
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.support.names;
استورد سوباكس.manifest.manifest;

// أسطر النص، بلا محارف السطر الجديد.
عرف أسطر(النص: &نص): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن البداية: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == 10) {
            ليكن النهاية: متغير طبيعي = ف;
            إذا (النهاية > البداية && (*النص)[النهاية - 1] == 13) { النهاية := النهاية - 1; };
            ألحق(الناتج، شريحة_نص(النص، البداية، النهاية));
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    إذا (البداية < طول_النص(النص)) { ألحق(الناتج، شريحة_نص(النص، البداية، طول_النص(النص))); };
    أرجع الناتج;
}

عرف مقصوص(السطر: &نص): نص {
    أرجع قص_النص(السطر);
}

// مفتاح TOML لاسم الاعتمادية.
عام عرف مفتاح_الاعتمادية(الاسم: &نص): نص {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(الاسم)) {
        ليكن ب: ط8 = (*الاسم)[ف];
        ليكن مجرد: منطقي = (ب >= 65 && ب <= 90) || (ب >= 97 && ب <= 122) || (ب >= 48 && ب <= 57) || ب == 95 || ب == 45;
        إذا (!مجرد) { أرجع نص_تومل(الاسم); };
        ف := ف + 1;
    }
    أرجع انسخ_نص(الاسم);
}

// هل يبدأ السطر بتعريف هذا المفتاح (مجردا أو مقتبسا) يليه «=»؟
عرف سطر_المفتاح(السطر: &نص، الاسم: &نص): منطقي {
    ليكن الصيغ: متجه نص = [انسخ_نص(الاسم)، نص_تومل(الاسم)، ضم([«'»، انسخ_نص(الاسم)، «'»])];
    ليكن المقصوص: نص = مقصوص(السطر);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الصيغ) مثل طبيعي)) {
        ليكن ص: &نص = &الصيغ[ف];
        إذا (طول_النص(&المقصوص) > طول_النص(ص) && نصان_متساويان(&شريحة_نص(&المقصوص، 0، طول_النص(ص))، ص)) {
            ليكن ب: متغير طبيعي = طول_النص(ص);
            طالما (ب < طول_النص(&المقصوص) && (المقصوص[ب] == 32 || المقصوص[ب] == 9)) { ب := ب + 1; }
            إذا (ب < طول_النص(&المقصوص) && المقصوص[ب] == 61) { أرجع صواب; };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف سطر_ترويسة(السطر: &نص): منطقي {
    ليكن م: نص = مقصوص(السطر);
    أرجع طول_النص(&م) > 0 && م[0] == 91;
}

// موضع الجدول (dependencies أو dev-dependencies) في الأسطر: [البداية، النهاية)، أو لا شيء.
نوع قسم = { الترويسة: طبيعي، النهاية: طبيعي };

عرف قسم_الاعتماديات(الأسطر: &متجه نص، الجدول: &نص): اختياري قسم {
    ليكن الترويسة: نص = ضم([«[»، انسخ_نص(الجدول)، «]»]);
    ليكن العدد: طبيعي = الطول(*الأسطر) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن م: نص = مقصوص(&(*الأسطر)[ف]);
        إذا (نصان_متساويان(&م، &الترويسة)) {
            ليكن ن: متغير طبيعي = ف + 1;
            طالما (ن < العدد && !سطر_ترويسة(&(*الأسطر)[ن])) { ن := ن + 1; }
            ليكن ق: قسم = { الترويسة: ف، النهاية: ن };
            أرجع اختياري.موجود(ق);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// هل عُرّفت الاعتمادية بجدول مستقل [<الجدول>.<الاسم>]؟
عرف جدول_مستقل(الأسطر: &متجه نص، الاسم: &نص، الجدول: &نص): منطقي {
    ليكن الصيغ: متجه نص = [
        ضم([«[»، انسخ_نص(الجدول)، «.»، انسخ_نص(الاسم)، «]»])،
        ضم([«[»، انسخ_نص(الجدول)، «.»، نص_تومل(الاسم)، «]»])
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        ليكن م: نص = مقصوص(&(*الأسطر)[ف]);
        إذا (نصان_متساويان(&م، &الصيغ[0]) || نصان_متساويان(&م، &الصيغ[1])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف صل_الأسطر(الأسطر: &متجه نص): نص {
    ليكن الفاصل: نص = سطر_جديد();
    أرجع ضم([صل_النصوص(الأسطر، &الفاصل)، سطر_جديد()]);
}

عرف إذا_يساوي_نصا(أ: &نص، ب: نص): منطقي {
    ليكن ث: نص = ب;
    أرجع نصان_متساويان(أ، &ث);
}

// نص البيان بعد إضافة سطر الاعتمادية أو استبداله.
عام عرف أضف_إلى_البيان(النص: &نص، الاسم: &نص، سطر_القيمة: &نص، الجدول: &نص): نتيجة نص، نص {
    ليكن الأسطر: متغير متجه نص = أسطر(النص);
    إذا (جدول_مستقل(&الأسطر، الاسم، الجدول)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(الاسم)،
            رسالة(«" معرّفة بجدول [»، «" is defined as its own [»)، انسخ_نص(الجدول)،
            رسالة(«.…] مستقل؛ عدّلها يدويا»، «.…] table; edit it by hand»)]));
    };
    ليكن السطر: نص = ضم([مفتاح_الاعتمادية(الاسم)، « = »، انسخ_نص(سطر_القيمة)]);
    طابق قسم_الاعتماديات(&الأسطر، الجدول) مع
    | اختياري.لا_شيء -> {
        ليكن الجديد: متغير متجه نص = استنسخ(&الأسطر);
        إذا ((الطول(الجديد) مثل طبيعي) > 0 && طول_النص(&مقصوص(&الجديد[(الطول(الجديد) مثل طبيعي) - 1])) > 0) {
            ألحق(الجديد، «»);
        };
        ألحق(الجديد، ضم([«[»، انسخ_نص(الجدول)، «]»]));
        ألحق(الجديد، السطر);
        أرجع نتيجة.نجح(صل_الأسطر(&الجديد));
    }
    | اختياري.موجود(ق) -> {
        // استبدال سطر موجود.
        ليكن ف: متغير طبيعي = ق.الترويسة + 1;
        طالما (ف < ق.النهاية) {
            إذا (سطر_المفتاح(&الأسطر[ف]، الاسم)) {
                الأسطر[ف] := السطر;
                أرجع نتيجة.نجح(صل_الأسطر(&الأسطر));
            };
            ف := ف + 1;
        }
        // إضافة بعد آخر سطر غير فارغ في القسم.
        ليكن الموضع: متغير طبيعي = ق.النهاية;
        طالما (الموضع > ق.الترويسة + 1 && طول_النص(&مقصوص(&الأسطر[الموضع - 1])) == 0) { الموضع := الموضع - 1; }
        ليكن الجديد: متغير متجه نص = [];
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الأسطر) مثل طبيعي)) {
            إذا (ح == الموضع) { ألحق(الجديد، انسخ_نص(&السطر)); };
            ألحق(الجديد، انسخ_نص(&الأسطر[ح]));
            ح := ح + 1;
        }
        إذا (الموضع == (الطول(الأسطر) مثل طبيعي)) { ألحق(الجديد، انسخ_نص(&السطر)); };
        أرجع نتيجة.نجح(صل_الأسطر(&الجديد));
    };
}

// نص البيان بعد حذف سطر الاعتمادية.
عام عرف احذف_من_البيان(النص: &نص، الاسم: &نص، الجدول: &نص): نتيجة نص، نص {
    ليكن الأسطر: متجه نص = أسطر(النص);
    إذا (جدول_مستقل(&الأسطر، الاسم، الجدول)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(الاسم)،
            رسالة(«" معرّفة بجدول [»، «" is defined as its own [»)، انسخ_نص(الجدول)،
            رسالة(«.…] مستقل؛ احذفها يدويا»، «.…] table; remove it by hand»)]));
    };
    طابق قسم_الاعتماديات(&الأسطر، الجدول) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(ق) -> {
        ليكن ف: متغير طبيعي = ق.الترويسة + 1;
        طالما (ف < ق.النهاية) {
            إذا (سطر_المفتاح(&الأسطر[ف]، الاسم)) {
                ليكن الجديد: متغير متجه نص = [];
                ليكن ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الأسطر) مثل طبيعي)) {
                    إذا (ح != ف) { ألحق(الجديد، انسخ_نص(&الأسطر[ح])); };
                    ح := ح + 1;
                }
                أرجع نتيجة.نجح(صل_الأسطر(&الجديد));
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.خطأ(ضم([رسالة(«لا توجد اعتمادية باسم "»، «no dependency named "»)، انسخ_نص(الاسم)، رسالة(«" في [»، «" in [»)، انسخ_نص(الجدول)، «]»]));
}
