// إنشاء حزمة جديدة: supax new <الاسم> في دليل جديد، و supax init في الدليل الحالي.
// القالب بلغة رسائل سوباكس: الكلمات المفتاحية العربية افتراضيا، والإنجليزية مع --lang=en.
استورد المكتبة.بيئة.environment;
استورد المكتبة.ملفات.path;
استورد المكتبة.ملفات.directory;
استورد المكتبة.ملفات.walk;
استورد المكتبة.ملفات.write_file;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.ملفات.canonical;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.search;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.support.names;
استورد سوباكس.manifest.manifest;

عرف نص_البيان(الاسم: &نص): نص {
    أرجع ضم([
        «[package]», سطر_جديد(),
        «name = », نص_تومل(الاسم), سطر_جديد(),
        «version = "0.1.0"», سطر_جديد(),
        سطر_جديد(),
        «[dependencies]», سطر_جديد()
    ]);
}

عرف نص_البداية(): نص {
    إذا (بالإنجليزية()) {
        أرجع ضم([
            «import std.io.println;», سطر_جديد(), سطر_جديد(),
            «def main(): int {», سطر_جديد(),
            «    println("Hello from SultanC");», سطر_جديد(),
            «    return 0;», سطر_جديد(),
            «}», سطر_جديد()
        ]);
    };
    أرجع ضم([
        «استورد المكتبة.دخ.println;», سطر_جديد(), سطر_جديد(),
        «عرف الرئيسية(): عدد {», سطر_جديد(),
        «    اطبع_سطر("مرحبا من السلطان");», سطر_جديد(),
        «    أرجع 0;», سطر_جديد(),
        «}», سطر_جديد()
    ]);
}

عرف موجود_المسار(المسار: &نص): منطقي {
    طابق حاول_وجود_المسار(المسار) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف اكتب_جديدا(المسار: &نص, المحتوى: &نص): نتيجة نص, نص {
    طابق اكتب_الملف(المسار, المحتوى) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(«»); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة », «cannot write »), انسخ_نص(المسار)])); };
}

// يضيف build/ إلى .gitignore إن لم يكن فيه.
عرف جهز_التجاهل(الدليل: &نص): نتيجة نص, نص {
    دع المسار: نص = صل_المسار(الدليل, &«.gitignore»);
    دع السطر: نص = «build/»;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(الحالي) -> {
        إذا (يحتوي_نصا(&الحالي, &السطر)) { أرجع نتيجة.نجح(«»); };
        دع الفاصل: متغير نص = «»;
        إذا (طول_النص(&الحالي) > 0 && الحالي[طول_النص(&الحالي) - 1] != 10) { الفاصل := سطر_جديد(); };
        دع الجديد: نص = ضم([الحالي, الفاصل, السطر, سطر_جديد()]);
        أرجع اكتب_جديدا(&المسار, &الجديد);
    }
    | نتيجة.خطأ(_) -> {
        دع الجديد: نص = ضم([السطر, سطر_جديد()]);
        أرجع اكتب_جديدا(&المسار, &الجديد);
    };
}

// ينشئ ملفات الحزمة في دليل موجود. الاسم: اسم الحزمة.
عام عرف هيئ_حزمة(الدليل: &نص, الاسم: &نص): نتيجة نص, نص {
    إذا (!معرف_صالح(الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«اسم الحزمة "», «package name "»), انسخ_نص(الاسم),
            رسالة(«" غير صالح؛ مرر اسما آخر: supax init <الاسم>», «" is not valid; pass another name: supax init <name>»)]));
    };
    دع اسم_ب: نص = اسم_البيان();
    دع اسم_ب_بناء: نص = اسم_بيان_البناء();
    إذا (ملف_باسم_دقيق(الدليل, &اسم_ب)) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(الدليل), رسالة(«: فيه Supax.toml من قبل», «: already has a Supax.toml»)]));
    };
    إذا (ملف_باسم_دقيق(الدليل, &اسم_ب_بناء)) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(الدليل), رسالة(«: فيه supax.toml (بيان بناء)؛ لن يُنشأ Supax.toml بجانبه»,
            «: has supax.toml (a build manifest); Supax.toml will not be created next to it»)]));
    };
    دع src: نص = صل_المسار(الدليل, &«src»);
    طابق أنشئ_مسار_الدليل(&src) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء », «cannot create »), src])); }
    | نتيجة.نجح(_) -> { };
    دع البداية: نص = صل_المسار(&src, &«main.sn»);
    إذا (!موجود_المسار(&البداية)) {
        اكتب_جديدا(&البداية, &نص_البداية())؟;
    };
    دع البيان: نص = صل_المسار(الدليل, &اسم_ب);
    اكتب_جديدا(&البيان, &نص_البيان(الاسم))؟;
    جهز_التجاهل(الدليل)؟;
    أرجع نتيجة.نجح(ضم([رسالة(«أُنشئت الحزمة "», «created package "»), انسخ_نص(الاسم), «"»]));
}

// supax new <الاسم>: دليل جديد باسم الحزمة.
عام عرف حزمة_جديدة(الاسم: &نص): نتيجة نص, نص {
    إذا (طول_النص(الاسم) == 0) {
        أرجع نتيجة.خطأ(رسالة(«الاستخدام: supax new <الاسم>», «usage: supax new <name>»));
    };
    دع العمل: نص;
    طابق دليل_العمل() مع
    | نتيجة.نجح(د) -> { العمل := د; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذرت معرفة دليل العمل», «cannot determine the working directory»)); };
    دع الدليل: نص = صل_المسار(&العمل, الاسم);
    إذا (موجود_المسار(&الدليل)) {
        أرجع نتيجة.خطأ(ضم([الدليل, رسالة(«: موجود من قبل», «: already exists»)]));
    };
    إذا (!معرف_صالح(الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«اسم الحزمة "», «package name "»), انسخ_نص(الاسم), رسالة(«" غير صالح», «" is not valid»)]));
    };
    طابق أنشئ_مسار_الدليل(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء », «cannot create »), الدليل])); }
    | نتيجة.نجح(_) -> { };
    أرجع هيئ_حزمة(&الدليل, الاسم);
}

// supax init [الاسم]: الدليل الحالي؛ الاسم الافتراضي اسم الدليل.
عام عرف هيئ_الدليل_الحالي(الاسم: &نص): نتيجة نص, نص {
    دع العمل: نص;
    طابق دليل_العمل() مع
    | نتيجة.نجح(د) -> { العمل := د; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذرت معرفة دليل العمل», «cannot determine the working directory»)); };
    دع اسم_الحزمة: متغير نص = انسخ_نص(الاسم);
    إذا (طول_النص(&اسم_الحزمة) == 0) {
        طابق اسم_الملف(&العمل) مع
        | اختياري.موجود(ق) -> { اسم_الحزمة := ق; }
        | اختياري.لا_شيء -> { };
    };
    أرجع هيئ_حزمة(&العمل, &اسم_الحزمة);
}
