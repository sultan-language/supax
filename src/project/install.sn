// supax install و supax uninstall: برامج حزمة في $SUPAX_HOME/bin، كما يفعل
// cargo install في ~/.cargo/bin. المصدر واحد من ثلاثة:
//   --path <دليل>            حزمة محلية، تُبنى في مكانها
//   --git <رابط> [<الاسم>]    نسخة git، تُنسخ من المخبأ إلى دليل مؤقت وتُبنى فيه
//   <الاسم>[@<متطلب>]         حزمة من الفهرس، كذلك
// تُحل حزمتا git والفهرس بالمحلل نفسه (بلا اشتراط [lib])، فيُتحقق من بصمتها
// كأي اعتمادية. وتُسجَّل البرامج المثبتة في $SUPAX_HOME/installed.toml، ومنه
// يعرف uninstall ما يحذفه، ولا يُستبدل ملف لم يثبته سوباكس إلا مع --force.
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.مجموعات.متجهات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.عمليات.الوسائط;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.اخرج;
استورد المكتبة.تومل.محلل;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.أذونات;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.support.home;
استورد سوباكس.support.names;
استورد سوباكس.support.status;
استورد سوباكس.manifest.toml;
استورد سوباكس.manifest.manifest;
استورد سوباكس.source.git;
استورد سوباكس.cache.store;
استورد سوباكس.resolve.model;
استورد سوباكس.resolve.lockfile;
استورد سوباكس.resolve.resolver;
استورد سوباكس.cli.args;
استورد سوباكس.cli.project;
استورد سوباكس.build.compiler;

// ---------------------------------------------------------------------
// السجل: $SUPAX_HOME/installed.toml

// برنامج مثبت. المصدر: path أو git أو registry؛ من: الدليل أو رابط git أو رابط الفهرس.
عام نوع برنامج_مثبت = { الاسم: نص، الملف: نص، الحزمة: نص، الإصدار: نص، المصدر: نص، الأصل: نص، الالتزام: نص };

عرف ملف_السجل(): نتيجة نص، نص {
    ليكن البيت: نص = بيت_سوباكس()؟;
    أرجع نتيجة.نجح(صل_المسار(&البيت، &«installed.toml»));
}

عام عرف دليل_البرامج(): نتيجة نص، نص {
    ليكن البيت: نص = بيت_سوباكس()؟;
    أرجع نتيجة.نجح(صل_المسار(&البيت، &«bin»));
}

عرف نص_أو_فارغ_سجل(ق: اختياري نص): نص {
    طابق ق مع
    | اختياري.موجود(ن) -> { أرجع ن; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عام عرف اقرأ_السجل(): نتيجة متجه برنامج_مثبت، نص {
    ليكن المسار: نص = ملف_السجل()؟;
    ليكن الناتج: متغير متجه برنامج_مثبت = [];
    إذا (!ملف_موجود(&المسار)) { أرجع نتيجة.نجح(الناتج); };
    ليكن الملف: ملف_تومل = اقرأ_ملف_تومل(&المسار)؟;
    ليكن الوثيقة: &وثيقة_تومل = &الملف.الوثيقة;
    ليكن الجذر: طبيعي = الملف.الوثيقة.الجذر;
    ليكن المفتاح: نص = «program»;
    طابق قيمة_مفتاح_تومل(الوثيقة، الجذر، &المفتاح) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        ليكن المصفوفة: طبيعي;
        طابق قيمة_مصفوفة(&القيمة) مع
        | اختياري.موجود(م) -> { المصفوفة := م; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([المسار، رسالة(«: [[program]] يجب أن يكون مصفوفة جداول»، «: [[program]] must be an array of tables»)])); };
        ليكن القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة، المصفوفة);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            طابق قيمة_جدول(&القيم[ف]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ج) -> {
                ليكن ب: برنامج_مثبت = {
                    الاسم: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «name»))،
                    الملف: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «file»))،
                    الحزمة: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «package»))،
                    الإصدار: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «version»))،
                    المصدر: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «source»))،
                    الأصل: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «from»))،
                    الالتزام: نص_أو_فارغ_سجل(نص_في_جدول(الوثيقة، ج، «commit»))
                };
                ألحق(الناتج، ب);
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف سطر_سجل(المفتاح: نص، القيمة: &نص): نص {
    أرجع ضم([انسخ_نص(&المفتاح)، « = »، نص_تومل(القيمة)، سطر_جديد()]);
}

عام عرف اكتب_السجل(البرامج: &متجه برنامج_مثبت): نتيجة نص، نص {
    ليكن المسار: نص = ملف_السجل()؟;
    ليكن الأجزاء: متغير متجه نص = [
        «# البرامج التي ثبّتها supax install؛ يكتبه سوباكس. Programs installed by supax install, written by Supax.»، سطر_جديد()،
        «version = 1»، سطر_جديد()
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البرامج) مثل طبيعي)) {
        ليكن ب: &برنامج_مثبت = &(*البرامج)[ف];
        ألحق(الأجزاء، سطر_جديد());
        ألحق(الأجزاء، «[[program]]»);
        ألحق(الأجزاء، سطر_جديد());
        ألحق(الأجزاء، سطر_سجل(«name»، &(*ب).الاسم));
        ألحق(الأجزاء، سطر_سجل(«file»، &(*ب).الملف));
        ألحق(الأجزاء، سطر_سجل(«package»، &(*ب).الحزمة));
        ألحق(الأجزاء، سطر_سجل(«version»، &(*ب).الإصدار));
        ألحق(الأجزاء، سطر_سجل(«source»، &(*ب).المصدر));
        ألحق(الأجزاء، سطر_سجل(«from»، &(*ب).الأصل));
        إذا (طول_النص(&(*ب).الالتزام) > 0) { ألحق(الأجزاء، سطر_سجل(«commit»، &(*ب).الالتزام)); };
        ف := ف + 1;
    }
    ليكن النص: نص = ضم(الأجزاء);
    اكتب_إن_تغير(&المسار، &النص)؟;
    أرجع نتيجة.نجح(«»);
}

// ---------------------------------------------------------------------
// المصدر

// الدليل: دليل الحزمة التي تُبنى. المؤقت: دليل يُحذف بعد التثبيت («» لـ --path).
// الأصل: الدليل أو رابط git أو رابط الفهرس (from في السجل).
عام نوع مصدر_تثبيت = { الدليل: نص، المؤقت: نص، المصدر: نص، الأصل: نص، الالتزام: نص };

// اسم الحزمة من آخر جزء في رابط git، بلا .git: https://x/y/tool.git ← tool.
عرف اسم_من_رابط(الرابط: &نص): نص {
    ليكن النهاية: متغير طبيعي = طول_النص(الرابط);
    طالما (النهاية > 0 && ((*الرابط)[النهاية - 1] == 47)) { النهاية := النهاية - 1; }
    ليكن البداية: متغير طبيعي = النهاية;
    طالما (البداية > 0 && (*الرابط)[البداية - 1] != 47 && (*الرابط)[البداية - 1] != 58) { البداية := البداية - 1; }
    ليكن الجزء: نص = شريحة_نص(الرابط، البداية، النهاية);
    إذا (ينتهي_بـ(&الجزء، &«.git»)) { أرجع شريحة_نص(&الجزء، 0، طول_النص(&الجزء) - 4); };
    أرجع الجزء;
}

عرف خيارات_التثبيت(الطلب: &طلب): خيارات_الحل {
    ليكن فارغة: متجه نص = [];
    ليكن خ: خيارات_الحل = { بلا_شبكة: (*الطلب).الخيارات.بلا_شبكة، مقفول: خطأ، تحديث_الكل: خطأ، تحديث: فارغة، للتثبيت: صواب };
    أرجع خ;
}

عام عرف جهز_مصدر_التثبيت(الطلب: &طلب): نتيجة مصدر_تثبيت، نص {
    ليكن المسار: نص = قيمة_الخيار(الطلب، «path»);
    ليكن الجت: نص = قيمة_الخيار(الطلب، «git»);
    ليكن عدد_المسماة: طبيعي = الطول((*الطلب).المسماة) مثل طبيعي;
    إذا (طول_النص(&المسار) > 0 && طول_النص(&الجت) > 0) {
        أرجع نتيجة.خطأ(رسالة(«حدد مصدرا واحدا: الفهرس (الاسم@الإصدار)، أو --path <دليل>، أو --git <رابط>»،
            «give exactly one source: the index (name@version), --path <dir> or --git <url>»));
    };
    إذا (طول_النص(&المسار) > 0) {
        إذا (عدد_المسماة > 0) {
            أرجع نتيجة.خطأ(رسالة(«مع --path لا يُذكر اسم: الحزمة هي ما في الدليل»، «no name with --path: the package is the one in the directory»));
        };
        ليكن الدليل: نص = قانوني(&المسار)؟;
        ليكن اسم_ب: نص = اسم_البيان();
        إذا (!ملف_باسم_دقيق(&الدليل، &اسم_ب)) {
            أرجع نتيجة.خطأ(ضم([الدليل، رسالة(«: لا يوجد Supax.toml»، «: no Supax.toml»)]));
        };
        ليكن م: مصدر_تثبيت = { الدليل: انسخ_نص(&الدليل)، المؤقت: «»، المصدر: «path»، الأصل: الدليل، الالتزام: «» };
        أرجع نتيجة.نجح(م);
    };
    إذا (طول_النص(&الجت) == 0 && عدد_المسماة != 1) {
        أرجع نتيجة.خطأ(رسالة(«الاستخدام: supax install <الاسم>[@<متطلب>] | --path <دليل> | --git <رابط> [<الاسم>] [--tag <وسم>]»،
            «usage: supax install <name>[@<requirement>] | --path <dir> | --git <url> [<name>] [--tag <tag>]»));
    };
    // الاسم والقيمة كما يكتبهما supax add في [dependencies].
    ليكن الاسم: متغير نص = «»;
    ليكن القيمة: متغير نص = «»;
    إذا (طول_النص(&الجت) > 0) {
        إذا (عدد_المسماة > 1) {
            أرجع نتيجة.خطأ(رسالة(«مع --git يُذكر اسم واحد على الأكثر»، «with --git, give at most one name»));
        };
        إذا (عدد_المسماة == 1) { الاسم := انسخ_نص(&(*الطلب).المسماة[0]); } وإلا { الاسم := اسم_من_رابط(&الجت); };
        ليكن الأجزاء: متغير متجه نص = [«{ git = »، نص_تومل(&الجت)];
        ليكن المراجع: متجه نص = [«tag»، «branch»، «rev»];
        ليكن العدد: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < 3) {
            ليكن ق: نص = قيمة_الخيار(الطلب، انسخ_نص(&المراجع[ف]));
            إذا (طول_النص(&ق) > 0) {
                ألحق(الأجزاء، ضم([«, »، انسخ_نص(&المراجع[ف])، « = »، نص_تومل(&ق)]));
                العدد := العدد + 1;
            };
            ف := ف + 1;
        }
        إذا (العدد > 1) {
            أرجع نتيجة.خطأ(رسالة(«حدد واحدا فقط من --tag و --branch و --rev»، «give only one of --tag, --branch and --rev»));
        };
        ألحق(الأجزاء، « }»);
        القيمة := ضم(الأجزاء);
    } وإلا {
        ليكن الكامل: نص = انسخ_نص(&(*الطلب).المسماة[0]);
        ليكن آت: طبيعي = موضع_بايت(&الكامل، 64، 0);
        الاسم := شريحة_نص(&الكامل، 0، آت);
        ليكن المتطلب: متغير نص = «*»;
        إذا (آت < طول_النص(&الكامل)) { المتطلب := شريحة_نص(&الكامل، آت + 1، طول_النص(&الكامل)); };
        القيمة := نص_تومل(&المتطلب);
    };
    إذا (!معرف_صالح(&الاسم)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«اسم الحزمة "»، «package name "»)، انسخ_نص(&الاسم)،
            رسالة(«" ليس معرفا صالحا؛ مرر الاسم: supax install --git <رابط> <الاسم>»، «" is not a valid identifier; pass the name: supax install --git <url> <name>»)]));
    };
    // حزمة جذر مؤقتة تعتمد على المطلوب؛ يحلها المحلل ويجلبها ويتحقق منها.
    ليكن البيت: نص = بيت_سوباكس()؟;
    ليكن tmp: نص = صل_المسار(&البيت، &«tmp»);
    طابق أنشئ_مسار_الدليل(&tmp) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء »، «cannot create »)، tmp])); }
    | نتيجة.نجح(_) -> { };
    ليكن المؤقت: نص;
    طابق أنشئ_دليلا_مؤقتا_في(&tmp، &«install-») مع
    | نتيجة.نجح(د) -> { المؤقت := د; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء دليل مؤقت في »، «cannot create a temporary directory in »)، tmp])); };
    طابق جهز_من_المخبأ(الطلب، &المؤقت، &الاسم، &القيمة) مع
    | نتيجة.نجح(م) -> { أرجع نتيجة.نجح(م); }
    | نتيجة.خطأ(السبب) -> { احذف_شجرة(&المؤقت); أرجع نتيجة.خطأ(السبب); };
}

عرف جهز_من_المخبأ(الطلب: &طلب، المؤقت: &نص، الاسم: &نص، القيمة: &نص): نتيجة مصدر_تثبيت، نص {
    ليكن الغلاف: نص = صل_المسار(المؤقت، &«root»);
    طابق أنشئ_مسار_الدليل(&الغلاف) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء »، «cannot create »)، الغلاف])); }
    | نتيجة.نجح(_) -> { };
    // اسم الغلاف لا يساوي اسم أي حزمة مطلوبة (فيه _ في أوله).
    ليكن البيان: نص = ضم([
        «[package]»، سطر_جديد()، «name = "_supax_install"»، سطر_جديد()، «version = "0.0.0"»، سطر_جديد()، سطر_جديد()،
        «[dependencies]»، سطر_جديد()، انسخ_نص(الاسم)، « = »، انسخ_نص(القيمة)، سطر_جديد()
    ]);
    ليكن مسار_البيان: نص = صل_المسار(&الغلاف، &«Supax.toml»);
    اكتب_إن_تغير(&مسار_البيان، &البيان)؟;
    ليكن الجذور: متجه نص = [انسخ_نص(&الغلاف)];
    ليكن الخيارات: خيارات_الحل = خيارات_التثبيت(الطلب);
    // رسائل المحلل تبدأ بموضع الاعتمادية في بيان الغلاف المؤقت؛ لا معنى له للمستخدم.
    ليكن المخطط: مخطط;
    طابق حل_مخطط_الجذور(&الغلاف، &الجذور، &قفل_فارغ()، &الخيارات) مع
    | نتيجة.نجح(م) -> { المخطط := م; }
    | نتيجة.خطأ(السبب) -> {
        ليكن الموضع: نص = ضم([انسخ_نص(&مسار_البيان)، «:6: »]);
        ليكن فارغ: نص = «»;
        أرجع نتيجة.خطأ(استبدل_في_النص(&السبب، &الموضع، &فارغ));
    };
    ليكن الهدف: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المخطط.الحواف) مثل طبيعي)) {
        إذا (المخطط.الحواف[ف].المستورد == 0) { الهدف := المخطط.الحواف[ف].الهدف_رقم; };
        ف := ف + 1;
    }
    إذا (الهدف == 0) { أرجع نتيجة.خطأ(رسالة(«تعذر حل الحزمة المطلوبة»، «cannot resolve the requested package»)); };
    ليكن ح: &حزمة = &المخطط.الحزم[الهدف];
    // نسخة المخبأ للقراءة فقط، والبناء يكتب build/: تُنسخ النسخة كلها (للاعتماديات
    // المسارية داخل المستودع) إلى المؤقت وتصبح قابلة للكتابة.
    ليكن المصدر_المنسوخ: نص = صل_المسار(المؤقت، &«src»);
    طابق انسخ_الشجرة(&(*ح).جذر_النسخة، &المصدر_المنسوخ) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر نسخ »، «cannot copy »)، انسخ_نص(&(*ح).جذر_النسخة)])); }
    | نتيجة.نجح(_) -> { };
    اجعل_قابلا_للكتابة(&المصدر_المنسوخ);
    ليكن الدليل: متغير نص = انسخ_نص(&المصدر_المنسوخ);
    إذا (طول_النص(&(*ح).المسار_الفرعي) > 0) { الدليل := صل_المسار(&المصدر_المنسوخ، &(*ح).المسار_الفرعي); };
    ليكن المصدر: متغير نص = «git»;
    ليكن الأصل: متغير نص = انسخ_نص(&(*ح).الرابط);
    إذا (طول_النص(&(*ح).السجل) > 0) { المصدر := «registry»; الأصل := انسخ_نص(&(*ح).السجل); };
    ليكن م: مصدر_تثبيت = { الدليل: الدليل، المؤقت: انسخ_نص(المؤقت)، المصدر: المصدر، الأصل: الأصل، الالتزام: انسخ_نص(&(*ح).الالتزام) };
    أرجع نتيجة.نجح(م);
}

// ---------------------------------------------------------------------
// النسخ إلى bin/ والسجل

عرف محجوز(الملف: &نص): منطقي {
    أرجع يساوي_نصا(الملف، «supax») || يساوي_نصا(الملف، «supax.exe»)
        || يساوي_نصا(الملف، «sultanc») || يساوي_نصا(الملف، «sultanc.exe»);
}

// يثبت البرامج المبنية (المسارات في المخرجات) لحزمة. الإجبار: --force.
عام عرف ثبت_البرامج(
    البرامج: &متجه برنامج،
    المخرجات: &متجه نص،
    اسم_الحزمة: &نص،
    الإصدار: &نص،
    المصدر: &مصدر_تثبيت،
    الإجبار: منطقي
): نتيجة نص، نص {
    ليكن السجل: متجه برنامج_مثبت = اقرأ_السجل()؟;
    ليكن bin: نص = دليل_البرامج()؟;
    طابق أنشئ_مسار_الدليل(&bin) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء »، «cannot create »)، bin])); }
    | نتيجة.نجح(_) -> { };
    // الفحص كله قبل أي نسخ.
    ليكن الملفات: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المخرجات) مثل طبيعي)) {
        ليكن الملف: نص;
        طابق اسم_الملف(&(*المخرجات)[ف]) مع
        | اختياري.موجود(ق) -> { الملف := ق; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([رسالة(«مخرج بلا اسم: »، «an output without a name: »)، انسخ_نص(&(*المخرجات)[ف])])); };
        إذا (محجوز(&الملف)) {
            أرجع نتيجة.خطأ(ضم([رسالة(«لا يُثبَّت برنامج باسم "»، «a program named "»)، انسخ_نص(&الملف)،
                رسالة(«": هذا الاسم لسوباكس والمترجم في »، «" is not installed: that name belongs to Supax and the compiler in »)، انسخ_نص(&bin)]));
        };
        ليكن الوجهة: نص = صل_المسار(&bin، &الملف);
        إذا (ملف_موجود(&الوجهة) && !الإجبار) {
            ليكن المالك: متغير نص = «»;
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < (الطول(السجل) مثل طبيعي)) {
                إذا (نصان_متساويان(&السجل[ح].الملف، &الملف)) { المالك := انسخ_نص(&السجل[ح].الحزمة); };
                ح := ح + 1;
            }
            إذا (طول_النص(&المالك) == 0) {
                أرجع نتيجة.خطأ(ضم([انسخ_نص(&الوجهة)، رسالة(« موجود ولم يثبته سوباكس؛ لاستبداله مرر --force»، « exists and was not installed by Supax; pass --force to replace it»)]));
            };
            إذا (!نصان_متساويان(&المالك، اسم_الحزمة)) {
                أرجع نتيجة.خطأ(ضم([انسخ_نص(&الوجهة)، رسالة(« ثبّتته الحزمة "»، « was installed by the package "»)، المالك،
                    رسالة(«"؛ لاستبداله مرر --force»، «"; pass --force to replace it»)]));
            };
        };
        ألحق(الملفات، الملف);
        ف := ف + 1;
    }
    // النسخ: إلى ملف مؤقت بجانب الوجهة، ثم نقله فوقها.
    ليكن الجديد: متغير متجه برنامج_مثبت = [];
    ف := 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) {
        ليكن الوجهة: نص = صل_المسار(&bin، &الملفات[ف]);
        ليكن موجود_قبلا: منطقي = ملف_موجود(&الوجهة);
        ليكن المؤقت: نص = ضم([انسخ_نص(&الوجهة)، «.supax-tmp»]);
        طابق انسخ_الملف(&(*المخرجات)[ف]، &المؤقت) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة »، «cannot write »)، المؤقت])); }
        | نتيجة.نجح(_) -> { };
        // 493 = 0o755: rwxr-xr-x.
        طابق اضبط_أذونات(&المؤقت، 493) مع | _ -> { };
        طابق أعد_تسمية(&المؤقت، &الوجهة) مع
        | نتيجة.خطأ(_) -> {
            طابق أزل_ملفا(&المؤقت) مع | _ -> { };
            أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة »، «cannot write »)، الوجهة]));
        }
        | نتيجة.نجح(_) -> { };
        إذا (موجود_قبلا) {
            أعلن(«يستبدل»، «Replacing»، الوجهة);
        } وإلا {
            أعلن(«يثبّت»، «Installing»، الوجهة);
        };
        ليكن ب: برنامج_مثبت = {
            الاسم: انسخ_نص(&(*البرامج)[ف].الاسم)، الملف: انسخ_نص(&الملفات[ف])، الحزمة: انسخ_نص(اسم_الحزمة)،
            الإصدار: انسخ_نص(الإصدار)، المصدر: انسخ_نص(&(*المصدر).المصدر)، الأصل: انسخ_نص(&(*المصدر).الأصل)،
            الالتزام: انسخ_نص(&(*المصدر).الالتزام)
        };
        ألحق(الجديد، ب);
        ف := ف + 1;
    }
    // السجل: يبقى كل مدخل لم يُستبدل ملفه، ثم المداخل الجديدة.
    ليكن الباقي: متغير متجه برنامج_مثبت = [];
    ف := 0;
    طالما (ف < (الطول(السجل) مثل طبيعي)) {
        ليكن مستبدل: متغير منطقي = خطأ;
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الملفات) مثل طبيعي)) {
            إذا (نصان_متساويان(&السجل[ف].الملف، &الملفات[ح])) { مستبدل := صواب; };
            ح := ح + 1;
        }
        إذا (!مستبدل) { ألحق(الباقي، استنسخ(&السجل[ف])); };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(الجديد) مثل طبيعي)) { ألحق(الباقي، استنسخ(&الجديد[ف])); ف := ف + 1; }
    اكتب_السجل(&الباقي)؟;
    أرجع نتيجة.نجح(«»);
}

// supax uninstall <الحزمة> [--bin <الاسم>]
عام عرف ألغ_التثبيت(الطلب: &طلب): نتيجة عدد، نص {
    إذا ((الطول((*الطلب).المسماة) مثل طبيعي) != 1) {
        أرجع نتيجة.خطأ(رسالة(«الاستخدام: supax uninstall <الحزمة> [--bin <الاسم>]»، «usage: supax uninstall <package> [--bin <name>]»));
    };
    ليكن الحزمة: نص = انسخ_نص(&(*الطلب).المسماة[0]);
    ليكن البرنامج: نص = قيمة_الخيار(الطلب، «bin»);
    ليكن السجل: متجه برنامج_مثبت = اقرأ_السجل()؟;
    ليكن bin: نص = دليل_البرامج()؟;
    ليكن الباقي: متغير متجه برنامج_مثبت = [];
    ليكن المحذوفة: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(السجل) مثل طبيعي)) {
        ليكن ب: &برنامج_مثبت = &السجل[ف];
        ليكن مطابق: منطقي = نصان_متساويان(&(*ب).الحزمة، &الحزمة)
            && (طول_النص(&البرنامج) == 0 || نصان_متساويان(&(*ب).الاسم، &البرنامج));
        إذا (مطابق) {
            ليكن المسار: نص = صل_المسار(&bin، &(*ب).الملف);
            إذا (ملف_موجود(&المسار)) {
                طابق أزل_ملفا(&المسار) مع
                | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر حذف »، «cannot remove »)، المسار])); }
                | نتيجة.نجح(_) -> { };
            };
            أعلن(«يحذف»، «Removing»، المسار);
            المحذوفة := المحذوفة + 1;
        } وإلا {
            ألحق(الباقي، استنسخ(ب));
        };
        ف := ف + 1;
    }
    إذا (المحذوفة == 0) {
        إذا (طول_النص(&البرنامج) > 0) {
            أرجع نتيجة.خطأ(ضم([رسالة(«الحزمة "»، «the package "»)، الحزمة، رسالة(«" لم تثبّت برنامجا باسم "»، «" did not install a program named "»)، البرنامج، «"»]));
        };
        أرجع نتيجة.خطأ(ضم([رسالة(«الحزمة "»، «the package "»)، الحزمة، رسالة(«" غير مثبتة؛ supax install --list يعرض المثبت»، «" is not installed; supax install --list shows what is»)]));
    };
    اكتب_السجل(&الباقي)؟;
    أرجع نتيجة.نجح(0);
}

// supax install --list: كل حزمة مثبتة، ثم برامجها.
عام عرف اسرد_المثبت(): نتيجة عدد، نص {
    ليكن السجل: متجه برنامج_مثبت = اقرأ_السجل()؟;
    ليكن المعروضة: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(السجل) مثل طبيعي)) {
        ليكن الحزمة: &نص = &السجل[ف].الحزمة;
        ليكن سبق: متغير منطقي = خطأ;
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(المعروضة) مثل طبيعي)) {
            إذا (نصان_متساويان(&المعروضة[ح]، الحزمة)) { سبق := صواب; };
            ح := ح + 1;
        }
        إذا (!سبق) {
            ألحق(المعروضة، انسخ_نص(الحزمة));
            ليكن المصدر: متغير نص = انسخ_نص(&السجل[ف].الأصل);
            إذا (طول_النص(&السجل[ف].الالتزام) > 0) { المصدر := ضم([المصدر، «#»، شريحة_نص(&السجل[ف].الالتزام، 0، 12)]); };
            اطبع_سطر(ضم([انسخ_نص(الحزمة)، « v»، انسخ_نص(&السجل[ف].الإصدار)، « (»، المصدر، «):»]));
            ح := 0;
            طالما (ح < (الطول(السجل) مثل طبيعي)) {
                إذا (نصان_متساويان(&السجل[ح].الحزمة، الحزمة)) { اطبع_سطر(ضم([«    »، انسخ_نص(&السجل[ح].الملف)])); };
                ح := ح + 1;
            }
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}
