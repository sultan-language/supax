عام عرف بصمة_نص(النص: &نص): نص {
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(النص));
    أرجع رمز_سداسي(&شا256(&البايتات));
}

// يجمع مسارات الملفات العادية نسبيا إلى الجذر.
عام عرف اجمع_الملفات(
    الجذر: &نص,
    النسبي: &نص,
    الناتج: &متغير متجه نص
): نتيجة طبيعي, نص {
    دع الدليل: نص = إذا_فارغ_فالجذر(الجذر, النسبي);
    دع المداخل: متجه مدخل_دليل;
    طابق اقرأ_مدخلات_الدليل(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة الدليل », «cannot read directory »), الدليل])); }
    | نتيجة.نجح(ق) -> { المداخل := ق; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع الاسم: &نص = &المداخل[ف].الاسم;
        دع ابن: نص = إذا_فارغ_فالاسم(النسبي, الاسم);
        دع تخطى: منطقي = طول_النص(النسبي) == 0 && يساوي_نصا(الاسم, «.git»);
        إذا (!تخطى) {
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.ملف -> { ألحق(*الناتج, ابن); }
            | نوع_مدخل_دليل.دليل -> { اجمع_الملفات(الجذر, &ابن, الناتج)؟; }
            | نوع_مدخل_دليل.وصلة_رمزية -> {
                أرجع نتيجة.خطأ(ضم([رسالة(«وصلة رمزية في شجرة حزمة: », «symbolic link in a package tree: »), ابن, رسالة(« — الوصلات الرمزية غير مسموحة في الاعتماديات», « (symbolic links are not allowed in dependencies)»)]));
            }
            | نوع_مدخل_دليل.آخر -> {
                أرجع نتيجة.خطأ(ضم([رسالة(«مدخل خاص في شجرة حزمة: », «special file in a package tree: »), ابن]));
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الطول(*الناتج) مثل طبيعي);
}

عام عرف إذا_فارغ_فالجذر(الجذر: &نص, النسبي: &نص): نص {
    إذا (طول_النص(النسبي) == 0) { أرجع انسخ_نص(الجذر); };
    أرجع صل_المسار(الجذر, النسبي);
}

عام عرف إذا_فارغ_فالاسم(النسبي: &نص, الاسم: &نص): نص {
    إذا (طول_النص(النسبي) == 0) { أرجع انسخ_نص(الاسم); };
    أرجع ضم([انسخ_نص(النسبي), «/», انسخ_نص(الاسم)]);
}

// بصمة محتوى الشجرة: «sha256:<ست عشري>».
عام عرف بصمة_الشجرة(الجذر: &نص): نتيجة نص, نص {
    دع الملفات: متغير متجه نص = [];
    دع فارغ: نص = «»;
    اجمع_الملفات(الجذر, &فارغ, &متغير الملفات)؟;
    رتب_نصوص(&متغير الملفات);
    دع الكل: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) {
        دع المسار: نص = صل_المسار(الجذر, &الملفات[ف]);
        طابق اقرأ_بايتات_ملف(&المسار) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة », «cannot read »), المسار])); }
        | نتيجة.نجح(المحتوى) -> {
            ألحق_بايتات_نص(&متغير الكل, انسخ_نص(&الملفات[ف]));
            ألحق(الكل, 0);
            ألحق_بايتات_نص(&متغير الكل, رمز_سداسي(&شا256(&المحتوى)));
            ألحق(الكل, 10);
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(ضم([«sha256:», رمز_سداسي(&شا256(&الكل))]));
}
