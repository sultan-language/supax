// $SUPAX_HOME/git، وإلا ~/.supax/git.
عام عرف جذر_المخبأ(): نتيجة نص, نص {
    دع الأساس: نص = بيت_سوباكس()؟;
    دع الجذر: نص = صل_المسار(&الأساس, &«git»);
    طابق أنشئ_مسار_الدليل(&الجذر) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء دليل المخبأ », «cannot create the cache directory »), الجذر])); }
    | نتيجة.نجح(_) -> { };
    دع إعداد_فارغ: نص = صل_المسار(&الجذر, &«empty.gitconfig»);
    طابق حاول_مسار_ملف(&إعداد_فارغ) مع
    | نتيجة.نجح(صواب) -> { }
    | _ -> {
        دع فارغ: نص = «»;
        طابق اكتب_الملف(&إعداد_فارغ, &فارغ) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت الكتابة في المخبأ », «cannot write to the cache »), الجذر])); }
        | نتيجة.نجح(_) -> { };
    };
    أرجع نتيجة.نجح(الجذر);
}

// أول 16 محرفا من بصمة الهوية؛ اسم دليل ثابت لكل مستودع.
عام عرف مفتاح_المخبأ(الهوية: &نص): نص {
    دع البصمة: نص = بصمة_نص(الهوية);
    أرجع شريحة_نص(&البصمة, 0, 16);
}

عام عرف مسار_المستودع(الجذر: &نص, الهوية: &نص): نص {
    دع db: نص = صل_المسار(الجذر, &«db»);
    أرجع صل_المسار(&db, &مفتاح_المخبأ(الهوية));
}

// يجعل ملفات الشجرة للقراءة فقط (أفضل جهد؛ بعض الأنظمة لا تدعمه).
عام عرف اجعل_للقراءة_فقط(الجذر: &نص): فراغ {
    دع الملفات: متغير متجه نص = [];
    دع فارغ: نص = «»;
    طابق اجمع_الملفات(الجذر, &فارغ, &متغير الملفات) مع | _ -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) {
        دع المسار: نص = صل_المسار(الجذر, &الملفات[ف]);
        طابق اضبط_أذونات(&المسار, 292) مع | _ -> { };
        ف := ف + 1;
    }
}

// يعيد الملفات إلى قابلة للكتابة قبل الحذف.
عام عرف اجعل_قابلا_للكتابة(الجذر: &نص): فراغ {
    دع الملفات: متغير متجه نص = [];
    دع فارغ: نص = «»;
    طابق اجمع_الملفات(الجذر, &فارغ, &متغير الملفات) مع | _ -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) {
        دع المسار: نص = صل_المسار(الجذر, &الملفات[ف]);
        طابق اضبط_أذونات(&المسار, 420) مع | _ -> { };
        ف := ف + 1;
    }
}

عام عرف احذف_شجرة(الجذر: &نص): فراغ {
    اجعل_قابلا_للكتابة(الجذر);
    طابق احذف_الشجرة(الجذر) مع | _ -> { };
}

عام نوع نسخة_مسحوبة = { الدليل: نص, البصمة: نص };

// يتحقق من نسخة موجودة مقابل بصمتها المسجلة.
عام عرف تحقق_من_نسخة(الدليل: &نص, ملف_البصمة: &نص): نتيجة نسخة_مسحوبة, نص {
    دع المسجلة: نص;
    طابق اقرأ_الملف(ملف_البصمة) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة », «cannot read »), انسخ_نص(ملف_البصمة)])); }
    | نتيجة.نجح(ق) -> { المسجلة := قص_النص(&ق); };
    دع الفعلية: نص = بصمة_الشجرة(الدليل)؟;
    إذا (!نصان_متساويان(&المسجلة, &الفعلية)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«فشل التحقق من سلامة المخبأ: النسخة », «cache integrity check failed: checkout »), انسخ_نص(الدليل),
            رسالة(« تغيّر محتواها بعد سحبها. احذف هذا الدليل ثم أعد التشغيل», « changed after it was fetched. Delete that directory and run again»)]));
    };
    دع ن: نسخة_مسحوبة = { الدليل: انسخ_نص(الدليل), البصمة: الفعلية };
    أرجع نتيجة.نجح(ن);
}

// ينشئ نسخة غير قابلة للتغيير من الالتزام، أو يتحقق من نسخة موجودة.
عام عرف اسحب_إلى_المخبأ(الجذر: &نص, الهوية: &نص, الالتزام: &نص): نتيجة نسخة_مسحوبة, نص {
    دع المستودع: نص = مسار_المستودع(الجذر, الهوية);
    دع النسخ: نص = صل_المسار(الجذر, &«checkouts»);
    دع الأب: نص = صل_المسار(&النسخ, &مفتاح_المخبأ(الهوية));
    دع الدليل: نص = صل_المسار(&الأب, الالتزام);
    دع ملف_البصمة: نص = ضم([انسخ_نص(&الدليل), «.sha256»]);
    دع للدليل: منطقي = صواب_إن_نجح(حاول_مسار_دليل(&الدليل));
    إذا (للدليل) {
        إذا (صواب_إن_نجح(حاول_مسار_ملف(&ملف_البصمة))) {
            أرجع تحقق_من_نسخة(&الدليل, &ملف_البصمة);
        };
        // سحب سابق لم يكتمل.
        احذف_شجرة(&الدليل);
    };
    طابق أنشئ_مسار_الدليل(&الأب) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء », «cannot create »), الأب])); }
    | نتيجة.نجح(_) -> { };
    دع البادئة: نص = ضم([انسخ_نص(الالتزام), «.tmp-»]);
    دع المؤقت: نص;
    طابق أنشئ_دليلا_مؤقتا_في(&الأب, &البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء دليل مؤقت في », «cannot create a temporary directory in »), الأب])); }
    | نتيجة.نجح(ق) -> { المؤقت := ق; };
    دع الفهرس: نص = ضم([انسخ_نص(&المؤقت), «.index»]);
    طابق اسحب_الالتزام(الجذر, &المستودع, الالتزام, &المؤقت, &الفهرس) مع
    | نتيجة.خطأ(السبب) -> {
        احذف_شجرة(&المؤقت);
        طابق أزل_ملفا(&الفهرس) مع | _ -> { };
        أرجع نتيجة.خطأ(السبب);
    }
    | نتيجة.نجح(_) -> { };
    طابق أزل_ملفا(&الفهرس) مع | _ -> { };
    دع البصمة: نص;
    طابق بصمة_الشجرة(&المؤقت) مع
    | نتيجة.خطأ(السبب) -> { احذف_شجرة(&المؤقت); أرجع نتيجة.خطأ(السبب); }
    | نتيجة.نجح(ق) -> { البصمة := ق; };
    اجعل_للقراءة_فقط(&المؤقت);
    طابق أعد_تسمية(&المؤقت, &الدليل) مع
    | نتيجة.خطأ(_) -> {
        // عملية أخرى سبقتنا إلى الدليل نفسه.
        احذف_شجرة(&المؤقت);
        إذا (صواب_إن_نجح(حاول_مسار_ملف(&ملف_البصمة))) {
            أرجع تحقق_من_نسخة(&الدليل, &ملف_البصمة);
        };
        أرجع نتيجة.خطأ(ضم([رسالة(«تعذر نقل النسخة إلى », «cannot move the checkout to »), الدليل]));
    }
    | نتيجة.نجح(_) -> { };
    دع سطر: نص = ضم([انسخ_نص(&البصمة), سطر_جديد()]);
    طابق اكتب_الملف(&ملف_البصمة, &سطر) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت كتابة », «cannot write »), ملف_البصمة])); }
    | نتيجة.نجح(_) -> { };
    دع ن: نسخة_مسحوبة = { الدليل: الدليل, البصمة: البصمة };
    أرجع نتيجة.نجح(ن);
}

عام عرف صواب_إن_نجح(ن: نتيجة منطقي, عدد): منطقي {
    طابق ن مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// قفل المستودع: db/<h16>.lock، قفل حصري عبر std.fs.lock (flock أو LockFileEx).
// إن كان محجوزا لعملية أخرى طُبع سطر انتظار ثم انتُظر.
عام عرف احجز_المستودع(الجذر: &نص, الهوية: &نص): نتيجة مقبض_ملف, نص {
    دع db: نص = صل_المسار(الجذر, &«db»);
    طابق أنشئ_مسار_الدليل(&db) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء », «cannot create »), db])); }
    | نتيجة.نجح(_) -> { };
    دع المسار: نص = ضم([مسار_المستودع(الجذر, الهوية), «.lock»]);
    دع المقبض: مقبض_ملف;
    طابق أنشئ_مقبض_ملف_للكتابة(&المسار) مع
    | نتيجة.نجح(م) -> { المقبض := م; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر فتح قفل المخبأ », «cannot open the cache lock »), المسار])); };
    طابق حاول_قفل_الملف(&المقبض) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المقبض); }
    | نتيجة.خطأ(خطأ_محاولة_قفل.ستحظر) -> {
        أعلن(«ينتظر», «Blocking», رسالة(«عملية سوباكس أخرى تستخدم المخبأ…», «waiting for another Supax process using the cache…»));
    }
    | نتيجة.خطأ(_) -> {
        // نظام بلا أقفال (مثل WASI): المتابعة دون قفل.
        أرجع نتيجة.نجح(المقبض);
    };
    طابق اقفل_الملف(&المقبض) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المقبض); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر قفل المخبأ », «cannot lock the cache »), المسار])); };
}

عام عرف حرر_المستودع(المقبض: مقبض_ملف): فراغ {
    طابق افتح_قفل_الملف(&المقبض) مع | _ -> { };
    طابق أغلق_مقبض_ملف(المقبض) مع | _ -> { };
}

// supax cache: معلومات المخبأ وتنظيفه. كل ما فيه قابل للجلب من جديد.
عام نوع معلومات_المخبأ = { الجذر: نص, المستودعات: طبيعي, النسخ: طبيعي, البايتات: عدد };

عرف عد_المداخل(المسار: &نص, لاحقة_مستبعدة: نص): طبيعي {
    طابق اقرأ_مدخلات_الدليل(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 0; }
    | نتيجة.نجح(المداخل) -> {
        دع العدد: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { العدد := العدد + 1; }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع العدد;
    };
}

عام عرف معلومات_مخبأ(الجذر: &نص): معلومات_المخبأ {
    دع db: نص = صل_المسار(الجذر, &«db»);
    دع النسخ: نص = صل_المسار(الجذر, &«checkouts»);
    دع عدد_النسخ: متغير طبيعي = 0;
    طابق اقرأ_مدخلات_الدليل(&النسخ) مع
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع الدليل: نص = صل_المسار(&النسخ, &المداخل[ف].الاسم);
            عدد_النسخ := عدد_النسخ + عد_المداخل(&الدليل, «»);
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    دع البايتات: متغير عدد = 0;
    طابق اجتز_الشجرة(الجذر) مع
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            طابق حجم_المسار(&المداخل[ف].المسار) مع
            | نتيجة.نجح(ح) -> { البايتات := البايتات + ح; }
            | نتيجة.خطأ(_) -> { };
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    دع م: معلومات_المخبأ = { الجذر: انسخ_نص(الجذر), المستودعات: عد_المداخل(&db, «»), النسخ: عدد_النسخ, البايتات: البايتات };
    أرجع م;
}

// يحذف المستودعات والنسخ. يحجز كل مستودع قبل حذفه، فلا يُحذف ما تستخدمه عملية أخرى.
عام عرف نظف_المخبأ(الجذر: &نص): نتيجة نص, نص {
    دع النسخ: نص = صل_المسار(الجذر, &«checkouts»);
    دع db: نص = صل_المسار(الجذر, &«db»);
    طابق اقرأ_مدخلات_الدليل(&النسخ) مع
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع المفتاح: &نص = &المداخل[ف].الاسم;
            دع القفل_المسار: نص = ضم([صل_المسار(&db, المفتاح), «.lock»]);
            دع المقبض: متغير اختياري مقبض_ملف = اختياري.لا_شيء();
            طابق أنشئ_مقبض_ملف_للكتابة(&القفل_المسار) مع
            | نتيجة.نجح(م) -> {
                طابق حاول_قفل_الملف(&م) مع
                | نتيجة.خطأ(خطأ_محاولة_قفل.ستحظر) -> {
                    طابق أغلق_مقبض_ملف(م) مع | _ -> { };
                    أرجع نتيجة.خطأ(رسالة(«عملية سوباكس أخرى تستخدم المخبأ الآن؛ أعد المحاولة بعدها», «another Supax process is using the cache; try again when it finishes»));
                }
                | _ -> { المقبض := اختياري.موجود(م); };
            }
            | نتيجة.خطأ(_) -> { };
            دع الدليل: نص = صل_المسار(&النسخ, المفتاح);
            احذف_شجرة(&الدليل);
            دع المستودع: نص = صل_المسار(&db, المفتاح);
            طابق احذف_الشجرة(&المستودع) مع | _ -> { };
            طابق المقبض مع
            | اختياري.موجود(م) -> { حرر_المستودع(م); }
            | اختياري.لا_شيء -> { };
            طابق أزل_ملفا(&القفل_المسار) مع | _ -> { };
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    // مستودعات بلا نسخ.
    طابق احذف_الشجرة(&db) مع | _ -> { };
    أرجع نتيجة.نجح(«»);
}
