// مصادر git: هوية الرابط، وتشغيل git معزولا، والجلب، وحل المراجع.
//
// كل تشغيل لـ git يعطّل الخطافات (hooks) و fsmonitor ونقل ext:: والوصلات
// الرمزية وتحويل نهايات الأسطر، فلا يُشغَّل شيء مصدره حزمة مجلوبة.
// السحب إلى المخبأ يتجاهل أيضا إعدادات النظام والمستخدم (فلا مرشحات smudge).
استورد المكتبة.مجموعات.sort;
استورد المكتبة.مجموعات.vector;
استورد المكتبة.تشفير.sha256;
استورد المكتبة.بيئة.environment;
استورد المكتبة.بيئة.variables;
استورد المكتبة.عمليات.arguments;
استورد المكتبة.عمليات.child;
استورد المكتبة.عمليات.command;
استورد المكتبة.عمليات.exit;
استورد المكتبة.تومل.parser;
استورد المكتبة.ترميز.hex;
استورد المكتبة.دخ.println;
استورد المكتبة.ملفات.canonical;
استورد المكتبة.ملفات.directory;
استورد المكتبة.ملفات.mutation;
استورد المكتبة.ملفات.path;
استورد المكتبة.ملفات.permissions;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.ملفات.temporary;
استورد المكتبة.ملفات.walk;
استورد المكتبة.ملفات.write_file;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.نصوص.number;
استورد المكتبة.نصوص.search;
استورد المكتبة.نصوص.transform;
استورد سوباكس.support.text;
استورد سوباكس.support.status;
استورد سوباكس.support.messages;
استورد سوباكس.manifest.manifest;

عام نوع ناتج_جت = { الرمز: عدد, الخرج: نص, الخطأ: نص };

// متغيرات بيئة قد توجه git إلى مستودع أو فهرس غير الذي نقصده.
عام عرف متغيرات_جت_الموجهة(): متجه نص {
    أرجع [«GIT_DIR», «GIT_WORK_TREE», «GIT_INDEX_FILE», «GIT_NAMESPACE», «GIT_OBJECT_DIRECTORY»,
        «GIT_ALTERNATE_OBJECT_DIRECTORIES», «GIT_CEILING_DIRECTORIES», «GIT_COMMON_DIR»];
}

// يشغل git بالوسائط. معزول: يتجاهل إعدادات النظام والمستخدم. ملف_الفهرس:
// فهرس مؤقت لعملية السحب أو نص فارغ.
عام عرف شغل_جت(
    جذر_المخبأ: &نص,
    الوسائط: &متجه نص,
    معزول: منطقي,
    ملف_الفهرس: &نص
): نتيجة ناتج_جت, نص {
    دع البرنامج: نص = «git»;
    دع الأمر: متغير أمر = أنشئ_أمرا(&البرنامج);
    دع بلا_خطافات: نص = صل_المسار(جذر_المخبأ, &«no-hooks»);
    دع الإعدادات: متجه نص = [
        «-c», ضم([«core.hooksPath=», بلا_خطافات]),
        «-c», «protocol.ext.allow=never»,
        «-c», «core.fsmonitor=false»,
        «-c», «core.symlinks=false»,
        «-c», «core.autocrlf=false»,
        «-c», «core.eol=lf»,
        «-c», «submodule.recurse=false»,
        «-c», «advice.detachedHead=false»
    ];
    أضف_وسائط_للأمر(&متغير الأمر, &الإعدادات);
    أضف_وسائط_للأمر(&متغير الأمر, الوسائط);
    دع الموجهة: متجه نص = متغيرات_جت_الموجهة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الموجهة) مثل طبيعي)) {
        طابق أزل_بيئة_من_الأمر(&متغير الأمر, &الموجهة[ف]) مع | نتيجة.خطأ(_) -> { } | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    إذا (معزول) {
        دع إعداد_فارغ: نص = صل_المسار(جذر_المخبأ, &«empty.gitconfig»);
        دع الاسم1: نص = «GIT_CONFIG_NOSYSTEM»;
        دع القيمة1: نص = «1»;
        دع الاسم2: نص = «GIT_CONFIG_GLOBAL»;
        دع الاسم3: نص = «GIT_TERMINAL_PROMPT»;
        دع القيمة3: نص = «0»;
        طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم1, &القيمة1) مع | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذر ضبط بيئة git», «cannot set up the git environment»)); } | نتيجة.نجح(_) -> { };
        طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم2, &إعداد_فارغ) مع | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذر ضبط بيئة git», «cannot set up the git environment»)); } | نتيجة.نجح(_) -> { };
        طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم3, &القيمة3) مع | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذر ضبط بيئة git», «cannot set up the git environment»)); } | نتيجة.نجح(_) -> { };
    };
    إذا (طول_النص(ملف_الفهرس) > 0) {
        دع الاسم: نص = «GIT_INDEX_FILE»;
        طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم, ملف_الفهرس) مع | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذر ضبط بيئة git», «cannot set up the git environment»)); } | نتيجة.نجح(_) -> { };
    };
    اضبط_دخل_الأمر(&متغير الأمر, مصدر_تيار.فارغ());
    اضبط_خرج_الأمر(&متغير الأمر, مصدر_تيار.التقاط());
    اضبط_خطأ_الأمر(&متغير الأمر, مصدر_تيار.التقاط());
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(رسالة(«تعذر تشغيل git؛ تأكد أنه مثبت وموجود في PATH», «cannot run git; make sure it is installed and in PATH»)); }
    | نتيجة.نجح(الناتج) -> {
        دع الرمز: متغير عدد = -1;
        طابق الناتج.الحالة مع
        | حالة_إنهاء.خرج(ر) -> { الرمز := ر; }
        | حالة_إنهاء.إشارة(_) -> { الرمز := -1; };
        دع ن: ناتج_جت = { الرمز: الرمز, الخرج: من_بايتات(&الناتج.الخرج), الخطأ: من_بايتات(&الناتج.الخطأ) };
        أرجع نتيجة.نجح(ن);
    };
}

// يشغل git ويعيد خرجه بعد القص، أو رسالة الخطأ.
عام عرف جت_ناجح(جذر_المخبأ: &نص, الوسائط: متجه نص, معزول: منطقي, الوصف: نص): نتيجة نص, نص {
    دع بلا_فهرس: نص = «»;
    دع الناتج: ناتج_جت = شغل_جت(جذر_المخبأ, &الوسائط, معزول, &بلا_فهرس)؟;
    إذا (الناتج.الرمز != 0) {
        أرجع نتيجة.خطأ(ضم([الوصف, «: », قص_النص(&الناتج.الخطأ)]));
    };
    أرجع نتيجة.نجح(قص_النص(&الناتج.الخرج));
}

// ---------------------------------------------------------------------
// هوية الرابط

عام عرف بايت_مسموح_في_رابط(ب: ط8): منطقي {
    أرجع ب > 32 && ب != 127 && ب != 34 && ب != 39 && ب != 96 && ب != 60 && ب != 62 && ب != 124;
}

عام عرف أزل_اللواحق(القيمة: نص): نص {
    دع الناتج: متغير نص = القيمة;
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع ل: طبيعي = طول_النص(&الناتج);
        إذا (ل > 1 && الناتج[ل - 1] == 47) {
            الناتج := شريحة_نص(&الناتج, 0, ل - 1);
            تغير := صواب;
        } وإلا إذا (ينتهي_بـ(&الناتج, &«.git») && ل > 4) {
            الناتج := شريحة_نص(&الناتج, 0, ل - 4);
            تغير := صواب;
        };
    }
    أرجع الناتج;
}

// يقبل https:// و http:// و ssh:// و file:// وصيغة user@host:path. الهوية:
// المخطط والمضيف بأحرف صغيرة، دون «/» أو «.git» في النهاية، ليُعرف المستودع
// الواحد إذا كُتب رابطه بصيغتين.
عام عرف هوية_رابط_جت(الرابط: &نص): نتيجة نص, نص {
    دع ل: طبيعي = طول_النص(الرابط);
    إذا (ل == 0 || ل > 2048) { أرجع نتيجة.خطأ(رسالة(«رابط git فارغ أو طويل جدا», «the git URL is empty or too long»)); };
    إذا ((*الرابط)[0] == 45) { أرجع نتيجة.خطأ(رسالة(«رابط git لا يجوز أن يبدأ بـ "-"», «a git URL must not start with "-"»)); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < ل) {
        إذا (!بايت_مسموح_في_رابط((*الرابط)[ف])) { أرجع نتيجة.خطأ(رسالة(«رابط git يحوي محارف غير مسموحة», «the git URL contains characters that are not allowed»)); };
        ف := ف + 1;
    }
    إذا (يحتوي_نصا(الرابط, &«::»)) { أرجع نتيجة.خطأ(رسالة(«نقل git الخارجي (::) غير مسموح», «git external transports (::) are not allowed»)); };
    دع الصغير: نص = حول_النص_إلى_صغير_أسكي(الرابط);
    دع المخططات: متجه نص = [«https://», «http://», «ssh://», «file://»];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المخططات) مثل طبيعي)) {
        إذا (يبدأ_بـ(&الصغير, &المخططات[م])) {
            دع بداية: طبيعي = طول_النص(&المخططات[م]);
            إذا (يساوي_نصا(&المخططات[م], «file://»)) {
                أرجع نتيجة.نجح(أزل_اللواحق(ضم([«file://», شريحة_نص(الرابط, بداية, ل)])));
            };
            دع نهاية_المضيف: طبيعي = موضع_بايت(الرابط, 47, بداية);
            إذا (نهاية_المضيف == بداية || نهاية_المضيف >= ل - 1) {
                أرجع نتيجة.خطأ(رسالة(«رابط git بلا مضيف أو بلا مسار», «the git URL has no host or no path»));
            };
            دع المضيف: نص = شريحة_نص(الرابط, بداية, نهاية_المضيف);
            أرجع نتيجة.نجح(أزل_اللواحق(ضم([
                انسخ_نص(&المخططات[م]), حول_النص_إلى_صغير_أسكي(&المضيف), شريحة_نص(الرابط, نهاية_المضيف, ل)
            ])));
        };
        م := م + 1;
    }
    إذا (!يحتوي_نصا(الرابط, &«://»)) {
        دع النقطتان: طبيعي = موضع_بايت(الرابط, 58, 0);
        دع الشرطة: طبيعي = موضع_بايت(الرابط, 47, 0);
        دع آت: طبيعي = موضع_بايت(الرابط, 64, 0);
        إذا (النقطتان < ل && النقطتان < الشرطة && آت < النقطتان && النقطتان > آت + 2 && النقطتان + 1 < ل) {
            دع المستخدم: نص = شريحة_نص(الرابط, 0, آت + 1);
            دع المضيف: نص = شريحة_نص(الرابط, آت + 1, النقطتان);
            دع المسار: متغير نص = شريحة_نص(الرابط, النقطتان + 1, ل);
            إذا (طول_النص(&المسار) > 0 && المسار[0] != 47) { المسار := ضم([«/», المسار]); };
            أرجع نتيجة.نجح(أزل_اللواحق(ضم([«ssh://», المستخدم, حول_النص_إلى_صغير_أسكي(&المضيف), المسار])));
        };
    };
    أرجع نتيجة.خطأ(ضم([رسالة(«رابط git غير مدعوم: », «unsupported git URL: »), انسخ_نص(الرابط), رسالة(« (المدعوم: https:// و ssh:// و file:// و user@host:path)», « (supported: https://, ssh://, file:// and user@host:path)»)]));
}

عام عرف يساوي_نصا(الأول: &نص, الثاني: نص): منطقي {
    دع ب: نص = الثاني;
    أرجع نصان_متساويان(الأول, &ب);
}

// ---------------------------------------------------------------------
// المستودعات في المخبأ

// يجهز مستودعا مجردا (bare) للهوية إن لم يوجد.
عام عرف جهز_المستودع(جذر_المخبأ: &نص, المستودع: &نص): نتيجة نص, نص {
    طابق حاول_مسار_دليل(المستودع) مع
    | نتيجة.نجح(صواب) -> { أرجع نتيجة.نجح(انسخ_نص(المستودع)); }
    | _ -> { };
    طابق أب_المسار(المستودع) مع
    | اختياري.موجود(الأب) -> {
        طابق أنشئ_مسار_الدليل(&الأب) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذر إنشاء الدليل », «cannot create directory »), الأب])); }
        | نتيجة.نجح(_) -> { };
    }
    | اختياري.لا_شيء -> { };
    جت_ناجح(جذر_المخبأ, [«init», «--bare», «--quiet», انسخ_نص(المستودع)], خطأ, رسالة(«تعذر إنشاء مستودع المخبأ», «cannot create the cache repository»))؟;
    أرجع نتيجة.نجح(انسخ_نص(المستودع));
}

// يجلب الفروع والوسوم ورأس المستودع البعيد إلى المستودع المجرد.
عام عرف اجلب_المستودع(جذر_المخبأ: &نص, المستودع: &نص, الرابط: &نص): نتيجة نص, نص {
    أعلن(«يجلب», «Fetching», انسخ_نص(الرابط));
    جت_ناجح(جذر_المخبأ, [
        ضم([«--git-dir=», انسخ_نص(المستودع)]), «fetch», «--quiet», «--force», «--no-tags», «--prune», «--»,
        انسخ_نص(الرابط),
        «+refs/heads/*:refs/remotes/origin/*»,
        «+refs/tags/*:refs/tags/*»,
        «+HEAD:refs/remotes/origin/HEAD»
    ], خطأ, ضم([رسالة(«تعذر جلب », «cannot fetch »), انسخ_نص(الرابط)]))؟;
    أرجع نتيجة.نجح(«»);
}

// يحاول جلب التزام بعينه (المستودعات المستضافة تسمح بطلب التزام كامل).
عام عرف اجلب_التزاما(جذر_المخبأ: &نص, المستودع: &نص, الرابط: &نص, الالتزام: &نص): فراغ {
    دع بلا_فهرس: نص = «»;
    دع الوسائط: متجه نص = [ضم([«--git-dir=», انسخ_نص(المستودع)]), «fetch», «--quiet», «--no-tags», «--», انسخ_نص(الرابط), انسخ_نص(الالتزام)];
    طابق شغل_جت(جذر_المخبأ, &الوسائط, خطأ, &بلا_فهرس) مع | _ -> { };
}

عام عرف التزام_موجود(جذر_المخبأ: &نص, المستودع: &نص, الالتزام: &نص): منطقي {
    دع بلا_فهرس: نص = «»;
    دع الوسائط: متجه نص = [ضم([«--git-dir=», انسخ_نص(المستودع)]), «cat-file», «-e», ضم([انسخ_نص(الالتزام), «^{commit}»])];
    طابق شغل_جت(جذر_المخبأ, &الوسائط, خطأ, &بلا_فهرس) مع
    | نتيجة.نجح(ن) -> { أرجع ن.الرمز == 0; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عام عرف مواصفة_المرجع(النوع: نوع_مرجع_جت, المرجع: &نص): نص {
    طابق النوع مع
    | نوع_مرجع_جت.وسم -> { أرجع ضم([«refs/tags/», انسخ_نص(المرجع), «^{commit}»]); }
    | نوع_مرجع_جت.فرع -> { أرجع ضم([«refs/remotes/origin/», انسخ_نص(المرجع), «^{commit}»]); }
    | نوع_مرجع_جت.مراجعة -> { أرجع ضم([انسخ_نص(المرجع), «^{commit}»]); }
    | نوع_مرجع_جت.الفرع_الافتراضي -> { أرجع «refs/remotes/origin/HEAD^{commit}»; };
}

// الالتزام الكامل الذي يشير إليه المرجع في المخبأ، إن وُجد.
عام عرف حل_محليا(جذر_المخبأ: &نص, المستودع: &نص, النوع: نوع_مرجع_جت, المرجع: &نص): اختياري نص {
    دع بلا_فهرس: نص = «»;
    دع الوسائط: متجه نص = [ضم([«--git-dir=», انسخ_نص(المستودع)]), «rev-parse», «--verify», «--quiet», مواصفة_المرجع(النوع, المرجع)];
    طابق شغل_جت(جذر_المخبأ, &الوسائط, خطأ, &بلا_فهرس) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن.الرمز != 0) { أرجع اختياري.لا_شيء(); };
        دع الالتزام: نص = قص_النص(&ن.الخرج);
        إذا (طول_النص(&الالتزام) < 40) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الالتزام);
    }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عام عرف وصف_المرجع(النوع: نوع_مرجع_جت, المرجع: &نص): نص {
    طابق النوع مع
    | نوع_مرجع_جت.الفرع_الافتراضي -> { أرجع رسالة(«الفرع الافتراضي», «the default branch»); }
    | _ -> { أرجع ضم([اسم_نوع_المرجع(النوع), « "», انسخ_نص(المرجع), «"»]); };
}

// يحل المرجع إلى التزام كامل. المقفول: التزام من Supax.lock يُطلب بعينه.
// بلا_شبكة: لا جلب؛ يكفي ما في المخبأ.
عام عرف حل_المرجع(
    جذر_المخبأ: &نص,
    المستودع: &نص,
    الرابط: &نص,
    النوع: نوع_مرجع_جت,
    المرجع: &نص,
    المقفول: &اختياري نص,
    بلا_شبكة: منطقي
): نتيجة نص, نص {
    جهز_المستودع(جذر_المخبأ, المستودع)؟;
    طابق انسخ_اختيار_نص(المقفول) مع
    | اختياري.موجود(الالتزام) -> {
        إذا (التزام_موجود(جذر_المخبأ, المستودع, &الالتزام)) { أرجع نتيجة.نجح(الالتزام); };
        إذا (بلا_شبكة) {
            أرجع نتيجة.خطأ(ضم([رسالة(«الالتزام », «commit »), الالتزام, رسالة(« من Supax.lock غير موجود في المخبأ، والجلب ممنوع (--offline)», « from Supax.lock is not in the cache, and fetching is disabled (--offline)»)]));
        };
        اجلب_المستودع(جذر_المخبأ, المستودع, الرابط)؟;
        إذا (!التزام_موجود(جذر_المخبأ, المستودع, &الالتزام)) {
            اجلب_التزاما(جذر_المخبأ, المستودع, الرابط, &الالتزام);
        };
        إذا (التزام_موجود(جذر_المخبأ, المستودع, &الالتزام)) { أرجع نتيجة.نجح(الالتزام); };
        أرجع نتيجة.خطأ(ضم([رسالة(«الالتزام », «commit »), الالتزام, رسالة(« المقفول في Supax.lock لم يعد موجودا في », « locked in Supax.lock no longer exists in »), انسخ_نص(الرابط)]));
    }
    | اختياري.لا_شيء -> { };
    إذا (!بلا_شبكة) {
        // التزام كامل موجود محليا لا يحتاج جلبا.
        دع كامل: منطقي = طول_النص(المرجع) >= 40;
        طابق النوع مع
        | نوع_مرجع_جت.مراجعة -> {
            إذا (كامل && التزام_موجود(جذر_المخبأ, المستودع, المرجع)) {
                أرجع نتيجة.نجح(حول_النص_إلى_صغير_أسكي(المرجع));
            };
        }
        | _ -> { };
        اجلب_المستودع(جذر_المخبأ, المستودع, الرابط)؟;
        طابق النوع مع
        | نوع_مرجع_جت.مراجعة -> {
            إذا (كامل && !التزام_موجود(جذر_المخبأ, المستودع, المرجع)) {
                اجلب_التزاما(جذر_المخبأ, المستودع, الرابط, المرجع);
            };
        }
        | _ -> { };
    };
    طابق حل_محليا(جذر_المخبأ, المستودع, النوع, المرجع) مع
    | اختياري.موجود(الالتزام) -> { أرجع نتيجة.نجح(الالتزام); }
    | اختياري.لا_شيء -> {
        إذا (بلا_شبكة) {
            أرجع نتيجة.خطأ(ضم([وصف_المرجع(النوع, المرجع), رسالة(« من », « from »), انسخ_نص(الرابط),
                رسالة(« غير موجود في المخبأ، والجلب ممنوع (--offline)», « is not in the cache, and fetching is disabled (--offline)»)]));
        };
        أرجع نتيجة.خطأ(ضم([وصف_المرجع(النوع, المرجع), رسالة(« غير موجود في », « not found in »), انسخ_نص(الرابط)]));
    };
}

// يسحب ملفات الالتزام إلى دليل فارغ دون أي إعدادات للمستخدم أو النظام.
عام عرف اسحب_الالتزام(جذر_المخبأ: &نص, المستودع: &نص, الالتزام: &نص, الهدف: &نص, ملف_الفهرس: &نص): نتيجة نص, نص {
    دع الوسائط: متجه نص = [
        ضم([«--git-dir=», انسخ_نص(المستودع)]), ضم([«--work-tree=», انسخ_نص(الهدف)]),
        «checkout», «--force», انسخ_نص(الالتزام), «--», «.»
    ];
    دع الناتج: ناتج_جت = شغل_جت(جذر_المخبأ, &الوسائط, صواب, ملف_الفهرس)؟;
    إذا (الناتج.الرمز != 0) {
        أرجع نتيجة.خطأ(ضم([رسالة(«تعذر سحب الالتزام », «cannot check out commit »), انسخ_نص(الالتزام), «: », قص_النص(&الناتج.الخطأ)]));
    };
    أرجع نتيجة.نجح(«»);
}
