// مساحة العمل (workspace): عدة حزم في مستودع واحد، بملف قفل واحد، كما في Cargo.
//
//   [workspace]
//   members = ["app", "libs/*"]      مسارات نسبية؛ «x/*» = كل دليل فيه Supax.toml تحت x
//   exclude = ["libs/old"]           اختياري
//
// البيان الجذر قد يكون حزمة أيضا ([package])، فتكون عضوا ضمنيا، أو بلا [package]
// (جذر افتراضي). Supax.lock وحده في جذر المساحة. الأعضاء تحت دليل الجذر، ولا
// يحوي بيان عضو [workspace].
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.تومل.محلل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.manifest.toml;
استورد سوباكس.manifest.manifest;

عام نوع مساحة_عمل = {
    // دليل الجذر، مطلقا.
    الجذر: نص,
    // أدلة الأعضاء، مطلقة ومرتبة. يشمل الجذر إن كان فيه [package].
    الأعضاء: متجه نص,
    // بلا [package] في الجذر.
    افتراضية: منطقي
};

// يقرأ [workspace] من Supax.toml في الدليل، أو لا شيء إن لم يوجد الجدول.
عام عرف اقرأ_مساحة_العمل(الدليل: &نص): نتيجة اختياري مساحة_عمل, نص {
    دع الاسم: نص = اسم_البيان();
    إذا (!ملف_باسم_دقيق(الدليل, &الاسم)) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
    دع المسار: نص = صل_المسار(الدليل, &الاسم);
    دع الملف: ملف_تومل = اقرأ_ملف_تومل(&المسار)؟;
    دع الوثيقة: &وثيقة_تومل = &الملف.الوثيقة;
    دع الجذر_ت: طبيعي = الملف.الوثيقة.الجذر;
    دع الجدول: طبيعي;
    طابق جدول_في_جدول(الوثيقة, الجذر_ت, «workspace») مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | اختياري.موجود(ق) -> { الجدول := ق; };
    // المفاتيح.
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        إذا (!يساوي(&المداخل[ف].المفتاح, «members») && !يساوي(&المداخل[ف].المفتاح, «exclude»)) {
            أرجع نتيجة.خطأ(ضم([موضع(&الملف, المداخل[ف].الإزاحة), رسالة(«حقل غير معروف في [workspace]: "», «unknown field in [workspace]: "»),
                انسخ_نص(&المداخل[ف].المفتاح), رسالة(«". المدعوم: members و exclude», «". Supported: members, exclude»)]));
        };
        ف := ف + 1;
    }
    // الجذر الافتراضي: لا شيء غير [workspace].
    دع له_حزمة: منطقي = مفتاح_موجود(الوثيقة, الجذر_ت, «package»);
    إذا (!له_حزمة) {
        دع العلوية: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجذر_ت);
        ف := 0;
        طالما (ف < (الطول(العلوية) مثل طبيعي)) {
            إذا (!يساوي(&العلوية[ف].المفتاح, «workspace»)) {
                أرجع نتيجة.خطأ(ضم([موضع(&الملف, العلوية[ف].الإزاحة),
                    رسالة(«بيان مساحة عمل بلا [package] لا يحوي إلا [workspace]؛ "», «a workspace manifest without [package] holds only [workspace]; "»),
                    انسخ_نص(&العلوية[ف].المفتاح), رسالة(«" ينتمي إلى حزمة عضو», «" belongs in a member package»)]));
            };
            ف := ف + 1;
        }
    };
    دع الأنماط: متجه نص;
    طابق نصوص_في_جدول(الوثيقة, الجدول, «members») مع
    | اختياري.موجود(ق) -> { الأنماط := ق; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(ضم([المسار, رسالة(«: [workspace] يحتاج members، مصفوفة مسارات مثل ["app", "libs/*"]», «: [workspace] needs members, an array of paths such as ["app", "libs/*"]»)]));
    };
    دع المستثناة_نصا: متجه نص;
    طابق نصوص_في_جدول(الوثيقة, الجدول, «exclude») مع
    | اختياري.موجود(ق) -> { المستثناة_نصا := ق; }
    | اختياري.لا_شيء -> {
        إذا (مفتاح_موجود(الوثيقة, الجدول, «exclude»)) {
            أرجع نتيجة.خطأ(ضم([المسار, رسالة(«: [workspace].exclude يجب أن يكون مصفوفة مسارات», «: [workspace].exclude must be an array of paths»)]));
        };
        المستثناة_نصا := [];
    };
    دع الجذر: نص = قانوني_أو_كما_هو(الدليل);
    دع المستثناة: متغير متجه نص = [];
    ف := 0;
    طالما (ف < (الطول(المستثناة_نصا) مثل طبيعي)) {
        ألحق(المستثناة, قانوني_أو_كما_هو(&صل_المسار(&الجذر, &المستثناة_نصا[ف])));
        ف := ف + 1;
    }
    دع الأعضاء: متغير متجه نص = [];
    إذا (له_حزمة) { ألحق(الأعضاء, انسخ_نص(&الجذر)); };
    ف := 0;
    طالما (ف < (الطول(الأنماط) مثل طبيعي)) {
        دع النمط: &نص = &الأنماط[ف];
        إذا (طول_النص(النمط) == 0 || (*النمط)[0] == 47 || يحتوي_نصا(النمط, &«..»)) {
            أرجع نتيجة.خطأ(ضم([المسار, رسالة(«: عضو مساحة العمل "», «: workspace member "»), انسخ_نص(النمط),
                رسالة(«" يجب أن يكون مسارا نسبيا تحت جذر المساحة», «" must be a relative path under the workspace root»)]));
        };
        إذا (ينتهي_بـ(النمط, &«/*»)) {
            دع الأب: نص = صل_المسار(&الجذر, &شريحة_نص(النمط, 0, طول_النص(النمط) - 2));
            طابق اقرأ_مدخلات_الدليل(&الأب) مع
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة.خطأ(ضم([المسار, رسالة(«: الدليل غير موجود في members: », «: directory in members does not exist: »), انسخ_نص(النمط)]));
            }
            | نتيجة.نجح(المداخل_د) -> {
                دع ز: متغير طبيعي = 0;
                طالما (ز < (الطول(المداخل_د) مثل طبيعي)) {
                    دع الدليل_ع: نص = صل_المسار(&الأب, &المداخل_د[ز].الاسم);
                    إذا (ملف_باسم_دقيق(&الدليل_ع, &الاسم)) {
                        أضف_عضوا(&متغير الأعضاء, قانوني_أو_كما_هو(&الدليل_ع), &المستثناة);
                    };
                    ز := ز + 1;
                }
            };
        } وإلا {
            دع الدليل_ع: نص = صل_المسار(&الجذر, النمط);
            إذا (!ملف_باسم_دقيق(&الدليل_ع, &الاسم)) {
                أرجع نتيجة.خطأ(ضم([المسار, رسالة(«: عضو مساحة العمل "», «: workspace member "»), انسخ_نص(النمط), رسالة(«" ليس فيه Supax.toml», «" has no Supax.toml»)]));
            };
            أضف_عضوا(&متغير الأعضاء, قانوني_أو_كما_هو(&الدليل_ع), &المستثناة);
        };
        ف := ف + 1;
    }
    رتب_نصوص(&متغير الأعضاء);
    // لا مساحة متداخلة.
    ف := 0;
    طالما (ف < (الطول(الأعضاء) مثل طبيعي)) {
        إذا (!نصان_متساويان(&الأعضاء[ف], &الجذر)) {
            طابق اقرأ_مساحة_العمل(&الأعضاء[ف]) مع
            | نتيجة.نجح(اختياري.موجود(_)) -> {
                أرجع نتيجة.خطأ(ضم([انسخ_نص(&الأعضاء[ف]), رسالة(«: عضو مساحة عمل لا يحوي [workspace]؛ مساحات العمل لا تتداخل», «: a workspace member cannot have its own [workspace]; workspaces do not nest»)]));
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    إذا ((الطول(الأعضاء) مثل طبيعي) == 0) {
        أرجع نتيجة.خطأ(ضم([المسار, رسالة(«: مساحة العمل بلا أعضاء», «: the workspace has no members»)]));
    };
    دع م: مساحة_عمل = { الجذر: الجذر, الأعضاء: الأعضاء, افتراضية: !له_حزمة };
    أرجع نتيجة.نجح(اختياري.موجود(م));
}

عرف قانوني_أو_كما_هو(المسار: &نص): نص {
    طابق مسار_قانوني(المسار) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { أرجع انسخ_نص(المسار); };
}

عرف أضف_عضوا(الأعضاء: &متغير متجه نص, الدليل: نص, المستثناة: &متجه نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المستثناة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المستثناة)[ف], &الدليل)) { أرجع; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*الأعضاء) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الأعضاء)[ف], &الدليل)) { أرجع; };
        ف := ف + 1;
    }
    ألحق(*الأعضاء, الدليل);
}

// مساحة العمل التي تضم الدليل: هو نفسه إن كان فيه [workspace]، وإلا أقرب
// دليل أعلى فيه [workspace]. إن وجدت مساحة أعلى لا تذكر الدليل في members
// ولا في exclude فذلك خطأ، كما في Cargo.
عام عرف ابحث_عن_مساحة_العمل(الدليل: &نص): نتيجة اختياري مساحة_عمل, نص {
    دع الحالي: متغير نص = قانوني_أو_كما_هو(الدليل);
    دع الأصل: نص = انسخ_نص(&الحالي);
    طالما (صواب) {
        دع المساحة: اختياري مساحة_عمل = اقرأ_مساحة_العمل(&الحالي)؟;
        طابق المساحة مع
        | اختياري.موجود(م) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(م.الأعضاء) مثل طبيعي)) {
                إذا (نصان_متساويان(&م.الأعضاء[ف], &الأصل)) { أرجع نتيجة.نجح(اختياري.موجود(م)); };
                ف := ف + 1;
            }
            إذا (نصان_متساويان(&م.الجذر, &الأصل)) { أرجع نتيجة.نجح(اختياري.موجود(م)); };
            // مستثنى صراحة؟
            إذا (مستثنى_في(&م.الجذر, &الأصل)) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
            أرجع نتيجة.خطأ(ضم([انسخ_نص(&الأصل), رسالة(«: الحزمة داخل مساحة العمل », «: this package is inside the workspace at »), انسخ_نص(&م.الجذر),
                رسالة(« لكنها ليست في members. أضفها إلى members أو إلى exclude», « but is not in its members. Add it to members or to exclude»)]));
        }
        | اختياري.لا_شيء -> { };
        طابق أب_المسار(&الحالي) مع
        | اختياري.موجود(الأب) -> {
            إذا (طول_النص(&الأب) == 0 || نصان_متساويان(&الأب, &الحالي)) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
            الحالي := الأب;
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
    }
    أرجع نتيجة.نجح(اختياري.لا_شيء());
}

// هل الدليل في exclude لمساحة الجذر؟
عرف مستثنى_في(الجذر: &نص, الدليل: &نص): منطقي {
    دع الاسم: نص = اسم_البيان();
    دع المسار: نص = صل_المسار(الجذر, &الاسم);
    طابق اقرأ_ملف_تومل(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(الملف) -> {
        طابق جدول_في_جدول(&الملف.الوثيقة, الملف.الوثيقة.الجذر, «workspace») مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(ج) -> {
            طابق نصوص_في_جدول(&الملف.الوثيقة, ج, «exclude») مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(القائمة) -> {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(القائمة) مثل طبيعي)) {
                    دع م: نص = قانوني_أو_كما_هو(&صل_المسار(الجذر, &القائمة[ف]));
                    إذا (نصان_متساويان(&م, الدليل) || يبدأ_بـ(الدليل, &ضم([م, «/»]))) { أرجع صواب; };
                    ف := ف + 1;
                }
                أرجع خطأ;
            };
        };
    };
}
