// قراءة ملفات TOML بمحلل المكتبة القياسية (std.toml.parser)، مع رسائل خطأ
// تذكر الملف والسطر.
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.مجموعات.متجهات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.عمليات.الوسائط;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.اخرج;
استورد المكتبة.تومل.محلل;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.أذونات;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;

عام عرف يساوي(الأول: &نص, الثاني: نص): منطقي {
    دع ب: نص = الثاني;
    أرجع نصان_متساويان(الأول, &ب);
}

عام عرف وصف_خطأ_تومل(الصنف: صنف_خطأ_تومل): نص {
    طابق الصنف مع
    | صنف_خطأ_تومل.نهاية_غير_متوقعة -> { أرجع رسالة(«نهاية غير متوقعة للملف», «unexpected end of file»); }
    | صنف_خطأ_تومل.رمز_غير_متوقع -> { أرجع رسالة(«رمز غير متوقع», «unexpected token»); }
    | صنف_خطأ_تومل.مفتاح_غير_صالح -> { أرجع رسالة(«مفتاح غير صالح», «invalid key»); }
    | صنف_خطأ_تومل.قيمة_غير_صالحة -> { أرجع رسالة(«قيمة غير صالحة», «invalid value»); }
    | صنف_خطأ_تومل.هروب_غير_صالح -> { أرجع رسالة(«تسلسل هروب غير صالح», «invalid escape sequence»); }
    | صنف_خطأ_تومل.يونيكود_غير_صالح -> { أرجع رسالة(«ترميز يونيكود غير صالح», «invalid Unicode encoding»); }
    | صنف_خطأ_تومل.مفتاح_مكرر -> { أرجع رسالة(«مفتاح مكرر», «duplicate key»); }
    | صنف_خطأ_تومل.جدول_مكرر -> { أرجع رسالة(«جدول مكرر», «duplicate table»); }
    | صنف_خطأ_تومل.تعارض_نوع -> { أرجع رسالة(«المفتاح معرّف بنوع آخر», «key is already defined with another type»); }
    | صنف_خطأ_تومل.جدول_ضمني_مغلق -> { أرجع رسالة(«لا يمكن توسيع جدول مضمّن», «an inline table cannot be extended»); }
    | صنف_خطأ_تومل.نص_لاحق -> { أرجع رسالة(«نص زائد بعد القيمة», «trailing text after the value»); }
    | صنف_خطأ_تومل.تعشيش_عميق_جدا -> { أرجع رسالة(«تعشيش عميق جدا», «nesting is too deep»); };
}

// المفاتيح غير المقتبسة في TOML لا تقبل إلا A-Z و a-z و 0-9 و _ و -، فالمفتاح
// العربي يُكتب بين علامتي تنصيص. إن بدأ سطر الخطأ بمفتاح غير لاتيني غير
// مقتبس، يُقترح السطر مصححا.
عرف تلميح_مفتاح_غير_لاتيني(النص: &نص, الإزاحة: طبيعي): نص {
    دع البداية: متغير طبيعي = الإزاحة;
    إذا (البداية > طول_النص(النص)) { البداية := طول_النص(النص); };
    طالما (البداية > 0 && (*النص)[البداية - 1] != 10) { البداية := البداية - 1; }
    دع النهاية: طبيعي = موضع_بايت(النص, 10, البداية);
    دع السطر: نص = شريحة_نص(النص, البداية, النهاية);
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(&السطر) && (السطر[ف] == 32 || السطر[ف] == 9)) { ف := ف + 1; }
    دع بداية_المفتاح: طبيعي = ف;
    دع فيه_غير_لاتيني: متغير منطقي = خطأ;
    طالما (ف < طول_النص(&السطر) && السطر[ف] != 61 && السطر[ف] != 32 && السطر[ف] != 9 && السطر[ف] != 46) {
        إذا (السطر[ف] >= 128) { فيه_غير_لاتيني := صواب; };
        إذا (السطر[ف] == 34 || السطر[ف] == 39) { أرجع «»; };
        ف := ف + 1;
    }
    إذا (!فيه_غير_لاتيني) { أرجع «»; };
    دع المفتاح: نص = شريحة_نص(&السطر, بداية_المفتاح, ف);
    دع الباقي: نص = شريحة_نص(&السطر, ف, طول_النص(&السطر));
    أرجع ضم([
        سطر_جديد(),
        رسالة(«  المفاتيح العربية تُكتب بين علامتي تنصيص في TOML:», «  non-Latin keys must be quoted in TOML:»),
        سطر_جديد(), «    "», المفتاح, «"», الباقي
    ]);
}

// قيمة نصية بلا علامتي تنصيص (version = 0.1.0): يُقترح السطر مصححا.
عرف تلميح_قيمة_بلا_تنصيص(النص: &نص, الإزاحة: طبيعي, الصنف: صنف_خطأ_تومل): نص {
    طابق الصنف مع
    | صنف_خطأ_تومل.قيمة_غير_صالحة -> { }
    | صنف_خطأ_تومل.نص_لاحق -> { }
    | _ -> { أرجع «»; };
    دع البداية: متغير طبيعي = الإزاحة;
    إذا (البداية > طول_النص(النص)) { البداية := طول_النص(النص); };
    طالما (البداية > 0 && (*النص)[البداية - 1] != 10) { البداية := البداية - 1; }
    دع النهاية: طبيعي = موضع_بايت(النص, 10, البداية);
    دع السطر: نص = شريحة_نص(النص, البداية, النهاية);
    دع المساواة: طبيعي = موضع_بايت(&السطر, 61, 0);
    إذا (المساواة >= طول_النص(&السطر)) { أرجع «»; };
    دع ف: متغير طبيعي = المساواة + 1;
    طالما (ف < طول_النص(&السطر) && (السطر[ف] == 32 || السطر[ف] == 9)) { ف := ف + 1; }
    إذا (ف >= طول_النص(&السطر)) { أرجع «»; };
    دع أول: ط8 = السطر[ف];
    إذا (أول == 34 || أول == 39 || أول == 91 || أول == 123) { أرجع «»; };
    دع ن: متغير طبيعي = طول_النص(&السطر);
    طالما (ن > ف && (السطر[ن - 1] == 32 || السطر[ن - 1] == 9 || السطر[ن - 1] == 13)) { ن := ن - 1; }
    دع القيمة: نص = شريحة_نص(&السطر, ف, ن);
    أرجع ضم([
        سطر_جديد(),
        رسالة(«  إن كانت القيمة نصا فاكتبها بين علامتي تنصيص:», «  if the value is text, put it in quotes:»),
        سطر_جديد(), «    », شريحة_نص(&السطر, 0, ف), «"», القيمة, «"»
    ]);
}

// وثيقة مقروءة مع نصها، لحساب أرقام الأسطر من الإزاحات.
عام نوع ملف_تومل = { المسار: نص, النص: نص, الوثيقة: وثيقة_تومل };

عام عرف اقرأ_ملف_تومل(المسار: &نص): نتيجة ملف_تومل, نص {
    دع النص: نص;
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«تعذرت قراءة الملف », «cannot read file »), انسخ_نص(المسار)])); }
    | نتيجة.نجح(القيمة) -> { النص := القيمة; };
    طابق حلل_تومل(&النص) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(ضم([
            انسخ_نص(المسار), «:», رقم_نصا(سطر_الإزاحة(&النص, الخطأ.الإزاحة)), «: »,
            وصف_خطأ_تومل(الخطأ.الصنف), تلميح_مفتاح_غير_لاتيني(&النص, الخطأ.الإزاحة), تلميح_قيمة_بلا_تنصيص(&النص, الخطأ.الإزاحة, الخطأ.الصنف)
        ]));
    }
    | نتيجة.نجح(الوثيقة) -> {
        دع الملف: ملف_تومل = { المسار: انسخ_نص(المسار), النص: النص, الوثيقة: الوثيقة };
        أرجع نتيجة.نجح(الملف);
    };
}

// «ملف:سطر: » لإزاحة في الملف.
عام عرف موضع(الملف: &ملف_تومل, الإزاحة: طبيعي): نص {
    أرجع ضم([انسخ_نص(&(*الملف).المسار), «:», رقم_نصا(سطر_الإزاحة(&(*الملف).النص, الإزاحة)), «: »]);
}

عام عرف قيمة_نصية(القيمة: &قيمة_تومل): اختياري نص {
    طابق *القيمة مع
    | قيمة_تومل.سلسلة(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف قيمة_جدول(القيمة: &قيمة_تومل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تومل.جدول(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف قيمة_مصفوفة(القيمة: &قيمة_تومل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تومل.مصفوفة(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف قيمة_عددية(القيمة: &قيمة_تومل): اختياري نص {
    طابق *القيمة مع
    | قيمة_تومل.عدد(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// قيمة مفتاح في جدول، بالنص.
عام عرف نص_في_جدول(الوثيقة: &وثيقة_تومل, الجدول: طبيعي, المفتاح: نص): اختياري نص {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع قيمة_نصية(&القيمة); };
}

عام عرف جدول_في_جدول(الوثيقة: &وثيقة_تومل, الجدول: طبيعي, المفتاح: نص): اختياري طبيعي {
    دع الاسم: نص = المفتاح;
    أرجع جدول_مفتاح_تومل(الوثيقة, الجدول, &الاسم);
}

عام عرف مفتاح_موجود(الوثيقة: &وثيقة_تومل, الجدول: طبيعي, المفتاح: نص): منطقي {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { أرجع صواب; };
}

// نصوص مصفوفة مفتاح؛ لا_شيء إن لم يكن المفتاح مصفوفة نصوص.
عام عرف نصوص_في_جدول(الوثيقة: &وثيقة_تومل, الجدول: طبيعي, المفتاح: نص): اختياري متجه نص {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق قيمة_مصفوفة(&القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الفهرس) -> {
            دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
            دع الناتج: متغير متجه نص = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القيم) مثل طبيعي)) {
                طابق قيمة_نصية(&القيم[ف]) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(النص) -> { ألحق(الناتج, النص); };
                ف := ف + 1;
            }
            أرجع اختياري.موجود(الناتج);
        };
    };
}
