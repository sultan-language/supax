// قراءة Supax.toml والتحقق من كل قواعده. المترجم لا يقرأ هذا الملف؛ يقرأ
// مخطط الحزم الذي يكتبه سوباكس (resolve/package_graph.sn)، فالقواعد هنا هي
// قواعد compiler/driver/package_manifest.sn نفسها: الحقول وأنواعها، والتهجئات،
// ومرادفات الاستيراد، ومفاتيح الاعتماديات ومساراتها، وقواعد [lib].
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.مجموعات.متجهات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.عمليات.الوسائط;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.اخرج;
استورد المكتبة.تومل.محلل;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.أذونات;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;
استورد سوباكس.support.names;
استورد سوباكس.manifest.toml;
استورد سوباكس.registry.requirement;

عام عرف اسم_البيان(): نص { أرجع «Supax.toml»; }

عام عرف اسم_بيان_البناء(): نص { أرجع «supax.toml»; }

عام نوع نوع_مرجع_جت =
    | الفرع_الافتراضي
    | وسم
    | فرع
    | مراجعة
;

عام نوع اعتمادية = {
    الاسم: نص,
    // واحد منهما فقط موجود.
    المسار: اختياري نص,
    الجت: اختياري نص,
    نوع_المرجع: نوع_مرجع_جت,
    المرجع: نص,
    // متطلب إصدار من فهرس الحزم ("1.2"، "^1.2.3"…)، بدل path وgit.
    الإصدار_المطلوب: اختياري نص,
    الموضع: نص
};

عام نوع تهجئة = { اللغة: نص, التهجئة: نص };

// [imports-alias]: المسار المقنن (منقط كما كُتب) وتهجئاته لكل لغة.
عام نوع مرادف_استيراد = { المسار: نص, التهجئات: متجه تهجئة };

عام نوع بيان = {
    المسار: نص,
    الدليل: نص,
    الاسم: نص,
    الإصدار: اختياري نص,
    له_مكتبة: منطقي,
    // دليل المصدر: دليل [lib]، أو دليل البيان إن لم يُعلن [lib]. مسار مطلق.
    جذر_المصدر: نص,
    // إن أشار [lib] path إلى ملف: اسم وحدته (اسم الملف بلا .sn).
    المدخل: اختياري نص,
    الأسماء: متجه تهجئة,
    المرادفات: متجه مرادف_استيراد,
    الاعتماديات: متجه اعتمادية,
    // [dev-dependencies]: للاختبارات وحدها، ولا تُقرأ إلا للحزم الجذر.
    اعتماديات_التطوير: متجه اعتمادية
};

عام عرف اسم_نوع_المرجع(النوع: نوع_مرجع_جت): نص {
    طابق النوع مع
    | نوع_مرجع_جت.وسم -> { أرجع «tag»; }
    | نوع_مرجع_جت.فرع -> { أرجع «branch»; }
    | نوع_مرجع_جت.مراجعة -> { أرجع «rev»; }
    | نوع_مرجع_جت.الفرع_الافتراضي -> { أرجع «default-branch»; };
}

// هل في الدليل ملف بهذا الاسم بحالة الأحرف نفسها؟ أنظمة الملفات غير الحساسة
// لحالة الأحرف تجعل supax.toml وSupax.toml اسما واحدا لولا هذا الفحص.
عام عرف ملف_باسم_دقيق(الدليل: &نص, الاسم: &نص): منطقي {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            إذا (نصان_متساويان(&المداخل[ف].الاسم, الاسم)) {
                طابق المداخل[ف].النوع مع
                | نوع_مدخل_دليل.ملف -> { أرجع صواب; }
                | _ -> { أرجع خطأ; };
            };
            ف := ف + 1;
        }
        أرجع خطأ;
    };
}

// مرجع جت مسموح: لا يبدأ بـ «-» ولا «/», ولا يحوي «..» ولا «@{» ولا محارف
// تحكم أو مسافات أو ~ ^ : ? * [ \. المراجعة أرقام ست عشرية (7 إلى 64).
عام عرف مرجع_جت_آمن(النوع: نوع_مرجع_جت, المرجع: &نص): منطقي {
    دع الطول_الكلي: طبيعي = طول_النص(المرجع);
    إذا (الطول_الكلي == 0 || الطول_الكلي > 255) { أرجع خطأ; };
    طابق النوع مع
    | نوع_مرجع_جت.مراجعة -> {
        إذا (الطول_الكلي < 7 || الطول_الكلي > 64) { أرجع خطأ; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < الطول_الكلي) {
            دع ب: ط8 = (*المرجع)[ف];
            إذا (!((ب >= 48 && ب <= 57) || (ب >= 97 && ب <= 102) || (ب >= 65 && ب <= 70))) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | _ -> { };
    إذا ((*المرجع)[0] == 45 || (*المرجع)[0] == 47 || (*المرجع)[الطول_الكلي - 1] == 47 || (*المرجع)[الطول_الكلي - 1] == 46) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي) {
        دع ب: ط8 = (*المرجع)[ف];
        إذا (ب <= 32 || ب == 127 || ب == 126 || ب == 94 || ب == 58 || ب == 63 || ب == 42 || ب == 91 || ب == 92) {
            أرجع خطأ;
        };
        إذا (ف + 1 < الطول_الكلي) {
            دع التالي: ط8 = (*المرجع)[ف + 1];
            إذا ((ب == 46 && التالي == 46) || (ب == 64 && التالي == 123) || (ب == 47 && التالي == 47)) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اقرأ_اعتمادية(
    الملف: &ملف_تومل,
    الاسم: &نص,
    القيمة: &قيمة_تومل,
    الإزاحة: طبيعي,
    التحقق_من_الرابط: دالة(&نص): نتيجة نص, نص
): نتيجة اعتمادية, نص {
    دع الموضع_النصي: نص = موضع(الملف, الإزاحة);
    إذا (!معرف_صالح(الاسم)) {
        أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«اسم الاعتمادية "», «dependency name "»), انسخ_نص(الاسم), رسالة(«" يحوي محارف غير مسموحة في أسماء الحزم», «" contains characters that are not allowed in package names»)]));
    };
    دع الجدول: طبيعي;
    طابق قيمة_جدول(القيمة) مع
    | اختياري.موجود(الفهرس) -> { الجدول := الفهرس; }
    | اختياري.لا_شيء -> {
        طابق قيمة_نصية(القيمة) مع
        | اختياري.موجود(المتطلب) -> {
            أرجع اعتمادية_سجل(الاسم, &المتطلب, الموضع_النصي);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم), رسالة(«" يجب أن تكون جدولا», «" must be a table»)]));
        };
    };
    دع الوثيقة: &وثيقة_تومل = &(*الملف).الوثيقة;
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع المفتاح: &نص = &المداخل[ف].المفتاح;
        إذا (!يساوي(المفتاح, «path») && !يساوي(المفتاح, «git») && !يساوي(المفتاح, «tag»)
            && !يساوي(المفتاح, «branch») && !يساوي(المفتاح, «rev») && !يساوي(المفتاح, «version»)) {
            أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم),
                رسالة(«" فيها حقل غير معروف "», «" has an unknown field "»), انسخ_نص(المفتاح), «"»]));
        };
        طابق قيمة_نصية(&المداخل[ف].القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«الحقل "», «field "»), انسخ_نص(المفتاح),
                رسالة(«" في الاعتمادية "», «" of dependency "»), انسخ_نص(الاسم), رسالة(«" يجب أن يكون نصا», «" must be a string»)]));
        }
        | اختياري.موجود(_) -> { };
        ف := ف + 1;
    }
    دع المسار: اختياري نص = نص_في_جدول(الوثيقة, الجدول, «path»);
    دع الجت: اختياري نص = نص_في_جدول(الوثيقة, الجدول, «git»);
    دع الوسم: اختياري نص = نص_في_جدول(الوثيقة, الجدول, «tag»);
    دع الفرع: اختياري نص = نص_في_جدول(الوثيقة, الجدول, «branch»);
    دع المراجعة: اختياري نص = نص_في_جدول(الوثيقة, الجدول, «rev»);
    دع المحددات: متغير طبيعي = 0;
    دع نوع_المرجع: متغير نوع_مرجع_جت = نوع_مرجع_جت.الفرع_الافتراضي();
    دع المرجع: متغير نص = «»;
    طابق الوسم مع | اختياري.موجود(ق) -> { المحددات := المحددات + 1; نوع_المرجع := نوع_مرجع_جت.وسم(); المرجع := ق; } | اختياري.لا_شيء -> { };
    طابق الفرع مع | اختياري.موجود(ق) -> { المحددات := المحددات + 1; نوع_المرجع := نوع_مرجع_جت.فرع(); المرجع := ق; } | اختياري.لا_شيء -> { };
    طابق المراجعة مع | اختياري.موجود(ق) -> { المحددات := المحددات + 1; نوع_المرجع := نوع_مرجع_جت.مراجعة(); المرجع := ق; } | اختياري.لا_شيء -> { };
    دع له_مسار: منطقي = مفتاح_موجود(الوثيقة, الجدول, «path»);
    دع له_جت: منطقي = مفتاح_موجود(الوثيقة, الجدول, «git»);
    طابق نص_في_جدول(الوثيقة, الجدول, «version») مع
    | اختياري.موجود(المتطلب) -> {
        إذا (له_مسار || له_جت || المحددات != 0) {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم),
                رسالة(«" تحتاج واحدا فقط من "version" أو "path" أو "git"», «" needs exactly one of "version", "path" or "git"»)]));
        };
        أرجع اعتمادية_سجل(الاسم, &المتطلب, الموضع_النصي);
    }
    | اختياري.لا_شيء -> { };
    إذا (له_مسار == له_جت) {
        أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم), رسالة(«" تحتاج واحدا فقط من "version" أو "path" أو "git"», «" needs exactly one of "version", "path" or "git"»)]));
    };
    إذا (له_مسار && المحددات != 0) {
        أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم),
            رسالة(«": الحقول "tag" و"branch" و"rev" خاصة باعتماديات git», «": "tag", "branch" and "rev" apply only to git dependencies»)]));
    };
    إذا (المحددات > 1) {
        أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم),
            رسالة(«" تحدد أكثر من واحد من "tag" و"branch" و"rev"», «" names more than one of "tag", "branch" and "rev"»)]));
    };
    طابق انسخ_اختيار_نص(&المسار) مع
    | اختياري.موجود(ق) -> {
        إذا (مسار_مطلق(&ق) || طول_النص(&ق) == 0 || ق[0] == 47 || ق[0] == 92) {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«مسار الاعتمادية "», «path of dependency "»), انسخ_نص(الاسم), رسالة(«" يجب أن يكون نسبيا إلى البيان», «" must be relative to the manifest»)]));
        };
    }
    | اختياري.لا_شيء -> { };
    طابق انسخ_اختيار_نص(&الجت) مع
    | اختياري.موجود(الرابط) -> {
        إذا (المحددات == 1 && !مرجع_جت_آمن(نوع_المرجع, &المرجع)) {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم), رسالة(«" فيها قيمة "», «" has an invalid "»),
                اسم_نوع_المرجع(نوع_المرجع), رسالة(«" غير صالحة: », «" value: »), انسخ_نص(&المرجع)]));
        };
        طابق التحقق_من_الرابط(&الرابط) مع
        | نتيجة.خطأ(السبب) -> {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم), «": », السبب]));
        }
        | نتيجة.نجح(_) -> { };
    }
    | اختياري.لا_شيء -> { };
    دع الناتج: اعتمادية = {
        الاسم: انسخ_نص(الاسم),
        المسار: المسار,
        الجت: الجت,
        نوع_المرجع: نوع_المرجع,
        المرجع: المرجع,
        الإصدار_المطلوب: اختياري.لا_شيء(),
        الموضع: الموضع_النصي
    };
    أرجع نتيجة.نجح(الناتج);
}

// اعتمادية من فهرس الحزم: يُتحقق من صيغة المتطلب هنا.
عرف اعتمادية_سجل(الاسم: &نص, المتطلب: &نص, الموضع_النصي: نص): نتيجة اعتمادية, نص {
    طابق حلل_متطلبا(المتطلب) مع
    | نتيجة.خطأ(السبب) -> {
        أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«الاعتمادية "», «dependency "»), انسخ_نص(الاسم), «": », السبب]));
    }
    | نتيجة.نجح(_) -> { };
    دع الناتج: اعتمادية = {
        الاسم: انسخ_نص(الاسم),
        المسار: اختياري.لا_شيء(),
        الجت: اختياري.لا_شيء(),
        نوع_المرجع: نوع_مرجع_جت.الفرع_الافتراضي(),
        المرجع: «»,
        الإصدار_المطلوب: اختياري.موجود(قص_النص(المتطلب)),
        الموضع: الموضع_النصي
    };
    أرجع نتيجة.نجح(الناتج);
}

// يقرأ Supax.toml من الدليل. التحقق_من_الرابط يتحقق من روابط git (من وحدة
// الجت) دون أن تعتمد هذه الوحدة عليها.
// جدول اعتماديات ([dependencies] أو [dev-dependencies])؛ غيابه قائمة فارغة.
عرف اقرأ_جدول_اعتماديات(
    الملف: &ملف_تومل,
    مسار_البيان: &نص,
    المفتاح: نص,
    التحقق_من_الرابط: دالة(&نص): نتيجة نص, نص
): نتيجة متجه اعتمادية, نص {
    دع الوثيقة: &وثيقة_تومل = &(*الملف).الوثيقة;
    دع الجذر: طبيعي = (*الملف).الوثيقة.الجذر;
    دع الاعتماديات: متغير متجه اعتمادية = [];
    طابق جدول_في_جدول(الوثيقة, الجذر, انسخ_نص(&المفتاح)) مع
    | اختياري.لا_شيء -> {
        إذا (مفتاح_موجود(الوثيقة, الجذر, انسخ_نص(&المفتاح))) {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(مسار_البيان), «: [», انسخ_نص(&المفتاح), «]», رسالة(« يجب أن يكون جدولا», « must be a table»)]));
        };
    }
    | اختياري.موجود(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(المداخل) مثل طبيعي)) {
            دع الاعتمادية: اعتمادية = اقرأ_اعتمادية(
                الملف, &المداخل[ح].المفتاح, &المداخل[ح].القيمة, المداخل[ح].الإزاحة, التحقق_من_الرابط
            )؟;
            ألحق(الاعتماديات, الاعتمادية);
            ح := ح + 1;
        }
    };
    أرجع نتيجة.نجح(الاعتماديات);
}

عام عرف اقرأ_البيان(
    الدليل: &نص,
    التحقق_من_الرابط: دالة(&نص): نتيجة نص, نص
): نتيجة بيان, نص {
    دع اسم_ب: نص = اسم_البيان();
    دع اسم_ب_بناء: نص = اسم_بيان_البناء();
    دع مسار_البيان: نص = صل_المسار(الدليل, &اسم_ب);
    إذا (!ملف_باسم_دقيق(الدليل, &اسم_ب)) {
        إذا (ملف_باسم_دقيق(الدليل, &اسم_ب_بناء)) {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(الدليل),
                رسالة(«: فيه supax.toml (بيان بناء لسوباكس)؛ حزم السلطان تستخدم Supax.toml وفيه الجدول [package]», «: has supax.toml (a Supax build manifest); SultanC packages use Supax.toml with a [package] table»)]));
        };
        أرجع نتيجة.خطأ(ضم([انسخ_نص(الدليل), رسالة(«: لا يوجد Supax.toml», «: no Supax.toml»)]));
    };
    دع الملف: ملف_تومل = اقرأ_ملف_تومل(&مسار_البيان)؟;
    دع الوثيقة: &وثيقة_تومل = &الملف.الوثيقة;
    دع الجذر: طبيعي = الملف.الوثيقة.الجذر;
    دع العلوية: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجذر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العلوية) مثل طبيعي)) {
        دع المفتاح: &نص = &العلوية[ف].المفتاح;
        إذا (!يساوي(المفتاح, «package») && !يساوي(المفتاح, «dependencies») && !يساوي(المفتاح, «dev-dependencies»)
            && !يساوي(المفتاح, «lib») && !يساوي(المفتاح, «imports-alias») && !يساوي(المفتاح, «workspace»)) {
            إذا (يساوي(المفتاح, «project»)) {
                أرجع نتيجة.خطأ(ضم([موضع(&الملف, العلوية[ف].الإزاحة),
                    رسالة(«الجدول [project] خاص ببيانات البناء supax.toml؛ حزم السلطان تستخدم [package]», «[project] belongs to supax.toml build manifests; SultanC packages use [package]»)]));
            };
            أرجع نتيجة.خطأ(ضم([موضع(&الملف, العلوية[ف].الإزاحة), رسالة(«جدول علوي غير مدعوم "», «unsupported top-level table "»), انسخ_نص(المفتاح), «"»]));
        };
        ف := ف + 1;
    }
    دع جدول_الحزمة: طبيعي;
    طابق جدول_في_جدول(الوثيقة, الجذر, «package») مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([مسار_البيان, رسالة(«: الجدول [package] مفقود», «: missing [package] table»)])); }
    | اختياري.موجود(ق) -> { جدول_الحزمة := ق; };
    إذا (مفتاح_موجود(الوثيقة, جدول_الحزمة, «build»)) {
        أرجع نتيجة.خطأ(ضم([مسار_البيان, رسالة(«: الحقل [package].build غير مدعوم؛ سوباكس لا يشغّل نصوص بناء الحزم أبدا», «: [package].build is not supported; Supax never runs package build scripts»)]));
    };
    دع الاسم: نص;
    طابق نص_في_جدول(الوثيقة, جدول_الحزمة, «name») مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([مسار_البيان, رسالة(«: الحقل [package].name مفقود أو ليس نصا», «: [package].name is missing or is not a string»)])); }
    | اختياري.موجود(ق) -> { الاسم := ق; };
    إذا (!معرف_صالح(&الاسم)) {
        أرجع نتيجة.خطأ(ضم([مسار_البيان, رسالة(«: اسم الحزمة "», «: package name "»), الاسم,
            رسالة(«" ليس معرفا صالحا (حروف وأرقام و_ فقط، ويبدأ بحرف)», «" is not a valid identifier (letters, digits and _, starting with a letter)»)]));
    };
    تحقق_حقول_الحزمة(&الملف, جدول_الحزمة)؟;
    دع الأسماء: متغير متجه تهجئة = [];
    طابق جدول_في_جدول(الوثيقة, جدول_الحزمة, «names») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(جدول_الأسماء) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, جدول_الأسماء);
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(المداخل) مثل طبيعي)) {
            إذا (طول_النص(&المداخل[ح].المفتاح) == 0) {
                أرجع نتيجة.خطأ(ضم([موضع(&الملف, المداخل[ح].الإزاحة), رسالة(«اسم اللغة في [package.names] فارغ», «empty language name in [package.names]»)]));
            };
            طابق قيمة_نصية(&المداخل[ح].القيمة) مع
            | اختياري.موجود(التهجئة) -> {
                إذا (!معرف_صالح(&التهجئة)) {
                    أرجع نتيجة.خطأ(ضم([موضع(&الملف, المداخل[ح].الإزاحة), رسالة(«التهجئة "», «spelling "»), التهجئة, رسالة(«" ليست اسم حزمة صالحا», «" is not a valid package name»)]));
                };
                دع ت: تهجئة = { اللغة: انسخ_نص(&المداخل[ح].المفتاح), التهجئة: التهجئة };
                ألحق(الأسماء, ت);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([موضع(&الملف, المداخل[ح].الإزاحة), رسالة(«قيم [package.names] يجب أن تكون نصوصا», «[package.names] values must be strings»)]));
            };
            ح := ح + 1;
        }
    };
    إذا (مفتاح_موجود(الوثيقة, جدول_الحزمة, «names»)) {
        طابق جدول_في_جدول(الوثيقة, جدول_الحزمة, «names») مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([مسار_البيان, رسالة(«: [package.names] يجب أن يكون جدولا», «: [package.names] must be a table»)])); }
        | اختياري.موجود(_) -> { };
    };
    دع الاعتماديات: متجه اعتمادية = اقرأ_جدول_اعتماديات(&الملف, &مسار_البيان, «dependencies», التحقق_من_الرابط)؟;
    دع اعتماديات_التطوير: متجه اعتمادية = اقرأ_جدول_اعتماديات(&الملف, &مسار_البيان, «dev-dependencies», التحقق_من_الرابط)؟;
    // المفتاح نفسه في الجدولين: اسمان لحزمتين قد تختلفان تحت مستورد واحد.
    دع ط: متغير طبيعي = 0;
    طالما (ط < (الطول(اعتماديات_التطوير) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الاعتماديات) مثل طبيعي)) {
            إذا (نصان_متساويان(&اعتماديات_التطوير[ط].الاسم, &الاعتماديات[ع].الاسم)) {
                أرجع نتيجة.خطأ(ضم([مسار_البيان, رسالة(«: الاعتمادية "», «: the dependency "»), انسخ_نص(&الاعتماديات[ع].الاسم),
                    رسالة(«" في [dependencies] و[dev-dependencies] معا؛ أبقها في [dependencies] فهي متاحة للاختبارات أيضا»,
                        «" is in both [dependencies] and [dev-dependencies]; keep it in [dependencies], which the tests can use too»)]));
            };
            ع := ع + 1;
        }
        ط := ط + 1;
    }
    دع الإصدار: اختياري نص = نص_في_جدول(الوثيقة, جدول_الحزمة, «version»);
    دع له_مكتبة: منطقي = مفتاح_موجود(الوثيقة, الجذر, «lib»);
    دع المكتبة: هدف_مكتبة = اقرأ_المكتبة(&الملف, الدليل)؟;
    دع المرادفات: متجه مرادف_استيراد = اقرأ_المرادفات(&الملف)؟;
    تحقق_المرادفات(&المرادفات, &المكتبة.الجذر, &مسار_البيان)؟;
    دع الناتج: بيان = {
        المسار: مسار_البيان,
        الدليل: انسخ_نص(الدليل),
        الاسم: الاسم,
        الإصدار: الإصدار,
        له_مكتبة: له_مكتبة,
        جذر_المصدر: انسخ_نص(&المكتبة.الجذر),
        المدخل: انسخ_اختيار_نص(&المكتبة.المدخل),
        الأسماء: الأسماء,
        المرادفات: المرادفات,
        الاعتماديات: الاعتماديات,
        اعتماديات_التطوير: اعتماديات_التطوير
    };
    أرجع نتيجة.نجح(الناتج);
}

// ---------------------------------------------------------------------
// [package]: الحقول المعروفة وأنواعها

عرف حقل_حزمة_معروف(المفتاح: &نص): منطقي {
    أرجع يساوي(المفتاح, «name») || يساوي(المفتاح, «version») || يساوي(المفتاح, «authors»)
        || يساوي(المفتاح, «description») || يساوي(المفتاح, «homepage») || يساوي(المفتاح, «repository»)
        || يساوي(المفتاح, «readme») || يساوي(المفتاح, «keywords») || يساوي(المفتاح, «license»)
        || يساوي(المفتاح, «names») || يساوي(المفتاح, «metadata»);
}

عرف تحقق_حقول_الحزمة(الملف: &ملف_تومل, الجدول: طبيعي): نتيجة نص, نص {
    دع الوثيقة: &وثيقة_تومل = &(*الملف).الوثيقة;
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع المفتاح: &نص = &المداخل[ف].المفتاح;
        إذا (!حقل_حزمة_معروف(المفتاح)) {
            إذا (يساوي(المفتاح, «edition») || يساوي(المفتاح, «sultanc-version»)) {
                أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«الحقل [package].», «[package].»), انسخ_نص(المفتاح),
                    رسالة(« معروف لكنه غير مدعوم بعد», « is known but not supported yet»)]));
            };
            إذا (!يساوي(المفتاح, «build»)) {
                أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«حقل غير معروف في [package]: », «unknown field in [package]: »), انسخ_نص(المفتاح)]));
            };
        };
        دع نصي: منطقي = يساوي(المفتاح, «name») || يساوي(المفتاح, «version») || يساوي(المفتاح, «description»)
            || يساوي(المفتاح, «homepage») || يساوي(المفتاح, «repository») || يساوي(المفتاح, «readme»)
            || يساوي(المفتاح, «license»);
        إذا (نصي) {
            طابق قيمة_نصية(&المداخل[ف].القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«الحقل [package].», «[package].»), انسخ_نص(المفتاح),
                    رسالة(« يجب أن يكون نصا», « must be a string»)]));
            }
            | اختياري.موجود(_) -> { };
        };
        إذا (يساوي(المفتاح, «authors») || يساوي(المفتاح, «keywords»)) {
            طابق نصوص_في_جدول(الوثيقة, الجدول, انسخ_نص(المفتاح)) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«الحقل [package].», «[package].»), انسخ_نص(المفتاح),
                    رسالة(« يجب أن يكون مصفوفة نصوص», « must be an array of strings»)]));
            }
            | اختياري.موجود(_) -> { };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(«»);
}

// ---------------------------------------------------------------------
// [lib]

عام نوع هدف_مكتبة = { الجذر: نص, المدخل: اختياري نص };

عرف نوع_المسار_هنا(المسار: &نص): عدد {
    طابق حاول_مسار_دليل(المسار) مع
    | نتيجة.نجح(صواب) -> { أرجع 1; }
    | _ -> { };
    طابق حاول_مسار_ملف(المسار) مع
    | نتيجة.نجح(صواب) -> { أرجع 2; }
    | _ -> { };
    طابق حاول_وجود_المسار(المسار) مع
    | نتيجة.نجح(صواب) -> { أرجع 3; }
    | _ -> { أرجع 0; };
}

عرف قانوني_أو_كما_هو(المسار: &نص): نص {
    طابق مسار_قانوني(المسار) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { أرجع انسخ_نص(المسار); };
}

// جذر المصدر ومدخل المكتبة. بلا [lib]: دليل البيان، ولا مدخل.
عرف اقرأ_المكتبة(الملف: &ملف_تومل, الدليل: &نص): نتيجة هدف_مكتبة, نص {
    دع الوثيقة: &وثيقة_تومل = &(*الملف).الوثيقة;
    دع الجذر: طبيعي = (*الملف).الوثيقة.الجذر;
    دع بلا_مدخل: اختياري نص = اختياري.لا_شيء();
    إذا (!مفتاح_موجود(الوثيقة, الجذر, «lib»)) {
        دع ه: هدف_مكتبة = { الجذر: قانوني_أو_كما_هو(الدليل), المدخل: بلا_مدخل };
        أرجع نتيجة.نجح(ه);
    };
    دع الجدول: طبيعي;
    طابق جدول_في_جدول(الوثيقة, الجذر, «lib») مع
    | اختياري.موجود(ق) -> { الجدول := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: [lib] يجب أن يكون جدولا», «: [lib] must be a table»)])); };
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        إذا (!يساوي(&المداخل[ف].المفتاح, «path»)) {
            أرجع نتيجة.خطأ(ضم([موضع(الملف, المداخل[ف].الإزاحة), رسالة(«حقل غير معروف في [lib]: », «unknown field in [lib]: »),
                انسخ_نص(&المداخل[ف].المفتاح), رسالة(« (المسموح: path)», « (allowed: path)»)]));
        };
        ف := ف + 1;
    }
    دع النسبي: متغير نص = «.»;
    إذا (مفتاح_موجود(الوثيقة, الجدول, «path»)) {
        طابق نص_في_جدول(الوثيقة, الجدول, «path») مع
        | اختياري.موجود(ق) -> { النسبي := ق; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: [lib].path يجب أن يكون نصا», «: [lib].path must be a string»)])); };
    };
    إذا (مسار_مطلق(&النسبي) || طول_النص(&النسبي) == 0) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: [lib].path يجب أن يكون نسبيا إلى البيان», «: [lib].path must be relative to the manifest»)]));
    };
    دع المحلول: نص = صل_المسار(الدليل, &النسبي);
    دع النوع: عدد = نوع_المسار_هنا(&المحلول);
    إذا (النوع == 0) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: مسار [lib] غير موجود: », «: the [lib] path does not exist: »), النسبي]));
    };
    إذا (النوع == 1) {
        دع ه: هدف_مكتبة = { الجذر: قانوني_أو_كما_هو(&المحلول), المدخل: بلا_مدخل };
        أرجع نتيجة.نجح(ه);
    };
    إذا (النوع == 3 || !ينتهي_بـ(&المحلول, &«.sn»)) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: [lib].path يجب أن يكون دليلا أو ملف .sn: », «: [lib].path must be a directory or a .sn file: »), النسبي]));
    };
    دع الاسم: نص;
    طابق اسم_الملف(&المحلول) مع
    | اختياري.موجود(ق) -> { الاسم := شريحة_نص(&ق, 0, طول_النص(&ق) - 3); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: [lib].path بلا اسم ملف», «: [lib].path has no file name»)])); };
    إذا (!معرف_صالح(&الاسم)) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: اسم ملف [lib] ليس اسم وحدة صالحا: », «: the [lib] file name is not a valid module name: »), الاسم]));
    };
    دع الأب: نص;
    طابق أب_المسار(&المحلول) مع
    | اختياري.موجود(ق) -> { الأب := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: ملف [lib] بلا دليل», «: the [lib] file has no directory»)])); };
    دع ه: هدف_مكتبة = { الجذر: قانوني_أو_كما_هو(&الأب), المدخل: اختياري.موجود(الاسم) };
    أرجع نتيجة.نجح(ه);
}

// ---------------------------------------------------------------------
// [imports-alias]

عرف اقرأ_المرادفات(الملف: &ملف_تومل): نتيجة متجه مرادف_استيراد, نص {
    دع الوثيقة: &وثيقة_تومل = &(*الملف).الوثيقة;
    دع الجذر: طبيعي = (*الملف).الوثيقة.الجذر;
    دع الناتج: متغير متجه مرادف_استيراد = [];
    إذا (!مفتاح_موجود(الوثيقة, الجذر, «imports-alias»)) { أرجع نتيجة.نجح(الناتج); };
    دع الجدول: طبيعي;
    طابق جدول_في_جدول(الوثيقة, الجذر, «imports-alias») مع
    | اختياري.موجود(ق) -> { الجدول := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الملف).المسار), رسالة(«: [imports-alias] يجب أن يكون جدولا», «: [imports-alias] must be a table»)])); };
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع المقنن: &نص = &المداخل[ف].المفتاح;
        دع الموضع_النصي: نص = موضع(الملف, المداخل[ف].الإزاحة);
        إذا (!مسار_استيراد_صالح(المقنن)) {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«مفتاح مرادف الاستيراد ليس مسار وحدة صالحا: », «the import alias key is not a valid module path: »), انسخ_نص(المقنن)]));
        };
        دع جدول_اللغات: طبيعي;
        طابق قيمة_جدول(&المداخل[ف].القيمة) مع
        | اختياري.موجود(ق) -> { جدول_اللغات := ق; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(ضم([الموضع_النصي, رسالة(«قيمة مرادف الاستيراد يجب أن تكون جدولا من اللغات: », «an import alias value must be a table of languages: »), انسخ_نص(المقنن)]));
        };
        دع اللغات: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, جدول_اللغات);
        دع التهجئات: متغير متجه تهجئة = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(اللغات) مثل طبيعي)) {
            إذا (طول_النص(&اللغات[ح].المفتاح) == 0) {
                أرجع نتيجة.خطأ(ضم([موضع(الملف, اللغات[ح].الإزاحة), رسالة(«اسم لغة فارغ في مرادف الاستيراد», «empty language name in an import alias»)]));
            };
            طابق قيمة_نصية(&اللغات[ح].القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(ضم([موضع(الملف, اللغات[ح].الإزاحة), رسالة(«تهجئة مرادف الاستيراد يجب أن تكون نصا», «an import alias spelling must be a string»)]));
            }
            | اختياري.موجود(التهجئة) -> {
                إذا (!مسار_استيراد_صالح(&التهجئة)) {
                    أرجع نتيجة.خطأ(ضم([موضع(الملف, اللغات[ح].الإزاحة), رسالة(«تهجئة مرادف الاستيراد ليست مسار وحدة صالحا: », «an import alias spelling is not a valid module path: »), التهجئة]));
                };
                دع ت: تهجئة = { اللغة: انسخ_نص(&اللغات[ح].المفتاح), التهجئة: التهجئة };
                ألحق(التهجئات, ت);
            };
            ح := ح + 1;
        }
        دع م: مرادف_استيراد = { المسار: انسخ_نص(المقنن), التهجئات: التهجئات };
        ألحق(الناتج, م);
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// مسار وحدة منقط موجود تحت جذر المصدر: دليلا أو ملف .sn.
عرف وحدة_موجودة(الجذر: &نص, المسار_المنقط: &نص): منطقي {
    دع النسبي: نص = بفواصل_مسار(المسار_المنقط);
    دع الكامل: نص = صل_المسار(الجذر, &النسبي);
    طابق حاول_مسار_دليل(&الكامل) مع
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | _ -> { };
    دع الملف: نص = ضم([الكامل, «.sn»]);
    طابق حاول_مسار_ملف(&الملف) مع
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف بفواصل_مسار(المسار_المنقط: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(المسار_المنقط)) {
        إذا ((*المسار_المنقط)[ف] == 46) { ألحق(البايتات, 47); } وإلا { ألحق(البايتات, (*المسار_المنقط)[ف]); };
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// كما في تحقق_روابط_الاستيراد في المترجم: الهدف موجود، والتهجئة لا تحجب
// وحدة حقيقية، ولا تشير تهجئة واحدة إلى هدفين.
عرف تحقق_المرادفات(المرادفات: &متجه مرادف_استيراد, الجذر: &نص, مسار_البيان: &نص): نتيجة نص, نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المرادفات) مثل طبيعي)) {
        دع م: &مرادف_استيراد = &(*المرادفات)[ف];
        إذا (!وحدة_موجودة(الجذر, &(*م).المسار)) {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(مسار_البيان), رسالة(«: هدف مرادف الاستيراد غير موجود: », «: the import alias target does not exist: »), انسخ_نص(&(*م).المسار)]));
        };
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*م).التهجئات) مثل طبيعي)) {
            دع المرئي: &نص = &(*م).التهجئات[ح].التهجئة;
            إذا (!نصان_متساويان(المرئي, &(*م).المسار) && وحدة_موجودة(الجذر, المرئي)) {
                أرجع نتيجة.خطأ(ضم([انسخ_نص(مسار_البيان), رسالة(«: التهجئة "», «: the spelling "»), انسخ_نص(المرئي),
                    رسالة(«" تحجب وحدة حقيقية بالاسم نفسه», «" hides a real module with the same name»)]));
            };
            دع ز: متغير طبيعي = 0;
            طالما (ز < ف) {
                دع د: متغير طبيعي = 0;
                طالما (د < (الطول((*المرادفات)[ز].التهجئات) مثل طبيعي)) {
                    إذا (نصان_متساويان(المرئي, &(*المرادفات)[ز].التهجئات[د].التهجئة)
                        && !نصان_متساويان(&(*م).المسار, &(*المرادفات)[ز].المسار)) {
                        أرجع نتيجة.خطأ(ضم([انسخ_نص(مسار_البيان), رسالة(«: التهجئة "», «: the spelling "»), انسخ_نص(المرئي),
                            رسالة(«" تشير إلى وحدتين مختلفتين», «" points to two different modules»)]));
                    };
                    د := د + 1;
                }
                ز := ز + 1;
            }
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(«»);
}
