// مخطط الحزم الذي يقرؤه المترجم عبر --package-graph (انظر docs/compiler-integration.md).
// المترجم لا يقرأ Supax.toml؛ كل ما يحتاجه عن الحزم يصله من هذا الملف:
//
//   version = 1
//   root = "<id>"
//
//   [[package]]
//   id = "<id>"
//   source_root = "<دليل [lib]، أو دليل البيان>"
//   name = "<الاسم>"
//   spellings = { ar = "…", en = "…" }     ([package.names])
//   entry = "<وحدة>"                        (إن أشار [lib] path إلى ملف)
//
// لا [[alias]]: منذ e1d4bca تُعلن تهجئات الوحدات في ملف جذر كل حزمة (module).
//
//   [[edge]]                                (اعتمادية: مفتاحها هو name)
//   from = "<id>"
//   to = "<id>"
//   name = "<مفتاح الاعتمادية>"
//
// المكتبة القياسية لا تُذكر. المسارات مطلقة، أو نسبية إلى دليل ملف المخطط
// نفسه عند الكتابة بـ --relative.
استورد المكتبة.ملفات.path;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.transform;
استورد المكتبة.نصوص.search;
استورد المكتبة.مجموعات.sort;
استورد سوباكس.support.text;
استورد سوباكس.manifest.manifest;
استورد سوباكس.resolve.model;
استورد سوباكس.resolve.lockfile;

// معرف كل حزمة: اسمها إن لم يتكرر، وإلا الاسم مع المصدر (الالتزام أو المسار).
عام عرف معرفات_الحزم(المخطط: &مخطط): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع العدد: طبيعي = الطول((*المخطط).الحزم) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ح: &حزمة = &(*المخطط).الحزم[ف];
        دع مكرر: متغير منطقي = خطأ;
        دع ز: متغير طبيعي = 0;
        طالما (ز < العدد) {
            إذا (ز != ف && نصان_متساويان(&(*المخطط).الحزم[ز].الاسم, &(*ح).الاسم)) { مكرر := صواب; };
            ز := ز + 1;
        }
        إذا (!مكرر || ف == 0) {
            ألحق(الناتج, انسخ_نص(&(*ح).الاسم));
        } وإلا إذا (هل_جت(&(*ح).المصدر)) {
            دع الأساس: نص = ضم([انسخ_نص(&(*ح).الاسم), «@», مختصر(&(*ح).الالتزام)]);
            إذا (طول_النص(&(*ح).المسار_الفرعي) > 0) {
                ألحق(الناتج, ضم([الأساس, «/», انسخ_نص(&(*ح).المسار_الفرعي)]));
            } وإلا {
                ألحق(الناتج, الأساس);
            };
        } وإلا {
            ألحق(الناتج, ضم([انسخ_نص(&(*ح).الاسم), «@», انسخ_نص(&(*ح).المسار_النسبي)]));
        };
        ف := ف + 1;
    }
    // ما بقي متكررا يأخذ رقمه.
    ف := 0;
    طالما (ف < العدد) {
        دع ز: متغير طبيعي = 0;
        طالما (ز < ف) {
            إذا (نصان_متساويان(&الناتج[ز], &الناتج[ف])) {
                الناتج[ف] := ضم([انسخ_نص(&الناتج[ف]), «#», رقم_نصا(ف)]);
            };
            ز := ز + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

// مفتاح TOML: كما هو إن كان من A-Z a-z 0-9 _ -، وإلا بين علامتي تنصيص.
عرف مفتاح_تومل(المفتاح: &نص): نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(المفتاح)) {
        دع ب: ط8 = (*المفتاح)[ف];
        دع مجرد: منطقي = (ب >= 65 && ب <= 90) || (ب >= 97 && ب <= 122) || (ب >= 48 && ب <= 57) || ب == 95 || ب == 45;
        إذا (!مجرد) { أرجع نص_تومل(المفتاح); };
        ف := ف + 1;
    }
    إذا (طول_النص(المفتاح) == 0) { أرجع نص_تومل(المفتاح); };
    أرجع انسخ_نص(المفتاح);
}

عرف جدول_تهجئات(التهجئات: &متجه تهجئة): نص {
    دع الأجزاء: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التهجئات) مثل طبيعي)) {
        ألحق(الأجزاء, ضم([مفتاح_تومل(&(*التهجئات)[ف].اللغة), « = », نص_تومل(&(*التهجئات)[ف].التهجئة)]));
        ف := ف + 1;
    }
    إذا ((الطول(الأجزاء) مثل طبيعي) == 0) { أرجع «{}»; };
    دع الفاصل: نص = «, »;
    أرجع ضم([«{ », صل_النصوص(&الأجزاء, &الفاصل), « }»]);
}

// المسار كما يُكتب: مطلقا، أو نسبيا إلى الأساس بفواصل «/».
عرف مسار_للكتابة(المسار: &نص, الأساس: &نص): نص {
    إذا (طول_النص(الأساس) == 0) { أرجع انسخ_نص(المسار); };
    طابق مسار_نسبي_من(الأساس, المسار) مع
    | اختياري.موجود(ق) -> {
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < طول_النص(&ق)) {
            إذا (ق[ف] == 92) { ألحق(البايتات, 47); } وإلا { ألحق(البايتات, ق[ف]); };
            ف := ف + 1;
        }
        إذا ((الطول(البايتات) مثل طبيعي) == 0) { أرجع «.»; };
        أرجع من_بايتات(&البايتات);
    }
    | اختياري.لا_شيء -> { أرجع انسخ_نص(المسار); };
}

// نص مخطط الحزم. الأساس: دليل يُكتب المسار نسبةً إليه، أو «» لمسارات مطلقة.
عام عرف اكتب_نص_مخطط_الحزم(المخطط: &مخطط, الأساس: &نص): نص {
    دع المعرفات: متجه نص = معرفات_الحزم(المخطط);
    دع الترتيب: متجه طبيعي = ترتيب_الكتابة(المخطط);
    دع الأجزاء: متغير متجه نص = [
        «# مخطط الحزم لـ sultanc --package-graph؛ يكتبه سوباكس. Package graph for sultanc --package-graph, written by Supax.», سطر_جديد(),
        «version = 1», سطر_جديد(),
        «root = », نص_تومل(&المعرفات[0]), سطر_جديد()
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الترتيب) مثل طبيعي)) {
        دع رقم: طبيعي = الترتيب[ف];
        دع ح: &حزمة = &(*المخطط).الحزم[رقم];
        ألحق(الأجزاء, سطر_جديد());
        ألحق(الأجزاء, «[[package]]»);
        ألحق(الأجزاء, سطر_جديد());
        ألحق(الأجزاء, سطر_مفتاح(«id», &المعرفات[رقم]));
        ألحق(الأجزاء, سطر_مفتاح(«source_root», &مسار_للكتابة(&(*ح).جذر_المصدر, الأساس)));
        ألحق(الأجزاء, سطر_مفتاح(«name», &(*ح).الاسم));
        ألحق(الأجزاء, ضم([«spellings = », جدول_تهجئات(&(*ح).الأسماء), سطر_جديد()]));
        طابق انسخ_اختيار_نص(&(*ح).المدخل) مع
        | اختياري.موجود(ق) -> { ألحق(الأجزاء, سطر_مفتاح(«entry», &ق)); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // الحواف مرتبة بالمصدر ثم بالاسم.
    دع المفاتيح: متغير متجه نص = [];
    ف := 0;
    طالما (ف < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        دع ح: &حافة = &(*المخطط).الحواف[ف];
        ألحق(المفاتيح, ضم([انسخ_نص(&المعرفات[(*ح).المستورد]), «|», انسخ_نص(&(*ح).الاسم), «|», رقم_نصا(ف)]));
        ف := ف + 1;
    }
    رتب_نصوص(&متغير المفاتيح);
    ف := 0;
    طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
        دع م: &نص = &المفاتيح[ف];
        دع ل: طبيعي = طول_النص(م);
        دع ب: متغير طبيعي = ل;
        طالما (ب > 0 && (*م)[ب - 1] != 124) { ب := ب - 1; }
        دع رقم_الحافة: متغير طبيعي = 0;
        دع ز: متغير طبيعي = ب;
        طالما (ز < ل) { رقم_الحافة := رقم_الحافة * 10 + (((*م)[ز] - 48) مثل طبيعي); ز := ز + 1; }
        دع ح: &حافة = &(*المخطط).الحواف[رقم_الحافة];
        ألحق(الأجزاء, سطر_جديد());
        ألحق(الأجزاء, «[[edge]]»);
        ألحق(الأجزاء, سطر_جديد());
        ألحق(الأجزاء, سطر_مفتاح(«from», &المعرفات[(*ح).المستورد]));
        ألحق(الأجزاء, سطر_مفتاح(«to», &المعرفات[(*ح).الهدف_رقم]));
        ألحق(الأجزاء, سطر_مفتاح(«name», &(*ح).الاسم));
        ف := ف + 1;
    }
    أرجع ضم(الأجزاء);
}

// مخطط اختبارات التكامل (tests/*.sn لحزمة لها [lib])، مثل Cargo: الاختبارات
// حزمة جذر مستقلة جذرها tests/، تعتمد على مكتبة المشروع باسمها:
//
//   root = "<الجذر> tests"
//   [[package]] id = "<الجذر> tests", source_root = "<tests>", name = "tests"
//   [[edge]]    from = "<الجذر> tests", to = "<الجذر>", name = "<اسم الحزمة>"
//
// وبقية الحزم والحواف كما في مخطط البناء.
عام عرف اكتب_نص_مخطط_الاختبارات(المخطط: &مخطط, دليل_الاختبارات: &نص): نص {
    دع المعرفات: متجه نص = معرفات_الحزم(المخطط);
    دع معرف_الاختبارات: نص = ضم([انسخ_نص(&المعرفات[0]), « tests»]);
    دع اسم_الاختبارات: متغير نص = «tests»;
    دع tests: نص = «tests»;
    إذا (نصان_متساويان(&(*المخطط).الحزم[0].الاسم, &tests)) { اسم_الاختبارات := «tests_»; };
    دع مطلق: نص = «»;
    دع الأصل: نص = اكتب_نص_مخطط_الحزم(المخطط, &مطلق);
    // ما بعد الترويسة: من أول [[package]].
    دع العلامة: نص = «[[package]]»;
    دع البداية: متغير طبيعي = 0;
    طابق ابحث_نصا(&الأصل, &العلامة) مع
    | اختياري.موجود(م) -> { البداية := م; }
    | اختياري.لا_شيء -> { };
    دع البقية: نص = شريحة_نص(&الأصل, البداية, طول_النص(&الأصل));
    أرجع ضم([
        «# مخطط اختبارات التكامل لـ sultanc test؛ يكتبه سوباكس. Integration-test package graph for sultanc test, written by Supax.», سطر_جديد(),
        «version = 1», سطر_جديد(),
        «root = », نص_تومل(&معرف_الاختبارات), سطر_جديد(),
        سطر_جديد(),
        «[[package]]», سطر_جديد(),
        سطر_مفتاح(«id», &معرف_الاختبارات),
        سطر_مفتاح(«source_root», دليل_الاختبارات),
        سطر_مفتاح(«name», &اسم_الاختبارات),
        «spellings = {}», سطر_جديد(),
        سطر_جديد(),
        البقية,
        سطر_جديد(),
        «[[edge]]», سطر_جديد(),
        سطر_مفتاح(«from», &معرف_الاختبارات),
        سطر_مفتاح(«to», &المعرفات[0]),
        سطر_مفتاح(«name», &(*المخطط).الحزم[0].الاسم)
    ]);
}
