عام نوع حالة_الحل = {
    الجذر: نص،
    الحزم: متجه حزمة،
    الحواف: متجه حافة،
    جذر_المخبأ: نص،
    // فهرس الحزم: يُفتح (ويُجلب) مرة واحدة، وفقط إن احتاجه الحل.
    الفهرس: اختياري فهرس،
    // supax install: لا يُشترط [lib] في اعتماديات الجذر المباشرة.
    بلا_شرط_المكتبة: منطقي
};

عام عرف هل_جذر(المصدر: &مصدر_حزمة): منطقي {
    طابق *المصدر مع
    | مصدر_حزمة.جذر -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف تحقق_رابط(الرابط: &نص): نتيجة نص، نص {
    أرجع هوية_رابط_جت(الرابط);
}

عام عرف قانوني(المسار: &نص): نتيجة نص، نص {
    طابق مسار_قانوني(المسار) مع
    | نتيجة.نجح(ق) -> { أرجع نتيجة.نجح(ق); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(ضم([رسالة(«المسار غير موجود: »، «path does not exist: »)، انسخ_نص(المسار)])); };
}

عام عرف وصف_المواصفة(النوع: نوع_مرجع_جت، المرجع: &نص): نص {
    طابق النوع مع
    | نوع_مرجع_جت.الفرع_الافتراضي -> { أرجع رسالة(«الفرع الافتراضي»، «the default branch»); }
    | _ -> { أرجع ضم([اسم_نوع_المرجع(النوع)، « "»، انسخ_نص(المرجع)، «"»]); };
}

عام عرف نفس_نوع_المرجع(أ: نوع_مرجع_جت، ب: نوع_مرجع_جت): منطقي {
    أرجع نصان_متساويان(&اسم_نوع_المرجع(أ)، &اسم_نوع_المرجع(ب));
}

// يطلب مستعمل التحديث تجاهل التثبيت لهذا الاسم؟
عام عرف مطلوب_تحديثه(الخيارات: &خيارات_الحل، الاسم: &نص): منطقي {
    إذا ((*الخيارات).تحديث_الكل) { أرجع صواب; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الخيارات).تحديث) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الخيارات).تحديث[ف]، الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// التزام مثبت في القفل لهذا المستودع وهذا المرجع، إن وجد.
عام عرف ابحث_في_القفل(القفل: &قفل، الهوية: &نص، النوع: نوع_مرجع_جت، المرجع: &نص): اختياري مدخل_قفل {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القفل).المداخل) مثل طبيعي)) {
        ليكن م: &مدخل_قفل = &(*القفل).المداخل[ف];
        إذا (يساوي_نصا(&(*م).المصدر، «git») && طول_النص(&(*م).المسار_الفرعي) == 0
            && نصان_متساويان(&(*م).الهوية، الهوية)
            && نفس_نوع_المرجع((*م).نوع_المرجع، النوع)
            && نصان_متساويان(&(*م).المرجع، المرجع)) {
            ليكن نسخة: مدخل_قفل = {
                الاسم: انسخ_نص(&(*م).الاسم)، المصدر: انسخ_نص(&(*م).المصدر)، الرابط: انسخ_نص(&(*م).الرابط)،
                الهوية: انسخ_نص(&(*م).الهوية)، نوع_المرجع: (*م).نوع_المرجع، المرجع: انسخ_نص(&(*م).المرجع)،
                الالتزام: انسخ_نص(&(*م).الالتزام)، البصمة: انسخ_نص(&(*م).البصمة)، المسار_الفرعي: «»،
                الإصدار: «»، السجل: «»
            };
            أرجع اختياري.موجود(نسخة);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف جذر_المخبأ_للحالة(الحالة: &متغير حالة_الحل): نتيجة نص، نص {
    إذا (طول_النص(&(*الحالة).جذر_المخبأ) == 0) {
        (*الحالة).جذر_المخبأ := جذر_المخبأ()؟;
    };
    أرجع نتيجة.نجح(انسخ_نص(&(*الحالة).جذر_المخبأ));
}

// حزمة جديدة من بيان مقروء.
عرف اعتماديات_التطوير_إن_جذر(البيان: &بيان، المصدر: &مصدر_حزمة): متجه اعتمادية {
    إذا (هل_جذر(المصدر)) { أرجع استنسخ(&(*البيان).اعتماديات_التطوير); };
    ليكن فارغة: متجه اعتمادية = [];
    أرجع فارغة;
}

عام عرف حزمة_من_بيان(البيان: &بيان، المصدر: مصدر_حزمة، الطالب: نص): حزمة {
    ليكن ح: حزمة = {
        المصدر: المصدر،
        الاسم: استنسخ(&(*البيان).الاسم)،
        الإصدار: انسخ_اختيار_نص(&(*البيان).الإصدار)،
        الدليل: استنسخ(&(*البيان).الدليل)،
        الأسماء: استنسخ(&(*البيان).الأسماء)،
        الرابط: «»، الهوية: «»، نوع_المرجع: نوع_مرجع_جت.الفرع_الافتراضي()، المرجع: «»،
        الالتزام: «»، البصمة: «»، جذر_النسخة: «»، المسار_الفرعي: «»، المسار_النسبي: «»،
        الطالب: الطالب،
        المعلنة: استنسخ(&(*البيان).الاعتماديات)،
        المعلنة_للتطوير: اعتماديات_التطوير_إن_جذر(البيان، &المصدر)،
        جذر_المصدر: استنسخ(&(*البيان).جذر_المصدر)،
        المدخل: انسخ_اختيار_نص(&(*البيان).المدخل)،
        المرادفات: استنسخ(&(*البيان).المرادفات)،
        السجل: «»
    };
    أرجع ح;
}

عام عرف تطلب_مكتبة(البيان: &بيان، الاعتمادية: &اعتمادية): نتيجة نص، نص {
    إذا (!(*البيان).له_مكتبة) {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
            رسالة(«" ليست مكتبة: بيانها »، «" is not a library: its manifest »)، انسخ_نص(&(*البيان).المسار)، رسالة(« لا يعلن [lib]»، « does not declare [lib]»)]));
    };
    أرجع نتيجة.نجح(«»);
}

// اعتمادية git يجب أن تكون الحزمة التي تحمل اسمها؛ هذا يمنع أن يقدم مستودع
// حزمة باسم آخر تحت اسم مطلوب.
عام عرف تحقق_اسم_الحزمة(البيان: &بيان، الاعتمادية: &اعتمادية): نتيجة نص، نص {
    ليكن المطلوب: نص = مفتاح_الهوية(&(*الاعتمادية).الاسم);
    إذا (نصان_متساويان(&مفتاح_الهوية(&(*البيان).الاسم)، &المطلوب)) { أرجع نتيجة.نجح(«»); };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البيان).الأسماء) مثل طبيعي)) {
        إذا (نصان_متساويان(&مفتاح_الهوية(&(*البيان).الأسماء[ف].التهجئة)، &المطلوب)) { أرجع نتيجة.نجح(«»); };
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
        رسالة(«" تشير إلى مستودع حزمته اسمها "»، «" points to a repository whose package is named "»)، انسخ_نص(&(*البيان).الاسم)، رسالة(«"؛ يجب أن يطابق مفتاح الاعتمادية اسم الحزمة أو إحدى تهجئاتها»، «"; the dependency key must match the package name or one of its spellings»)]));
}

// اعتمادية مسارية من حزمة داخل نسخة git: تبقى داخل النسخة نفسها.
عام عرف حل_مسار_داخل_جت(الحالة: &متغير حالة_الحل، المستورد: طبيعي، الاعتمادية: &اعتمادية، المسار: &نص): نتيجة طبيعي، نص {
    ليكن الأب_الفرعي: نص = انسخ_نص(&(*الحالة).الحزم[المستورد].المسار_الفرعي);
    ليكن المجموع: نص = إذا_فارغ(&الأب_الفرعي، المسار);
    ليكن النسبي: متغير نص = «»;
    طابق طبع_مسار_نسبي(&المجموع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«مسار الاعتمادية "»، «path of dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
            رسالة(«" يخرج من مستودع الحزمة؛ الاعتماديات المسارية داخل حزم git تبقى داخل مستودعها»، «" leaves the package repository; path dependencies inside git packages must stay inside their repository»)]));
    }
    | اختياري.موجود(ق) -> { النسبي := ق; };
    إذا (يساوي_نصا(&النسبي، «.»)) { النسبي := «»; };
    ليكن الهوية: نص = انسخ_نص(&(*الحالة).الحزم[المستورد].الهوية);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).الحزم) مثل طبيعي)) {
        إذا (هل_جت(&(*الحالة).الحزم[ف].المصدر) && نصان_متساويان(&(*الحالة).الحزم[ف].الهوية، &الهوية)
            && نصان_متساويان(&(*الحالة).الحزم[ف].المسار_الفرعي، &النسبي)) {
            أرجع نتيجة.نجح(ف);
        };
        ف := ف + 1;
    }
    ليكن جذر_النسخة: نص = انسخ_نص(&(*الحالة).الحزم[المستورد].جذر_النسخة);
    ليكن الدليل: نص = إذا_فارغ_فالأصل(&جذر_النسخة، &النسبي);
    ليكن البيان: بيان = اقرأ_البيان(&الدليل، تحقق_رابط)؟;
    إذا (!(*الحالة).بلا_شرط_المكتبة) { تطلب_مكتبة(&البيان، الاعتمادية)؟; };
    ليكن الحزمة: متغير حزمة = حزمة_من_بيان(&البيان، مصدر_حزمة.جت()، انسخ_نص(&(*الاعتمادية).الموضع));
    الحزمة.الرابط := انسخ_نص(&(*الحالة).الحزم[المستورد].الرابط);
    الحزمة.الهوية := الهوية;
    الحزمة.نوع_المرجع := (*الحالة).الحزم[المستورد].نوع_المرجع;
    الحزمة.المرجع := انسخ_نص(&(*الحالة).الحزم[المستورد].المرجع);
    الحزمة.الالتزام := انسخ_نص(&(*الحالة).الحزم[المستورد].الالتزام);
    الحزمة.البصمة := انسخ_نص(&(*الحالة).الحزم[المستورد].البصمة);
    الحزمة.جذر_النسخة := جذر_النسخة;
    الحزمة.المسار_الفرعي := النسبي;
    ألحق((*الحالة).الحزم، الحزمة);
    أرجع نتيجة.نجح((الطول((*الحالة).الحزم) مثل طبيعي) - 1);
}

عام عرف إذا_فارغ(الأصل: &نص، المسار: &نص): نص {
    إذا (طول_النص(الأصل) == 0) { أرجع انسخ_نص(المسار); };
    أرجع ضم([انسخ_نص(الأصل)، «/»، انسخ_نص(المسار)]);
}

عام عرف إذا_فارغ_فالأصل(الأصل: &نص، النسبي: &نص): نص {
    إذا (طول_النص(النسبي) == 0) { أرجع انسخ_نص(الأصل); };
    أرجع صل_المسار(الأصل، النسبي);
}

// اعتمادية مسارية محلية.
عام عرف حل_مسار_محلي(الحالة: &متغير حالة_الحل، المستورد: طبيعي، الاعتمادية: &اعتمادية، المسار: &نص): نتيجة طبيعي، نص {
    ليكن دليل_الأب: نص = انسخ_نص(&(*الحالة).الحزم[المستورد].الدليل);
    ليكن الموصول: نص = صل_المسار(&دليل_الأب، المسار);
    ليكن الدليل: نص;
    طابق مسار_قانوني(&الموصول) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«مسار الاعتمادية "»، «path of dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
            رسالة(«" غير موجود: »، «" does not exist: »)، الموصول]));
    }
    | نتيجة.نجح(ق) -> { الدليل := ق; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).الحزم) مثل طبيعي)) {
        إذا (!هل_جت(&(*الحالة).الحزم[ف].المصدر) && نصان_متساويان(&(*الحالة).الحزم[ف].الدليل، &الدليل)) {
            أرجع نتيجة.نجح(ف);
        };
        ف := ف + 1;
    }
    ليكن البيان: بيان = اقرأ_البيان(&الدليل، تحقق_رابط)؟;
    إذا (!(*الحالة).بلا_شرط_المكتبة) { تطلب_مكتبة(&البيان، الاعتمادية)؟; };
    ليكن الحزمة: متغير حزمة = حزمة_من_بيان(&البيان، مصدر_حزمة.مسار()، انسخ_نص(&(*الاعتمادية).الموضع));
    ليكن جذر_المشروع: نص = انسخ_نص(&(*الحالة).الجذر);
    طابق مسار_نسبي_من(&جذر_المشروع، &الدليل) مع
    | اختياري.موجود(ق) -> { الحزمة.المسار_النسبي := بفواصل_أمامية(&ق); }
    | اختياري.لا_شيء -> { الحزمة.المسار_النسبي := انسخ_نص(&الدليل); };
    ألحق((*الحالة).الحزم، الحزمة);
    أرجع نتيجة.نجح((الطول((*الحالة).الحزم) مثل طبيعي) - 1);
}

// اعتمادية git.
// يحجز مستودع المخبأ لهذه الهوية طوال الجلب والسحب، فلا تتداخل عمليتا
// سوباكس تعملان على المستودع نفسه في الوقت نفسه.
// متعدد: لحزم الفهرس، يُسمح بالمستودع نفسه بالتزامات مختلفة (إصدارات غير متوافقة).
عام عرف حل_جت(
    الحالة: &متغير حالة_الحل،
    الاعتمادية: &اعتمادية،
    الرابط: &نص،
    القفل: &قفل،
    الخيارات: &خيارات_الحل،
    متعدد: منطقي
): نتيجة طبيعي، نص {
    ليكن الهوية: نص = هوية_رابط_جت(الرابط)؟;
    ليكن المخبأ: نص = جذر_المخبأ_للحالة(الحالة)؟;
    ليكن المقبض: مقبض_ملف = احجز_المستودع(&المخبأ، &الهوية)؟;
    ليكن الناتج: نتيجة طبيعي، نص = حل_جت_محجوزا(الحالة، الاعتمادية، الرابط، القفل، الخيارات، متعدد);
    حرر_المستودع(المقبض);
    أرجع الناتج;
}

عرف حل_جت_محجوزا(
    الحالة: &متغير حالة_الحل،
    الاعتمادية: &اعتمادية،
    الرابط: &نص،
    القفل: &قفل،
    الخيارات: &خيارات_الحل،
    متعدد: منطقي
): نتيجة طبيعي، نص {
    ليكن الهوية: نص = هوية_رابط_جت(الرابط)؟;
    ليكن المخبأ: نص = جذر_المخبأ_للحالة(الحالة)؟;
    ليكن المستودع: نص = مسار_المستودع(&المخبأ، &الهوية);
    ليكن النوع: نوع_مرجع_جت = (*الاعتمادية).نوع_المرجع;
    ليكن المرجع: نص = انسخ_نص(&(*الاعتمادية).المرجع);
    // مستودع حُل من قبل في المخطط.
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).الحزم) مثل طبيعي)) {
        إذا (هل_جت(&(*الحالة).الحزم[ف].المصدر) && طول_النص(&(*الحالة).الحزم[ف].المسار_الفرعي) == 0
            && نصان_متساويان(&(*الحالة).الحزم[ف].الهوية، &الهوية) && !متعدد) {
            إذا (نفس_نوع_المرجع((*الحالة).الحزم[ف].نوع_المرجع، النوع)
                && نصان_متساويان(&(*الحالة).الحزم[ف].المرجع، &المرجع)) {
                أرجع نتيجة.نجح(ف);
            };
            ليكن بلا_تثبيت: اختياري نص = اختياري.لا_شيء();
            ليكن الآخر: نص = حل_المرجع(&المخبأ، &المستودع، الرابط، النوع، &المرجع، &بلا_تثبيت، (*الخيارات).بلا_شبكة)؟;
            إذا (نصان_متساويان(&الآخر، &(*الحالة).الحزم[ف].الالتزام)) { أرجع نتيجة.نجح(ف); };
            أرجع نتيجة.خطأ(ضم([
                رسالة(«تعارض: المستودع »، «conflict: repository »)، انسخ_نص(&الهوية)، رسالة(« مطلوب بالتزامين مختلفين:»، « is required at two different commits:»)، سطر_جديد()،
                «  »، انسخ_نص(&(*الحالة).الحزم[ف].الطالب)، رسالة(«يطلب »، «requires »)،
                وصف_المواصفة((*الحالة).الحزم[ف].نوع_المرجع، &(*الحالة).الحزم[ف].المرجع)،
                « ← »، مختصر(&(*الحالة).الحزم[ف].الالتزام)، سطر_جديد()،
                «  »، انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«يطلب »، «requires »)، وصف_المواصفة(النوع، &المرجع)، « ← »، مختصر(&الآخر)، سطر_جديد()،
                رسالة(«يسمح سوباكس حاليا بالتزام واحد لكل مستودع؛ اجعل المرجعين يشيران إلى الالتزام نفسه»، «Supax currently allows one commit per repository; make both references point to the same commit»)
            ]));
        };
        ف := ف + 1;
    }
    // حزم الفهرس: المرجع التزام كامل؛ الالتزام نفسه = الحزمة نفسها.
    إذا (متعدد) {
        ف := 0;
        طالما (ف < (الطول((*الحالة).الحزم) مثل طبيعي)) {
            إذا (هل_جت(&(*الحالة).الحزم[ف].المصدر) && طول_النص(&(*الحالة).الحزم[ف].المسار_الفرعي) == 0
                && نصان_متساويان(&(*الحالة).الحزم[ف].الهوية، &الهوية)
                && نصان_متساويان(&(*الحالة).الحزم[ف].الالتزام، &المرجع)) {
                أرجع نتيجة.نجح(ف);
            };
            ف := ف + 1;
        }
    };
    ليكن التثبيت: متغير اختياري مدخل_قفل = اختياري.لا_شيء();
    إذا (!مطلوب_تحديثه(الخيارات، &(*الاعتمادية).الاسم)) {
        التثبيت := ابحث_في_القفل(القفل، &الهوية، النوع، &المرجع);
    };
    ليكن الالتزام_المثبت: متغير اختياري نص = اختياري.لا_شيء();
    ليكن البصمة_المثبتة: متغير نص = «»;
    طابق التثبيت مع
    | اختياري.موجود(م) -> {
        الالتزام_المثبت := اختياري.موجود(استنسخ(&م.الالتزام));
        البصمة_المثبتة := استنسخ(&م.البصمة);
    }
    | اختياري.لا_شيء -> {
        إذا ((*الخيارات).مقفول) {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
                رسالة(«" غير مثبتة في Supax.lock، وخيار --locked يمنع تحديثه. شغّل supax fetch دون --locked»، «" is not pinned in Supax.lock, and --locked forbids updating it. Run supax fetch without --locked»)]));
        };
    };
    ليكن الالتزام: نص = حل_المرجع(&المخبأ، &المستودع، الرابط، النوع، &المرجع، &الالتزام_المثبت، (*الخيارات).بلا_شبكة)؟;
    ليكن النسخة: نسخة_مسحوبة = اسحب_إلى_المخبأ(&المخبأ، &الهوية، &الالتزام)؟;
    إذا (طول_النص(&البصمة_المثبتة) > 0 && !نصان_متساويان(&البصمة_المثبتة، &النسخة.البصمة)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«فشل التحقق من السلامة: محتوى »، «integrity check failed: the content of »)، انسخ_نص(&الهوية)، رسالة(« عند الالتزام »، « at commit »)، انسخ_نص(&الالتزام)،
            رسالة(« لا يطابق البصمة المسجلة في Supax.lock»، « does not match the checksum recorded in Supax.lock»)، سطر_جديد()،
            رسالة(«  المسجلة: »، «  recorded: »)، البصمة_المثبتة، سطر_جديد()، رسالة(«  الفعلية: »، «  actual:   »)، انسخ_نص(&النسخة.البصمة)]));
    };
    ليكن البيان: بيان;
    طابق اقرأ_البيان(&النسخة.الدليل، تحقق_رابط) مع
    | نتيجة.خطأ(السبب) -> {
        أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)، رسالة(«" من »، «" from »)،
            انسخ_نص(الرابط)، «: »، السبب]));
    }
    | نتيجة.نجح(ق) -> { البيان := ق; };
    إذا (!(*الحالة).بلا_شرط_المكتبة) { تطلب_مكتبة(&البيان، الاعتمادية)؟; };
    تحقق_اسم_الحزمة(&البيان، الاعتمادية)؟;
    ليكن الحزمة: متغير حزمة = حزمة_من_بيان(&البيان، مصدر_حزمة.جت()، انسخ_نص(&(*الاعتمادية).الموضع));
    الحزمة.الرابط := انسخ_نص(الرابط);
    الحزمة.الهوية := الهوية;
    الحزمة.نوع_المرجع := النوع;
    الحزمة.المرجع := المرجع;
    الحزمة.الالتزام := الالتزام;
    الحزمة.البصمة := انسخ_نص(&النسخة.البصمة);
    الحزمة.جذر_النسخة := انسخ_نص(&النسخة.الدليل);
    ألحق((*الحالة).الحزم، الحزمة);
    أرجع نتيجة.نجح((الطول((*الحالة).الحزم) مثل طبيعي) - 1);
}

// ---------------------------------------------------------------------
// اعتمادية من فهرس الحزم.
//
// 1. إصدار من الحزمة نفسها في المخطط يحقق المتطلب: يُستعمل.
// 2. إصدار مثبت في Supax.lock يحقق المتطلب: يُستعمل دون فتح الفهرس.
// 3. وإلا يُفتح الفهرس (يُجلب مرة في التشغيل) ويُختار أعلى إصدار غير مسحوب.
// يُسمح بإصدار واحد لكل فئة توافق (1.x و2.x معا، لا 1.2 و1.4)، كما في Cargo.
// ثم يُجلب الالتزام من git كأي اعتمادية git، وتُقارن بصمته بالمسجلة.

// اختيار: الإصدار والمستودع والالتزام والبصمة.
نوع إصدار_مختار = { الإصدار: نص، الرابط: نص، الالتزام: نص، البصمة: نص };

عرف حل_سجل(
    الحالة: &متغير حالة_الحل،
    الاعتمادية: &اعتمادية،
    المتطلب_نص: &نص،
    القفل: &قفل،
    الخيارات: &خيارات_الحل
): نتيجة طبيعي، نص {
    ليكن المتطلب: متطلب_إصدار = حلل_متطلبا(المتطلب_نص)؟;
    ليكن المفتاح: نص = مفتاح_الهوية(&(*الاعتمادية).الاسم);
    ليكن الرابط_الفهرس: نص = رابط_الفهرس();
    // 1. في المخطط: إصدار من الحزمة نفسها يحقق المتطلب.
    ليكن ف0: متغير طبيعي = 0;
    طالما (ف0 < (الطول((*الحالة).الحزم) مثل طبيعي)) {
        إذا (طول_النص(&(*الحالة).الحزم[ف0].السجل) > 0 && نصان_متساويان(&مفتاح_الهوية(&(*الحالة).الحزم[ف0].الاسم)، &المفتاح)) {
            ليكن إصدارها: نص = نص_أو_فارغ(انسخ_اختيار_نص(&(*الحالة).الحزم[ف0].الإصدار));
            طابق حلل_إصدارا(&إصدارها) مع
            | اختياري.موجود(إ) -> { إذا (يطابق_المتطلب(&المتطلب، &إ)) { أرجع نتيجة.نجح(ف0); }; }
            | اختياري.لا_شيء -> { };
        };
        ف0 := ف0 + 1;
    }
    // 2. من Supax.lock.
    ليكن المختار: متغير اختياري إصدار_مختار = اختياري.لا_شيء();
    إذا (!مطلوب_تحديثه(الخيارات، &(*الاعتمادية).الاسم)) {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*القفل).المداخل) مثل طبيعي)) {
            ليكن م: &مدخل_قفل = &(*القفل).المداخل[ف];
            إذا (يساوي_نصا(&(*م).المصدر، «registry») && نصان_متساويان(&(*م).السجل، &الرابط_الفهرس)
                && نصان_متساويان(&مفتاح_الهوية(&(*م).الاسم)، &المفتاح)) {
                طابق حلل_إصدارا(&(*م).الإصدار) مع
                | اختياري.موجود(إ) -> {
                    إذا (يطابق_المتطلب(&المتطلب، &إ)) {
                        ليكن خ: إصدار_مختار = { الإصدار: انسخ_نص(&(*م).الإصدار)، الرابط: انسخ_نص(&(*م).الرابط)،
                            الالتزام: انسخ_نص(&(*م).الالتزام)، البصمة: انسخ_نص(&(*م).البصمة) };
                        المختار := اختياري.موجود(خ);
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
    };
    // 3. من الفهرس.
    طابق المختار مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        إذا ((*الخيارات).مقفول) {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«الاعتمادية "»، «dependency "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
                رسالة(«" غير مثبتة في Supax.lock، وخيار --locked يمنع تحديثه. شغّل supax fetch دون --locked»، «" is not pinned in Supax.lock, and --locked forbids updating it. Run supax fetch without --locked»)]));
        };
        طابق (*الحالة).الفهرس مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            ليكن ف: فهرس = افتح_الفهرس((*الخيارات).بلا_شبكة)؟;
            (*الحالة).الفهرس := اختياري.موجود(ف);
        };
        ليكن المدخل_المقروء: متغير اختياري مدخل_فهرس = اختياري.لا_شيء();
        طابق (*الحالة).الفهرس مع
        | اختياري.موجود(ف) -> { المدخل_المقروء := اقرأ_مدخل_الفهرس(&ف، &(*الاعتمادية).الاسم)؟; }
        | اختياري.لا_شيء -> { };
        ليكن المدخل: مدخل_فهرس;
        طابق المدخل_المقروء مع
        | اختياري.موجود(م) -> { المدخل := م; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«لا توجد حزمة باسم "»، «no package named "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
                رسالة(«" في فهرس الحزم »، «" in the package index »)، انسخ_نص(&الرابط_الفهرس)]));
        };
        طابق أعلى_إصدار_مطابق(&المدخل، &المتطلب) مع
        | اختياري.موجود(ف) -> {
            ليكن إ: &إصدار_مفهرس = &المدخل.الإصدارات[ف];
            ليكن خ: إصدار_مختار = { الإصدار: انسخ_نص(&(*إ).الإصدار)، الرابط: انسخ_نص(&(*إ).الرابط)،
                الالتزام: انسخ_نص(&(*إ).الالتزام)، البصمة: انسخ_نص(&(*إ).البصمة) };
            المختار := اختياري.موجود(خ);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(ضم([انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«لا يوجد إصدار من "»، «no version of "»)، انسخ_نص(&(*الاعتمادية).الاسم)،
                رسالة(«" يحقق "»، «" matches "»)، انسخ_نص(المتطلب_نص)، «"»، سطر_جديد()،
                رسالة(«  الإصدارات المتاحة: »، «  available versions: »)، الإصدارات_المتاحة(&المدخل)]));
        };
    };
    ليكن خ: إصدار_مختار;
    طابق المختار مع
    | اختياري.موجود(ق) -> { خ := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(«registry»); };
    // إصدار واحد لكل فئة توافق (1.x، 0.3.x، 0.0.4)، كما في Cargo: 1.x و2.x معا مسموح.
    ليكن فئة_المختار: نص = فئة_توافق_نص(&خ.الإصدار);
    ليكن ف1: متغير طبيعي = 0;
    طالما (ف1 < (الطول((*الحالة).الحزم) مثل طبيعي)) {
        إذا (طول_النص(&(*الحالة).الحزم[ف1].السجل) > 0 && نصان_متساويان(&مفتاح_الهوية(&(*الحالة).الحزم[ف1].الاسم)، &المفتاح)) {
            ليكن إصدارها: نص = نص_أو_فارغ(انسخ_اختيار_نص(&(*الحالة).الحزم[ف1].الإصدار));
            إذا (نصان_متساويان(&فئة_توافق_نص(&إصدارها)، &فئة_المختار)) {
                أرجع نتيجة.خطأ(ضم([
                    رسالة(«تعارض في إصدار الحزمة "»، «version conflict for package "»)، انسخ_نص(&(*الاعتمادية).الاسم)، «":»، سطر_جديد()،
                    «  »، انسخ_نص(&(*الحالة).الحزم[ف1].الطالب)، رسالة(«اختير الإصدار »، «chose version »)، انسخ_نص(&إصدارها)، سطر_جديد()،
                    «  »، انسخ_نص(&(*الاعتمادية).الموضع)، رسالة(«يطلب "»، «requires "»)، انسخ_نص(المتطلب_نص)، «"»، سطر_جديد()،
                    رسالة(«الإصداران متوافقان ("»، «the two are compatible versions ("»)، فئة_المختار،
                    رسالة(«")، ويُسمح بإصدار واحد لكل فئة توافق؛ وسّع أحد المتطلبين حتى يلتقيا»،
                        «"), and only one version per compatible range is allowed; widen one of the requirements so they overlap»)
                ]));
            };
        };
        ف1 := ف1 + 1;
    }
    // الجلب: اعتمادية git بالالتزام نفسه. التثبيت هنا للإصدار؛ لا يلزم تثبيت git.
    ليكن بديلة: اعتمادية = {
        الاسم: انسخ_نص(&(*الاعتمادية).الاسم)،
        المسار: اختياري.لا_شيء()،
        الجت: اختياري.موجود(انسخ_نص(&خ.الرابط))،
        نوع_المرجع: نوع_مرجع_جت.مراجعة()،
        المرجع: انسخ_نص(&خ.الالتزام)،
        الإصدار_المطلوب: اختياري.لا_شيء()،
        الموضع: انسخ_نص(&(*الاعتمادية).الموضع)
    };
    ليكن خيارات_git: خيارات_الحل = {
        بلا_شبكة: (*الخيارات).بلا_شبكة، مقفول: خطأ،
        تحديث_الكل: (*الخيارات).تحديث_الكل، تحديث: استنسخ(&(*الخيارات).تحديث)،
        للتثبيت: (*الخيارات).للتثبيت
    };
    ليكن الرقم: طبيعي = حل_جت(الحالة، &بديلة، &خ.الرابط، القفل، &خيارات_git، صواب)؟;
    ليكن ح: &حزمة = &(*الحالة).الحزم[الرقم];
    إذا (!نصان_متساويان(&(*ح).البصمة، &خ.البصمة)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«فشل التحقق من السلامة: محتوى "»، «integrity check failed: the content of "»)، انسخ_نص(&(*الاعتمادية).الاسم)، «" »، انسخ_نص(&خ.الإصدار)،
            رسالة(« لا يطابق البصمة المسجلة»، « does not match the recorded checksum»)، سطر_جديد()،
            رسالة(«  المسجلة: »، «  recorded: »)، انسخ_نص(&خ.البصمة)، سطر_جديد()، رسالة(«  الفعلية: »، «  actual:   »)، انسخ_نص(&(*ح).البصمة)]));
    };
    ليكن إصدار_البيان: نص = نص_أو_فارغ(انسخ_اختيار_نص(&(*ح).الإصدار));
    إذا (!نصان_متساويان(&إصدار_البيان، &خ.الإصدار)) {
        أرجع نتيجة.خطأ(ضم([رسالة(«الفهرس يذكر "»، «the index lists "»)، انسخ_نص(&(*الاعتمادية).الاسم)، «" »، انسخ_نص(&خ.الإصدار)،
            رسالة(«، لكن Supax.toml في ذلك الالتزام يذكر الإصدار "»، «, but Supax.toml at that commit says version "»)، إصدار_البيان، «"»]));
    };
    (*الحالة).الحزم[الرقم].السجل := الرابط_الفهرس;
    أرجع نتيجة.نجح(الرقم);
}

عام عرف حل_اعتمادية(
    الحالة: &متغير حالة_الحل،
    المستورد: طبيعي،
    الاعتمادية: &اعتمادية،
    القفل: &قفل،
    الخيارات: &خيارات_الحل
): نتيجة طبيعي، نص {
    طابق انسخ_اختيار_نص(&(*الاعتمادية).الإصدار_المطلوب) مع
    | اختياري.موجود(المتطلب) -> { أرجع حل_سجل(الحالة، الاعتمادية، &المتطلب، القفل، الخيارات); }
    | اختياري.لا_شيء -> { };
    طابق انسخ_اختيار_نص(&(*الاعتمادية).الجت) مع
    | اختياري.موجود(الرابط) -> { أرجع حل_جت(الحالة، الاعتمادية، &الرابط، القفل، الخيارات، خطأ); }
    | اختياري.لا_شيء -> { };
    ليكن المسار: نص;
    طابق انسخ_اختيار_نص(&(*الاعتمادية).المسار) مع
    | اختياري.موجود(ق) -> { المسار := ق; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(رسالة(«اعتمادية بلا مصدر»، «dependency without a source»)); };
    إذا (هل_جت(&(*الحالة).الحزم[المستورد].المصدر)) {
        أرجع حل_مسار_داخل_جت(الحالة، المستورد، الاعتمادية، &المسار);
    };
    أرجع حل_مسار_محلي(الحالة، المستورد، الاعتمادية، &المسار);
}

عام عرف حل_المخطط(دليل_المشروع: &نص، القفل: &قفل، الخيارات: &خيارات_الحل): نتيجة مخطط، نص {
    ليكن الجذور: متجه نص = [انسخ_نص(دليل_المشروع)];
    أرجع حل_مخطط_الجذور(دليل_المشروع، &الجذور، القفل، الخيارات);
}

// يحل مخططا واحدا لعدة حزم جذر (أعضاء مساحة عمل) بقفل واحد: كل الجذور
// تُضاف أولا (الأرقام 0..ع-1)، فتشير الاعتماديات المسارية بينها إليها.
// دليل_القفل: جذر المساحة، وإليه تُنسب مسارات الحزم المسارية.
عام عرف حل_مخطط_الجذور(دليل_القفل: &نص، الجذور: &متجه نص، القفل: &قفل، الخيارات: &خيارات_الحل): نتيجة مخطط، نص {
    ليكن الجذر: نص = قانوني(دليل_القفل)؟;
    ليكن الحزم: متجه حزمة = [];
    ليكن الحواف: متجه حافة = [];
    ليكن الحالة: متغير حالة_الحل = { الجذر: انسخ_نص(&الجذر)، الحزم: الحزم، الحواف: الحواف، جذر_المخبأ: «»، الفهرس: اختياري.لا_شيء()، بلا_شرط_المكتبة: خطأ };
    ليكن ج: متغير طبيعي = 0;
    طالما (ج < (الطول(*الجذور) مثل طبيعي)) {
        ليكن دليل_ج: نص = قانوني(&(*الجذور)[ج])؟;
        ليكن بيان_ج: بيان = اقرأ_البيان(&دليل_ج، تحقق_رابط)؟;
        ليكن الحزمة: متغير حزمة = حزمة_من_بيان(&بيان_ج، مصدر_حزمة.جذر()، «»);
        إذا ((الطول(*الجذور) مثل طبيعي) > 1) {
            طابق مسار_نسبي_من(&الجذر، &دليل_ج) مع
            | اختياري.موجود(ق) -> { الحزمة.المسار_النسبي := بفواصل_أمامية(&ق); }
            | اختياري.لا_شيء -> { };
        };
        ألحق(الحالة.الحزم، الحزمة);
        ج := ج + 1;
    }
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.الحزم) مثل طبيعي)) {
        ليكن المعلنة: متجه اعتمادية = استنسخ(&الحالة.الحزم[ف].المعلنة);
        ليكن عدد_العادية: طبيعي = الطول(المعلنة) مثل طبيعي;
        ليكن الكل: متغير متجه اعتمادية = المعلنة;
        ليكن للتطوير: متجه اعتمادية = استنسخ(&الحالة.الحزم[ف].المعلنة_للتطوير);
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(للتطوير) مثل طبيعي)) { ألحق(الكل، استنسخ(&للتطوير[ت])); ت := ت + 1; }
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الكل) مثل طبيعي)) {
            الحالة.بلا_شرط_المكتبة := (*الخيارات).للتثبيت && ف == 0;
            ليكن الهدف: طبيعي = حل_اعتمادية(&متغير الحالة، ف، &الكل[ح]، القفل، الخيارات)؟;
            ليكن من_جت: منطقي = طابق_جت(&الكل[ح]);
            ليكن الحافة: حافة = { المستورد: ف، الاسم: انسخ_نص(&الكل[ح].الاسم)، الهدف_رقم: الهدف، من_جت: من_جت، للتطوير: ح >= عدد_العادية };
            ألحق(الحالة.الحواف، الحافة);
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    ليكن المخطط_الناتج: مخطط = { الجذر: استنسخ(&الحالة.الجذر)، الحزم: استنسخ(&الحالة.الحزم)، الحواف: استنسخ(&الحالة.الحواف) };
    تحقق_من_الدورات(&المخطط_الناتج)؟;
    تحقق_من_التصادم(&المخطط_الناتج)؟;
    أرجع نتيجة.نجح(المخطط_الناتج);
}

// المخطط كما تراه حزمة واحدة: هي (رقم 0) وما تصل إليه، بأرقام جديدة.
// به يُبنى عضو مساحة العمل كأي مشروع منفرد.
عام عرف مخطط_فرعي(المخطط: &مخطط، الرقم: طبيعي): مخطط {
    ليكن العدد: طبيعي = الطول((*المخطط).الحزم) مثل طبيعي;
    // الجديد[قديم] = رقم جديد + 1، أو 0 إن لم تُضف.
    ليكن الجديد: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الجديد، 0); ف := ف + 1; }
    ليكن الترتيب: متغير متجه طبيعي = [الرقم];
    الجديد[الرقم] := 1;
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الترتيب) مثل طبيعي)) {
        ليكن الحالي: طبيعي = الترتيب[ر];
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*المخطط).الحواف) مثل طبيعي)) {
            إذا ((*المخطط).الحواف[ح].المستورد == الحالي && (!(*المخطط).الحواف[ح].للتطوير || الحالي == الرقم)) {
                ليكن ه: طبيعي = (*المخطط).الحواف[ح].الهدف_رقم;
                إذا (الجديد[ه] == 0) {
                    ألحق(الترتيب، ه);
                    الجديد[ه] := الطول(الترتيب) مثل طبيعي;
                };
            };
            ح := ح + 1;
        }
        ر := ر + 1;
    }
    ليكن الحزم: متغير متجه حزمة = [];
    ر := 0;
    طالما (ر < (الطول(الترتيب) مثل طبيعي)) {
        ألحق(الحزم، استنسخ(&(*المخطط).الحزم[الترتيب[ر]]));
        ر := ر + 1;
    }
    ليكن الحواف: متغير متجه حافة = [];
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        ليكن م: طبيعي = (*المخطط).الحواف[ح].المستورد;
        إذا (الجديد[م] != 0 && (!(*المخطط).الحواف[ح].للتطوير || م == الرقم)) {
            ليكن ح2: حافة = {
                المستورد: الجديد[م] - 1،
                الاسم: انسخ_نص(&(*المخطط).الحواف[ح].الاسم)،
                الهدف_رقم: الجديد[(*المخطط).الحواف[ح].الهدف_رقم] - 1،
                من_جت: (*المخطط).الحواف[ح].من_جت،
                للتطوير: (*المخطط).الحواف[ح].للتطوير
            };
            ألحق(الحواف، ح2);
        };
        ح := ح + 1;
    }
    ليكن الناتج: مخطط = { الجذر: انسخ_نص(&(*المخطط).الحزم[الرقم].الدليل)، الحزم: الحزم، الحواف: الحواف };
    أرجع الناتج;
}

// مخطط البناء: بلا حواف [dev-dependencies]، وبلا الحزم التي لا تصل إليها
// الحزمة الجذر (رقم 0) إلا بها. يكتبه build وcheck وrun وmetadata؛ أما
// test فيأخذ المخطط كله.
عام عرف بلا_التطوير(المخطط: &مخطط): مخطط {
    ليكن العدد: طبيعي = الطول((*المخطط).الحزم) مثل طبيعي;
    // الجديد[قديم] = رقم جديد + 1، أو 0 إن لم تُضف.
    ليكن الجديد: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الجديد، 0); ف := ف + 1; }
    ليكن الترتيب: متغير متجه طبيعي = [0];
    الجديد[0] := 1;
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الترتيب) مثل طبيعي)) {
        ليكن الحالي: طبيعي = الترتيب[ر];
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*المخطط).الحواف) مثل طبيعي)) {
            إذا ((*المخطط).الحواف[ح].المستورد == الحالي && !(*المخطط).الحواف[ح].للتطوير) {
                ليكن ه: طبيعي = (*المخطط).الحواف[ح].الهدف_رقم;
                إذا (الجديد[ه] == 0) {
                    ألحق(الترتيب، ه);
                    الجديد[ه] := الطول(الترتيب) مثل طبيعي;
                };
            };
            ح := ح + 1;
        }
        ر := ر + 1;
    }
    // الترتيب الأصلي للحزم الباقية، فيبقى المخطط المكتوب كما كان بلا [dev-dependencies].
    ليكن الحزم: متغير متجه حزمة = [];
    ليكن الرقم_الجديد: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (الجديد[ف] != 0) {
            ألحق(الرقم_الجديد، الطول(الحزم) مثل طبيعي);
            ألحق(الحزم، استنسخ(&(*المخطط).الحزم[ف]));
        } وإلا {
            ألحق(الرقم_الجديد، 0);
        };
        ف := ف + 1;
    }
    ليكن الحواف: متغير متجه حافة = [];
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        ليكن م: طبيعي = (*المخطط).الحواف[ح].المستورد;
        إذا (الجديد[م] != 0 && !(*المخطط).الحواف[ح].للتطوير) {
            ليكن ح2: حافة = {
                المستورد: الرقم_الجديد[م]،
                الاسم: انسخ_نص(&(*المخطط).الحواف[ح].الاسم)،
                الهدف_رقم: الرقم_الجديد[(*المخطط).الحواف[ح].الهدف_رقم]،
                من_جت: (*المخطط).الحواف[ح].من_جت،
                للتطوير: خطأ
            };
            ألحق(الحواف، ح2);
        };
        ح := ح + 1;
    }
    ليكن الناتج: مخطط = { الجذر: انسخ_نص(&(*المخطط).الجذر)، الحزم: الحزم، الحواف: الحواف };
    أرجع الناتج;
}

عام عرف طابق_جت(الاعتمادية: &اعتمادية): منطقي {
    طابق انسخ_اختيار_نص(&(*الاعتمادية).الجت) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// يحول فواصل ويندوز «\» إلى «/».
عام عرف بفواصل_أمامية(المسار: &نص): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(المسار)) {
        إذا ((*المسار)[ف] == 92) { ألحق(البايتات، 47); } وإلا { ألحق(البايتات، (*المسار)[ف]); };
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}
