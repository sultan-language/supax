// نموذج مخطط الاعتماديات.
استورد المكتبة.مجموعات.sort;
استورد المكتبة.مجموعات.vector;
استورد المكتبة.تشفير.sha256;
استورد المكتبة.بيئة.environment;
استورد المكتبة.بيئة.variables;
استورد المكتبة.عمليات.arguments;
استورد المكتبة.عمليات.child;
استورد المكتبة.عمليات.command;
استورد المكتبة.عمليات.exit;
استورد المكتبة.تومل.parser;
استورد المكتبة.ترميز.hex;
استورد المكتبة.دخ.println;
استورد المكتبة.ملفات.canonical;
استورد المكتبة.ملفات.directory;
استورد المكتبة.ملفات.mutation;
استورد المكتبة.ملفات.path;
استورد المكتبة.ملفات.permissions;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.ملفات.temporary;
استورد المكتبة.ملفات.walk;
استورد المكتبة.ملفات.write_file;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.نصوص.number;
استورد المكتبة.نصوص.search;
استورد المكتبة.نصوص.transform;
استورد سوباكس.support.text;
استورد سوباكس.manifest.manifest;

عام نوع مصدر_حزمة =
    | جذر
    | مسار
    | جت
;

عام نوع حزمة = {
    المصدر: مصدر_حزمة,
    الاسم: نص,
    الإصدار: اختياري نص,
    الدليل: نص,
    الأسماء: متجه تهجئة,
    // حقائق git؛ تشترك فيها الحزم المسارية داخل نسخة git.
    الرابط: نص,
    الهوية: نص,
    نوع_المرجع: نوع_مرجع_جت,
    المرجع: نص,
    الالتزام: نص,
    البصمة: نص,
    جذر_النسخة: نص,
    // داخل نسخة git: المسار من جذر النسخة («» للجذر نفسه).
    المسار_الفرعي: نص,
    // حزمة مسارية خارج git: مسارها نسبة إلى المشروع، بفواصل «/».
    المسار_النسبي: نص,
    الطالب: نص,
    المعلنة: متجه اعتمادية,
    // من البيان: دليل المصدر ([lib] أو دليل البيان)، والمدخل، ومرادفات الاستيراد.
    جذر_المصدر: نص,
    المدخل: اختياري نص,
    المرادفات: متجه مرادف_استيراد,
    // رابط فهرس الحزم إن جاءت الحزمة منه، وإلا «».
    السجل: نص
};

عام نوع حافة = { المستورد: طبيعي, الاسم: نص, الهدف_رقم: طبيعي, من_جت: منطقي };

عام نوع مخطط = { الجذر: نص, الحزم: متجه حزمة, الحواف: متجه حافة };

عام نوع خيارات_الحل = {
    بلا_شبكة: منطقي,
    مقفول: منطقي,
    تحديث_الكل: منطقي,
    تحديث: متجه نص
};

عام عرف هل_جت(المصدر: &مصدر_حزمة): منطقي {
    طابق *المصدر مع
    | مصدر_حزمة.جت -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف مختصر(الالتزام: &نص): نص {
    أرجع شريحة_نص(الالتزام, 0, 12);
}

عام عرف اسم_المصدر(المصدر: &مصدر_حزمة): نص {
    طابق *المصدر مع
    | مصدر_حزمة.جذر -> { أرجع «root»; }
    | مصدر_حزمة.مسار -> { أرجع «path»; }
    | مصدر_حزمة.جت -> { أرجع «git»; };
}
