// نموذج مخطط الاعتماديات.
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.مجموعات.متجهات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.عمليات.الوسائط;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.اخرج;
استورد المكتبة.تومل.محلل;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.أذونات;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;
استورد سوباكس.support.text;
استورد سوباكس.manifest.manifest;

عام نوع مصدر_حزمة =
    | جذر
    | مسار
    | جت
;

عام نوع حزمة = {
    المصدر: مصدر_حزمة،
    الاسم: نص،
    الإصدار: اختياري نص،
    الدليل: نص،
    الأسماء: متجه تهجئة،
    // حقائق git؛ تشترك فيها الحزم المسارية داخل نسخة git.
    الرابط: نص،
    الهوية: نص،
    نوع_المرجع: نوع_مرجع_جت،
    المرجع: نص،
    الالتزام: نص،
    البصمة: نص،
    جذر_النسخة: نص،
    // داخل نسخة git: المسار من جذر النسخة («» للجذر نفسه).
    المسار_الفرعي: نص،
    // حزمة مسارية خارج git: مسارها نسبة إلى المشروع، بفواصل «/».
    المسار_النسبي: نص،
    الطالب: نص،
    المعلنة: متجه اعتمادية،
    // [dev-dependencies]: للحزم الجذر وحدها (أعضاء المساحة)، كما في Cargo.
    المعلنة_للتطوير: متجه اعتمادية،
    // من البيان: دليل المصدر ([lib] أو دليل البيان)، والمدخل، ومرادفات الاستيراد.
    جذر_المصدر: نص،
    المدخل: اختياري نص،
    المرادفات: متجه مرادف_استيراد،
    // رابط فهرس الحزم إن جاءت الحزمة منه، وإلا «».
    السجل: نص
};

// للتطوير: حافة من [dev-dependencies]؛ في مخطط الاختبارات وحده.
عام نوع حافة = { المستورد: طبيعي، الاسم: نص، الهدف_رقم: طبيعي، من_جت: منطقي، للتطوير: منطقي };

عام نوع مخطط = { الجذر: نص، الحزم: متجه حزمة، الحواف: متجه حافة };

عام نوع خيارات_الحل = {
    بلا_شبكة: منطقي،
    مقفول: منطقي،
    تحديث_الكل: منطقي،
    تحديث: متجه نص،
    // supax install: الاعتمادية المباشرة للجذر قد تكون برامج بلا [lib].
    للتثبيت: منطقي
};

عام عرف هل_جت(المصدر: &مصدر_حزمة): منطقي {
    طابق *المصدر مع
    | مصدر_حزمة.جت -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف مختصر(الالتزام: &نص): نص {
    أرجع شريحة_نص(الالتزام، 0، 12);
}

عام عرف اسم_المصدر(المصدر: &مصدر_حزمة): نص {
    طابق *المصدر مع
    | مصدر_حزمة.جذر -> { أرجع «root»; }
    | مصدر_حزمة.مسار -> { أرجع «path»; }
    | مصدر_حزمة.جت -> { أرجع «git»; };
}
