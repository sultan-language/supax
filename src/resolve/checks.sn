عام عرف ابحث_عن_دورة(
    المخطط: &مخطط،
    العقدة: طبيعي،
    الحالة: &متغير متجه طبيعي،
    المسار: &متغير متجه طبيعي
): اختياري متجه طبيعي {
    (*الحالة)[العقدة] := 1;
    ألحق(*المسار، العقدة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        // حواف [dev-dependencies] لا تدخل البناء، فلا تصنع دورة (كما في Cargo).
        إذا ((*المخطط).الحواف[ف].المستورد == العقدة && !(*المخطط).الحواف[ف].للتطوير) {
            ليكن الهدف: طبيعي = (*المخطط).الحواف[ف].الهدف_رقم;
            إذا ((*الحالة)[الهدف] == 1) {
                ليكن الدورة: متغير متجه طبيعي = [];
                ليكن بدأت: متغير منطقي = خطأ;
                ليكن ح: متغير طبيعي = 0;
                طالما (ح < (الطول(*المسار) مثل طبيعي)) {
                    إذا ((*المسار)[ح] == الهدف) { بدأت := صواب; };
                    إذا (بدأت) { ألحق(الدورة، (*المسار)[ح]); };
                    ح := ح + 1;
                }
                ألحق(الدورة، الهدف);
                أرجع اختياري.موجود(الدورة);
            };
            إذا ((*الحالة)[الهدف] == 0) {
                طابق ابحث_عن_دورة(المخطط، الهدف، الحالة، المسار) مع
                | اختياري.موجود(د) -> { أرجع اختياري.موجود(د); }
                | اختياري.لا_شيء -> { };
            };
        };
        ف := ف + 1;
    }
    (*الحالة)[العقدة] := 2;
    ليكن المحذوف: اختياري طبيعي = اسحب_الأخير(المسار);
    أرجع اختياري.لا_شيء();
}

عام عرف اسحب_الأخير(القيم: &متغير متجه طبيعي): اختياري طبيعي {
    ليكن العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    ليكن الجديد: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف + 1 < العدد) { ألحق(الجديد، (*القيم)[ف]); ف := ف + 1; }
    ليكن الأخير: طبيعي = (*القيم)[العدد - 1];
    *القيم := الجديد;
    أرجع اختياري.موجود(الأخير);
}

عام عرف تحقق_من_الدورات(المخطط: &مخطط): نتيجة نص، نص {
    ليكن الحالة: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحزم) مثل طبيعي)) { ألحق(الحالة، 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*المخطط).الحزم) مثل طبيعي)) {
        إذا (الحالة[ف] == 0) {
            ليكن المسار: متغير متجه طبيعي = [];
            طابق ابحث_عن_دورة(المخطط، ف، &متغير الحالة، &متغير المسار) مع
            | اختياري.موجود(الدورة) -> {
                ليكن الأسماء: متغير متجه نص = [];
                ليكن ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الدورة) مثل طبيعي)) {
                    ألحق(الأسماء، انسخ_نص(&(*المخطط).الحزم[الدورة[ح]].الاسم));
                    ح := ح + 1;
                }
                ليكن الفاصل: نص = « ← »;
                أرجع نتيجة.خطأ(ضم([رسالة(«دورة اعتماديات: »، «dependency cycle: »)، صل_النصوص(&الأسماء، &الفاصل)]));
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(«»);
}

عام نوع تهجئة_مرئية = { المفتاح: نص، الأصل: نص، الهدف: طبيعي };

عام عرف أضف_مرئية(القائمة: &متغير متجه تهجئة_مرئية، النص: &نص، الهدف: طبيعي): فراغ {
    ليكن م: تهجئة_مرئية = { المفتاح: مفتاح_الهوية(النص)، الأصل: انسخ_نص(النص)، الهدف: الهدف };
    ألحق(*القائمة، م);
}

// كل حزمة ترى: أسماءها، والمكتبة القياسية، ولكل اعتمادية مفتاحها واسم
// حزمتها وتهجئاتها (كما يسجلها المترجم في package_environment.sn). اسمان
// متطابقان هويةً يشيران إلى حزمتين مختلفتين = تصادم.
عام عرف تحقق_من_التصادم(المخطط: &مخطط): نتيجة نص، نص {
    ليكن المكتبة: طبيعي = 1000000000;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحزم) مثل طبيعي)) {
        ليكن المرئية: متغير متجه تهجئة_مرئية = [];
        أضف_مرئية(&متغير المرئية، &«std»، المكتبة);
        أضف_مرئية(&متغير المرئية، &«المكتبة»، المكتبة);
        أضف_مرئية(&متغير المرئية، &(*المخطط).الحزم[ف].الاسم، ف);
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*المخطط).الحزم[ف].الأسماء) مثل طبيعي)) {
            أضف_مرئية(&متغير المرئية، &(*المخطط).الحزم[ف].الأسماء[ت].التهجئة، ف);
            ت := ت + 1;
        }
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*المخطط).الحواف) مثل طبيعي)) {
            إذا ((*المخطط).الحواف[ح].المستورد == ف) {
                ليكن الهدف: طبيعي = (*المخطط).الحواف[ح].الهدف_رقم;
                أضف_مرئية(&متغير المرئية، &(*المخطط).الحواف[ح].الاسم، الهدف);
                أضف_مرئية(&متغير المرئية، &(*المخطط).الحزم[الهدف].الاسم، الهدف);
                ليكن ر: متغير طبيعي = 0;
                طالما (ر < (الطول((*المخطط).الحزم[الهدف].الأسماء) مثل طبيعي)) {
                    أضف_مرئية(&متغير المرئية، &(*المخطط).الحزم[الهدف].الأسماء[ر].التهجئة، الهدف);
                    ر := ر + 1;
                }
            };
            ح := ح + 1;
        }
        ليكن أ: متغير طبيعي = 0;
        طالما (أ < (الطول(المرئية) مثل طبيعي)) {
            ليكن ب: متغير طبيعي = أ + 1;
            طالما (ب < (الطول(المرئية) مثل طبيعي)) {
                إذا (نصان_متساويان(&المرئية[أ].المفتاح، &المرئية[ب].المفتاح) && المرئية[أ].الهدف != المرئية[ب].الهدف) {
                    أرجع نتيجة.خطأ(ضم([رسالة(«تصادم أسماء في الحزمة "»، «name collision in package "»)، انسخ_نص(&(*المخطط).الحزم[ف].الاسم)، «": "»،
                        انسخ_نص(&المرئية[أ].الأصل)، رسالة(«" و"»، «" and "»)، انسخ_نص(&المرئية[ب].الأصل)،
                        رسالة(«" اسم واحد بعد تطبيع الهوية، ويشيران إلى حزمتين مختلفتين»، «" are one name after identity folding but point to different packages»)]));
                };
                ب := ب + 1;
            }
            أ := أ + 1;
        }
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(«»);
}
