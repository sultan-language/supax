عام عرف فيه_جت(المخطط: &مخطط): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        إذا ((*المخطط).الحواف[ف].من_جت) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف اكتب_نص_الخريطة(المخطط: &مخطط): نص {
    دع الأجزاء: متغير متجه نص = [
        «# خريطة الاعتماديات المحلولة لـ --dependency-map. Resolved dependency map for sultanc --dependency-map.», سطر_جديد(),
        «version = 1», سطر_جديد()
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        دع ح: &حافة = &(*المخطط).الحواف[ف];
        إذا ((*ح).من_جت) {
            ألحق(الأجزاء, سطر_جديد());
            ألحق(الأجزاء, «[[dependency]]»);
            ألحق(الأجزاء, سطر_جديد());
            ألحق(الأجزاء, سطر_مفتاح(«importer», &(*المخطط).الحزم[(*ح).المستورد].الدليل));
            ألحق(الأجزاء, سطر_مفتاح(«name», &(*ح).الاسم));
            ألحق(الأجزاء, سطر_مفتاح(«directory», &(*المخطط).الحزم[(*ح).الهدف_رقم].الدليل));
        };
        ف := ف + 1;
    }
    أرجع ضم(الأجزاء);
}
