استورد سوباكس.resolve.model;

عام عرف اسم_القفل(): نص { أرجع «Supax.lock»; }

عام عرف إصدار_القفل(): نص { أرجع «1»; }

عام نوع مدخل_قفل = {
    الاسم: نص،
    المصدر: نص،
    الرابط: نص،
    الهوية: نص،
    نوع_المرجع: نوع_مرجع_جت،
    المرجع: نص،
    الالتزام: نص،
    البصمة: نص،
    المسار_الفرعي: نص،
    // لحزم الفهرس: الإصدار ورابط الفهرس.
    الإصدار: نص،
    السجل: نص
};

عام نوع قفل = { موجود: منطقي، المداخل: متجه مدخل_قفل };

عام عرف قفل_فارغ(): قفل {
    ليكن المداخل: متجه مدخل_قفل = [];
    ليكن ق: قفل = { موجود: خطأ، المداخل: المداخل };
    أرجع ق;
}

عام عرف نص_أو_فارغ(ق: اختياري نص): نص {
    طابق ق مع
    | اختياري.موجود(ن) -> { أرجع ن; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عام عرف اقرأ_القفل(دليل_المشروع: &نص): نتيجة قفل، نص {
    ليكن الاسم: نص = اسم_القفل();
    ليكن المسار: نص = صل_المسار(دليل_المشروع، &الاسم);
    إذا (!ملف_باسم_دقيق(دليل_المشروع، &الاسم)) { أرجع نتيجة.نجح(قفل_فارغ()); };
    ليكن الملف: ملف_تومل = اقرأ_ملف_تومل(&المسار)؟;
    ليكن الوثيقة: &وثيقة_تومل = &الملف.الوثيقة;
    ليكن الجذر: طبيعي = الملف.الوثيقة.الجذر;
    ليكن مفتاح_الإصدار: نص = «version»;
    ليكن الإصدار: متغير نص = «»;
    طابق قيمة_مفتاح_تومل(الوثيقة، الجذر، &مفتاح_الإصدار) مع
    | اختياري.موجود(ق) -> {
        طابق قيمة_عددية(&ق) مع
        | اختياري.موجود(ن) -> { الإصدار := ن; }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    ليكن المتوقع: نص = إصدار_القفل();
    إذا (!نصان_متساويان(&الإصدار، &المتوقع)) {
        أرجع نتيجة.خطأ(ضم([المسار، رسالة(«: إصدار ملف القفل غير مدعوم (المتوقع version = 1)»، «: unsupported lock file version (expected version = 1)»)]));
    };
    ليكن المداخل: متغير متجه مدخل_قفل = [];
    ليكن مفتاح_الحزم: نص = «package»;
    طابق قيمة_مفتاح_تومل(الوثيقة، الجذر، &مفتاح_الحزم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        ليكن فهرس_المصفوفة: طبيعي;
        طابق قيمة_مصفوفة(&القيمة) مع
        | اختياري.موجود(ف) -> { فهرس_المصفوفة := ف; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([المسار، رسالة(«: [[package]] يجب أن يكون مصفوفة جداول»، «: [[package]] must be an array of tables»)])); };
        ليكن القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة، فهرس_المصفوفة);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            ليكن الجدول: طبيعي;
            طابق قيمة_جدول(&القيم[ف]) مع
            | اختياري.موجود(ج) -> { الجدول := ج; }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(ضم([المسار، رسالة(«: مدخل [[package]] ليس جدولا»، «: a [[package]] entry is not a table»)])); };
            ليكن الاسم_المقفول: نص = نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «name»));
            ليكن المصدر: نص = نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «source»));
            ليكن الرابط: نص = نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «git»));
            ليكن الهوية: متغير نص = «»;
            ليكن نوع_المرجع: متغير نوع_مرجع_جت = نوع_مرجع_جت.الفرع_الافتراضي();
            ليكن المرجع: متغير نص = «»;
            إذا (يساوي_نصا(&المصدر، «git») || يساوي_نصا(&المصدر، «registry»)) {
                طابق هوية_رابط_جت(&الرابط) مع
                | نتيجة.نجح(ه) -> { الهوية := ه; }
                | نتيجة.خطأ(السبب) -> { أرجع نتيجة.خطأ(ضم([المسار، «: »، السبب])); };
                طابق نص_في_جدول(الوثيقة، الجدول، «tag») مع
                | اختياري.موجود(ق) -> { نوع_المرجع := نوع_مرجع_جت.وسم(); المرجع := ق; } | اختياري.لا_شيء -> { };
                طابق نص_في_جدول(الوثيقة، الجدول، «branch») مع
                | اختياري.موجود(ق) -> { نوع_المرجع := نوع_مرجع_جت.فرع(); المرجع := ق; } | اختياري.لا_شيء -> { };
                طابق نص_في_جدول(الوثيقة، الجدول، «rev») مع
                | اختياري.موجود(ق) -> { نوع_المرجع := نوع_مرجع_جت.مراجعة(); المرجع := ق; } | اختياري.لا_شيء -> { };
            };
            ليكن المدخل: مدخل_قفل = {
                الاسم: الاسم_المقفول،
                المصدر: المصدر،
                الرابط: الرابط،
                الهوية: الهوية،
                نوع_المرجع: نوع_المرجع،
                المرجع: المرجع،
                الالتزام: نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «commit»))،
                البصمة: نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «checksum»))،
                المسار_الفرعي: نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «subdirectory»))،
                الإصدار: نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «version»))،
                السجل: نص_أو_فارغ(نص_في_جدول(الوثيقة، الجدول، «registry»))
            };
            ألحق(المداخل، المدخل);
            ف := ف + 1;
        }
    };
    ليكن الناتج: قفل = { موجود: صواب، المداخل: المداخل };
    أرجع نتيجة.نجح(الناتج);
}

// مفتاح ترتيب ثابت: الاسم ثم المصدر.
عام عرف مفتاح_الترتيب(الحزمة: &حزمة): نص {
    أرجع ضم([انسخ_نص(&(*الحزمة).الاسم)، «|»، انسخ_نص(&(*الحزمة).الهوية)، «|»، انسخ_نص(&(*الحزمة).المسار_الفرعي)،
        «|»، انسخ_نص(&(*الحزمة).المسار_النسبي)، «|»، انسخ_نص(&(*الحزمة).الالتزام)]);
}

عام عرف أسماء_اعتماديات(المخطط: &مخطط، الحزمة: طبيعي): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        إذا ((*المخطط).الحواف[ف].المستورد == الحزمة) {
            // اسم مكرر في المخطط (إصداران من حزمة واحدة): «الاسم الإصدار»، كما في Cargo.lock.
            ليكن الهدف: &حزمة = &(*المخطط).الحزم[(*المخطط).الحواف[ف].الهدف_رقم];
            ليكن مكرر: متغير منطقي = خطأ;
            ليكن ز: متغير طبيعي = 0;
            طالما (ز < (الطول((*المخطط).الحزم) مثل طبيعي)) {
                إذا (ز != (*المخطط).الحواف[ف].الهدف_رقم && نصان_متساويان(&(*المخطط).الحزم[ز].الاسم، &(*الهدف).الاسم)) { مكرر := صواب; };
                ز := ز + 1;
            }
            إذا (مكرر) {
                ألحق(الناتج، ضم([انسخ_نص(&(*الهدف).الاسم)، « »، نص_أو_فارغ(انسخ_اختيار_نص(&(*الهدف).الإصدار))]));
            } وإلا {
                ألحق(الناتج، انسخ_نص(&(*الهدف).الاسم));
            };
        };
        ف := ف + 1;
    }
    رتب_نصوص(&متغير الناتج);
    أرجع الناتج;
}

عام عرف سطر_مفتاح(المفتاح: نص، القيمة: &نص): نص {
    أرجع ضم([المفتاح، « = »، نص_تومل(القيمة)، سطر_جديد()]);
}

// ترتيب الحزم للكتابة: الجذر أولا ثم البقية بمفتاح الترتيب.
عام عرف ترتيب_الكتابة(المخطط: &مخطط): متجه طبيعي {
    ليكن المفاتيح: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول((*المخطط).الحزم) مثل طبيعي)) {
        ألحق(المفاتيح، ضم([مفتاح_الترتيب(&(*المخطط).الحزم[ف])، «|»، رقم_نصا(ف)]));
        ف := ف + 1;
    }
    رتب_نصوص(&متغير المفاتيح);
    ليكن الناتج: متغير متجه طبيعي = [0];
    ف := 0;
    طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
        // الفهرس بعد آخر «|».
        ليكن م: &نص = &المفاتيح[ف];
        ليكن ل: طبيعي = طول_النص(م);
        ليكن ب: متغير طبيعي = ل;
        طالما (ب > 0 && (*م)[ب - 1] != 124) { ب := ب - 1; }
        ليكن الفهرس: متغير طبيعي = 0;
        ليكن ح: متغير طبيعي = ب;
        طالما (ح < ل) { الفهرس := الفهرس * 10 + (((*م)[ح] - 48) مثل طبيعي); ح := ح + 1; }
        ألحق(الناتج، الفهرس);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اكتب_نص_القفل(المخطط: &مخطط): نص {
    ليكن الأجزاء: متغير متجه نص = [
        «# يكتب سوباكس هذا الملف تلقائيا؛ لا تعدّله يدويا. Written by Supax; do not edit by hand.»، سطر_جديد()،
        «version = 1»، سطر_جديد()
    ];
    ليكن الترتيب: متجه طبيعي = ترتيب_الكتابة(المخطط);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الترتيب) مثل طبيعي)) {
        ليكن ح: &حزمة = &(*المخطط).الحزم[الترتيب[ف]];
        ألحق(الأجزاء، سطر_جديد());
        ألحق(الأجزاء، «[[package]]»);
        ألحق(الأجزاء، سطر_جديد());
        ألحق(الأجزاء، سطر_مفتاح(«name»، &(*ح).الاسم));
        طابق انسخ_اختيار_نص(&(*ح).الإصدار) مع
        | اختياري.موجود(ق) -> { ألحق(الأجزاء، سطر_مفتاح(«version»، &ق)); }
        | اختياري.لا_شيء -> { };
        إذا (طول_النص(&(*ح).السجل) > 0) {
            // حزمة من الفهرس: يكفي الإصدار والفهرس؛ git والالتزام والبصمة للتحقق دون الفهرس.
            ألحق(الأجزاء، سطر_مفتاح(«source»، &«registry»));
            ألحق(الأجزاء، سطر_مفتاح(«registry»، &(*ح).السجل));
            ألحق(الأجزاء، سطر_مفتاح(«git»، &(*ح).الرابط));
            ألحق(الأجزاء، سطر_مفتاح(«commit»، &(*ح).الالتزام));
            ألحق(الأجزاء، سطر_مفتاح(«checksum»، &(*ح).البصمة));
        } وإلا {
            ألحق(الأجزاء، سطر_مفتاح(«source»، &اسم_المصدر(&(*ح).المصدر)));
            طابق (*ح).المصدر مع
            | مصدر_حزمة.مسار -> { ألحق(الأجزاء، سطر_مفتاح(«path»، &(*ح).المسار_النسبي)); }
            | مصدر_حزمة.جت -> {
                ألحق(الأجزاء، سطر_مفتاح(«git»، &(*ح).الرابط));
                طابق (*ح).نوع_المرجع مع
                | نوع_مرجع_جت.الفرع_الافتراضي -> { }
                | _ -> { ألحق(الأجزاء، سطر_مفتاح(اسم_نوع_المرجع((*ح).نوع_المرجع)، &(*ح).المرجع)); };
                إذا (طول_النص(&(*ح).المسار_الفرعي) > 0) {
                    ألحق(الأجزاء، سطر_مفتاح(«subdirectory»، &(*ح).المسار_الفرعي));
                };
                ألحق(الأجزاء، سطر_مفتاح(«commit»، &(*ح).الالتزام));
                ألحق(الأجزاء، سطر_مفتاح(«checksum»، &(*ح).البصمة));
            }
            | مصدر_حزمة.جذر -> { };
        };
        ليكن الاعتماديات: متجه نص = أسماء_اعتماديات(المخطط، الترتيب[ف]);
        إذا ((الطول(الاعتماديات) مثل طبيعي) > 0) {
            ليكن المقتبسة: متغير متجه نص = [];
            ليكن ح2: متغير طبيعي = 0;
            طالما (ح2 < (الطول(الاعتماديات) مثل طبيعي)) {
                ألحق(المقتبسة، نص_تومل(&الاعتماديات[ح2]));
                ح2 := ح2 + 1;
            }
            ليكن الفاصل: نص = «, »;
            ألحق(الأجزاء، ضم([«dependencies = [»، صل_النصوص(&المقتبسة، &الفاصل)، «]»، سطر_جديد()]));
        };
        ف := ف + 1;
    }
    أرجع ضم(الأجزاء);
}
