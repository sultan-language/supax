// للتطوير: يكتب حواف [dev-dependencies] وحدها، أو العادية وحدها.
عام عرف اكتب_فرع(المخطط: &مخطط, العقدة: طبيعي, البادئة: &نص, المعروضة: &متغير متجه منطقي, الأسطر: &متغير متجه نص, للتطوير: منطقي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        إذا ((*المخطط).الحواف[ف].المستورد == العقدة && (*المخطط).الحواف[ف].للتطوير == للتطوير) {
            دع الهدف: طبيعي = (*المخطط).الحواف[ف].الهدف_رقم;
            دع ح: &حزمة = &(*المخطط).الحزم[الهدف];
            دع الوصف: متغير نص = انسخ_نص(&(*ح).الاسم);
            طابق انسخ_اختيار_نص(&(*ح).الإصدار) مع
            | اختياري.موجود(ق) -> { الوصف := ضم([الوصف, « v», ق]); }
            | اختياري.لا_شيء -> { };
            طابق (*ح).المصدر مع
            | مصدر_حزمة.جت -> {
                // حزمة من الفهرس: الاسم والإصدار يكفيان.
                إذا (طول_النص(&(*ح).السجل) == 0) {
                    الوصف := ضم([الوصف, « (», انسخ_نص(&(*ح).الرابط), «#», مختصر(&(*ح).الالتزام), «)»]);
                };
            }
            | مصدر_حزمة.مسار -> { الوصف := ضم([الوصف, « (», انسخ_نص(&(*ح).المسار_النسبي), «)»]); }
            | مصدر_حزمة.جذر -> { };
            إذا ((*المعروضة)[الهدف]) {
                ألحق(*الأسطر, ضم([انسخ_نص(البادئة), «- », الوصف, « (*)»]));
            } وإلا {
                (*المعروضة)[الهدف] := صواب;
                ألحق(*الأسطر, ضم([انسخ_نص(البادئة), «- », الوصف]));
                دع التالية: نص = ضم([انسخ_نص(البادئة), «  »]);
                اكتب_فرع(المخطط, الهدف, &التالية, المعروضة, الأسطر, خطأ);
            };
        };
        ف := ف + 1;
    }
}

عام عرف نص_الشجرة(المخطط: &مخطط): نص {
    دع الأسطر: متغير متجه نص = [];
    دع المعروضة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المخطط).الحزم) مثل طبيعي)) { ألحق(المعروضة, خطأ); ف := ف + 1; }
    المعروضة[0] := صواب;
    دع الجذر: متغير نص = انسخ_نص(&(*المخطط).الحزم[0].الاسم);
    طابق انسخ_اختيار_نص(&(*المخطط).الحزم[0].الإصدار) مع
    | اختياري.موجود(ق) -> { الجذر := ضم([الجذر, « v», ق]); }
    | اختياري.لا_شيء -> { };
    ألحق(الأسطر, الجذر);
    دع البادئة: نص = «  »;
    اكتب_فرع(المخطط, 0, &البادئة, &متغير المعروضة, &متغير الأسطر, خطأ);
    // [dev-dependencies] بعد العادية، تحت عنوانها، كما في cargo tree.
    دع ف2: متغير طبيعي = 0;
    دع لها_تطوير: متغير منطقي = خطأ;
    طالما (ف2 < (الطول((*المخطط).الحواف) مثل طبيعي)) {
        إذا ((*المخطط).الحواف[ف2].المستورد == 0 && (*المخطط).الحواف[ف2].للتطوير) { لها_تطوير := صواب; };
        ف2 := ف2 + 1;
    }
    إذا (لها_تطوير) {
        ألحق(الأسطر, «[dev-dependencies]»);
        اكتب_فرع(المخطط, 0, &البادئة, &متغير المعروضة, &متغير الأسطر, صواب);
    };
    دع الفاصل: نص = سطر_جديد();
    أرجع ضم([صل_النصوص(&الأسطر, &الفاصل), سطر_جديد()]);
}
