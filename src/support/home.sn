// بيت سوباكس: $SUPAX_HOME، وإلا ~/.supax. فيه:
//   bin/                 supax و sultanc (يضيفه المستخدم إلى PATH)
//   lib/sultanc/library  المكتبة القياسية، يجدها sultanc تلقائيا
//   git/                 مخبأ الحزم
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.ملفات.مسار;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;

عام عرف بيت_سوباكس(): نتيجة نص, نص {
    دع الاسم: نص = «SUPAX_HOME»;
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا (طول_النص(&القيمة) > 0) { أرجع نتيجة.نجح(القيمة); };
    }
    | _ -> { };
    طابق الدليل_الرئيسي() مع
    | نتيجة.نجح(اختياري.موجود(البيت)) -> { أرجع نتيجة.نجح(صل_المسار(&البيت, &«.supax»)); }
    | _ -> {
        أرجع نتيجة.خطأ(رسالة(«تعذر تحديد الدليل الرئيسي للمستخدم؛ اضبط SUPAX_HOME», «cannot find the home directory; set SUPAX_HOME»));
    };
}
