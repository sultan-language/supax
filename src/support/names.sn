// قواعد أسماء الحزم ومساراتها.
//
// الاسم الآمن: نص UTF-8 صالح غير فارغ، لا يبدأ بـ «-» ولا «.», ولا يحوي فواصل
// مسارات ولا محارف تحكم ولا محارف اتجاه خفية ولا محارف صفرية العرض. هذه
// المحارف تجعل اسمين مختلفين يظهران متطابقين، وهي باب لانتحال الحزم.
استورد المكتبة.مجموعات.sort;
استورد المكتبة.مجموعات.vector;
استورد المكتبة.تشفير.sha256;
استورد المكتبة.بيئة.environment;
استورد المكتبة.بيئة.variables;
استورد المكتبة.عمليات.arguments;
استورد المكتبة.عمليات.child;
استورد المكتبة.عمليات.command;
استورد المكتبة.عمليات.exit;
استورد المكتبة.تومل.parser;
استورد المكتبة.ترميز.hex;
استورد المكتبة.دخ.println;
استورد المكتبة.ملفات.canonical;
استورد المكتبة.ملفات.directory;
استورد المكتبة.ملفات.mutation;
استورد المكتبة.ملفات.path;
استورد المكتبة.ملفات.permissions;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.ملفات.temporary;
استورد المكتبة.ملفات.walk;
استورد المكتبة.ملفات.write_file;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.نصوص.number;
استورد المكتبة.نصوص.search;
استورد المكتبة.نصوص.transform;
استورد سوباكس.support.text;

عام نوع محرف_مفكوك = { الطول: طبيعي, القيمة: ط32 };

// يفك محرفا واحدا من UTF-8؛ الطول صفر يعني ترميزا غير صالح.
عام عرف فك_محرف(النص: &نص, الموضع: طبيعي): محرف_مفكوك {
    دع غير_صالح: محرف_مفكوك = { الطول: 0, القيمة: 0 };
    دع النهاية: طبيعي = طول_النص(النص);
    دع أ: ط32 = (*النص)[الموضع] مثل ط32;
    إذا (أ < 0x80) {
        دع ن: محرف_مفكوك = { الطول: 1, القيمة: أ };
        أرجع ن;
    };
    إذا (أ >= 0xC2 && أ <= 0xDF && الموضع + 1 < النهاية) {
        دع ب: ط32 = (*النص)[الموضع + 1] مثل ط32;
        إذا ((ب & 0xC0) != 0x80) { أرجع غير_صالح; };
        دع ن: محرف_مفكوك = { الطول: 2, القيمة: ((أ & 0x1F) << 6) | (ب & 0x3F) };
        أرجع ن;
    };
    إذا (أ >= 0xE0 && أ <= 0xEF && الموضع + 2 < النهاية) {
        دع ب: ط32 = (*النص)[الموضع + 1] مثل ط32;
        دع ج: ط32 = (*النص)[الموضع + 2] مثل ط32;
        إذا ((ب & 0xC0) != 0x80 || (ج & 0xC0) != 0x80) { أرجع غير_صالح; };
        دع ق: ط32 = ((أ & 0x0F) << 12) | ((ب & 0x3F) << 6) | (ج & 0x3F);
        إذا (ق < 0x800 || (ق >= 0xD800 && ق <= 0xDFFF)) { أرجع غير_صالح; };
        دع ن: محرف_مفكوك = { الطول: 3, القيمة: ق };
        أرجع ن;
    };
    إذا (أ >= 0xF0 && أ <= 0xF4 && الموضع + 3 < النهاية) {
        دع ب: ط32 = (*النص)[الموضع + 1] مثل ط32;
        دع ج: ط32 = (*النص)[الموضع + 2] مثل ط32;
        دع د: ط32 = (*النص)[الموضع + 3] مثل ط32;
        إذا ((ب & 0xC0) != 0x80 || (ج & 0xC0) != 0x80 || (د & 0xC0) != 0x80) { أرجع غير_صالح; };
        دع ق: ط32 = ((أ & 0x07) << 18) | ((ب & 0x3F) << 12) | ((ج & 0x3F) << 6) | (د & 0x3F);
        إذا (ق < 0x10000 || ق > 0x10FFFF) { أرجع غير_صالح; };
        دع ن: محرف_مفكوك = { الطول: 4, القيمة: ق };
        أرجع ن;
    };
    أرجع غير_صالح;
}

// محارف لا تُرى أو تقلب اتجاه العرض.
عام عرف محرف_خفي(ق: ط32): منطقي {
    أرجع ق < 0x20 || ق == 0x7F
        || (ق >= 0x80 && ق < 0xA0)
        || ق == 0x061C
        || (ق >= 0x200B && ق <= 0x200F)
        || (ق >= 0x202A && ق <= 0x202E)
        || (ق >= 0x2060 && ق <= 0x2069)
        || ق == 0xFEFF;
}

عام عرف محرف_ممنوع_في_اسم(ق: ط32): منطقي {
    أرجع ق == 47 || ق == 92 || ق == 58 || ق == 32 || ق == 34 || ق == 39
        || ق == 42 || ق == 63 || ق == 60 || ق == 62 || ق == 124;
}

// هل يصلح النص اسما لحزمة أو مفتاحا لاعتمادية؟
عام عرف اسم_آمن(الاسم: &نص): منطقي {
    دع الطول_الكلي: طبيعي = طول_النص(الاسم);
    إذا (الطول_الكلي == 0 || الطول_الكلي > 128) { أرجع خطأ; };
    إذا ((*الاسم)[0] == 45 || (*الاسم)[0] == 46) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي) {
        دع م: محرف_مفكوك = فك_محرف(الاسم, ف);
        إذا (م.الطول == 0) { أرجع خطأ; };
        إذا (محرف_خفي(م.القيمة) || محرف_ممنوع_في_اسم(م.القيمة)) { أرجع خطأ; };
        ف := ف + م.الطول;
    }
    أرجع صواب;
}

// هوية المعرف كما يحسبها المترجم (compiler/frontend/identifier_identity.sn):
// تُحذف التطويلة U+0640 وتُطبع آ أ إ إلى ا. يُفترض أن الاسم آمن.
عام عرف مفتاح_الهوية(الاسم: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(الاسم)) {
        دع م: محرف_مفكوك = فك_محرف(الاسم, ف);
        إذا (م.الطول == 0) {
            ألحق(الناتج, (*الاسم)[ف]);
            ف := ف + 1;
        } وإلا {
            إذا (م.القيمة == 0x0622 || م.القيمة == 0x0623 || م.القيمة == 0x0625) {
                ألحق(الناتج, 0xD8);
                ألحق(الناتج, 0xA7);
            } وإلا إذا (م.القيمة != 0x0640) {
                دع ح: متغير طبيعي = 0;
                طالما (ح < م.الطول) {
                    ألحق(الناتج, (*الاسم)[ف + ح]);
                    ح := ح + 1;
                }
            };
            ف := ف + م.الطول;
        };
    }
    أرجع من_بايتات(&الناتج);
}

// يطبع مسارا نسبيا بفواصل «/» ويحذف «.» ويحل «..» لفظيا. يرفض المسار
// المطلق وكل «..» تخرج من الأصل. الناتج «.» للأصل نفسه.
عام عرف طبع_مسار_نسبي(المسار: &نص): اختياري نص {
    دع الطول_الكلي: طبيعي = طول_النص(المسار);
    إذا (الطول_الكلي == 0 || مسار_مطلق(المسار)) { أرجع اختياري.لا_شيء(); };
    إذا ((*المسار)[0] == 47 || (*المسار)[0] == 92) { أرجع اختياري.لا_شيء(); };
    إذا (الطول_الكلي >= 2 && (*المسار)[1] == 58) { أرجع اختياري.لا_شيء(); };
    دع الأجزاء: متغير متجه نص = [];
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الطول_الكلي) {
        دع نهاية_جزء: متغير منطقي = ف == الطول_الكلي;
        إذا (!نهاية_جزء) {
            نهاية_جزء := (*المسار)[ف] == 47 || (*المسار)[ف] == 92;
        };
        إذا (نهاية_جزء) {
            دع الجزء: نص = شريحة_نص(المسار, البداية, ف);
            إذا (طول_النص(&الجزء) == 2 && الجزء[0] == 46 && الجزء[1] == 46) {
                إذا (الطول(الأجزاء) == 0) { أرجع اختياري.لا_شيء(); };
                دع المحذوف: اختياري نص = أزل_عند(&متغير الأجزاء, (الطول(الأجزاء) مثل طبيعي) - 1);
            } وإلا إذا (طول_النص(&الجزء) == 0 || (طول_النص(&الجزء) == 1 && الجزء[0] == 46)) {
            } وإلا {
                ألحق(الأجزاء, الجزء);
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    إذا (الطول(الأجزاء) == 0) { أرجع اختياري.موجود(«.»); };
    دع الفاصل: نص = «/»;
    أرجع اختياري.موجود(صل_النصوص(&الأجزاء, &الفاصل));
}

// قواعد المعرف كما في المترجم (compiler/frontend/lexer/identifiers.sn):
// البداية حرف لاتيني أو عربي أو «_»، والتتمة تضيف الأرقام والتشكيل.
عرف بداية_معرف(ق: ط32): منطقي {
    أرجع (ق >= 0x41 && ق <= 0x5A) || (ق >= 0x61 && ق <= 0x7A)
        || (ق >= 0x0621 && ق <= 0x063A) || (ق >= 0x0641 && ق <= 0x064A)
        || (ق >= 0x066E && ق <= 0x066F) || (ق >= 0x0671 && ق <= 0x06D3)
        || (ق >= 0x06E5 && ق <= 0x06E6) || (ق >= 0x06EE && ق <= 0x06EF)
        || (ق >= 0x06FA && ق <= 0x06FC) || (ق >= 0x0750 && ق <= 0x077F)
        || (ق >= 0x08A0 && ق <= 0x08C9)
        || ق == 0x5F || ق == 0x06D5 || ق == 0x06FF || ق == 0x0640;
}

عرف تتمة_معرف(ق: ط32): منطقي {
    أرجع بداية_معرف(ق)
        || (ق >= 0x30 && ق <= 0x39) || (ق >= 0x064B && ق <= 0x065F)
        || (ق >= 0x0660 && ق <= 0x0669) || (ق >= 0x06D6 && ق <= 0x06DC)
        || (ق >= 0x06DF && ق <= 0x06E4) || (ق >= 0x06E7 && ق <= 0x06E8)
        || (ق >= 0x06EA && ق <= 0x06ED) || (ق >= 0x06F0 && ق <= 0x06F9)
        || (ق >= 0x08D3 && ق <= 0x08FF) || ق == 0x0670;
}

// هل النص معرف مصدر صالح (تهجئة_معرف_مصدر_صالحة في المترجم)؟ لا يفحص
// الكلمات المحجوزة؛ المترجم يرفضها حين يقرأ مخطط الحزم.
عام عرف معرف_صالح(النص: &نص): منطقي {
    دع الطول_الكلي: طبيعي = طول_النص(النص);
    إذا (الطول_الكلي == 0) { أرجع خطأ; };
    دع له_محتوى: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي) {
        دع م: محرف_مفكوك = فك_محرف(النص, ف);
        إذا (م.الطول == 0) { أرجع خطأ; };
        إذا (ف == 0) {
            إذا (!بداية_معرف(م.القيمة)) { أرجع خطأ; };
        } وإلا إذا (!تتمة_معرف(م.القيمة)) {
            أرجع خطأ;
        };
        إذا (م.القيمة != 0x0640) { له_محتوى := صواب; };
        ف := ف + م.الطول;
    }
    أرجع له_محتوى;
}

// مسار استيراد منقط (io أو text.number): كل جزء معرف صالح.
عام عرف مسار_استيراد_صالح(النص: &نص): منطقي {
    دع الطول_الكلي: طبيعي = طول_النص(النص);
    إذا (الطول_الكلي == 0) { أرجع خطأ; };
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الطول_الكلي) {
        إذا (ف == الطول_الكلي || (*النص)[ف] == 46) {
            دع الجزء: نص = شريحة_نص(النص, البداية, ف);
            إذا (!معرف_صالح(&الجزء)) { أرجع خطأ; };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}
