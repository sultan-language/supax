// أسطر الحالة على مجرى الأخطاء، كما يطبعها cargo («Compiling …» و «Finished …»):
// الفعل محاذى إلى اليمين في 12 خانة، ثم التفاصيل. يكتمها --quiet أو SUPAX_QUIET=1.
استورد المكتبة.دخ.println;
استورد المكتبة.بيئة.environment;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.time.time;
استورد سوباكس.support.text;
استورد سوباكس.support.messages;

عرف صامت(): منطقي {
    دع الاسم: نص = «SUPAX_QUIET»;
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        دع واحد: نص = «1»;
        أرجع نصان_متساويان(&القيمة, &واحد);
    }
    | _ -> { أرجع خطأ; };
}

// عدد المحارف (لا البايتات) في نص UTF-8.
عرف عدد_المحارف(النص: &نص): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(النص)) {
        إذا (((*النص)[ف] & 0xC0) != 0x80) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

// يطبع سطر حالة: «   Compiling app v0.1.0».
عام عرف أعلن(بالعربية: نص, بالإنجليزية: نص, التفاصيل: نص): فراغ {
    إذا (صامت()) { أرجع; };
    دع الفعل: نص = رسالة(بالعربية, بالإنجليزية);
    دع الحشو: متغير متجه نص = [];
    دع ف: متغير طبيعي = عدد_المحارف(&الفعل);
    طالما (ف < 12) {
        ألحق(الحشو, « »);
        ف := ف + 1;
    }
    اطبع_سطر_خطأ(ضم([ضم(الحشو), الفعل, « », التفاصيل]));
}

// الوقت الآن بالنانوثانية (ساعة رتيبة)، أو صفر إن لم تتوفر.
عام عرف الآن(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// المدة منذ البداية: «1.24s» أو «1.24 ث».
عام عرف منذ(البداية: عدد): نص {
    دع المدة: عدد = الآن() - البداية;
    دع المئات: عدد = (المدة + 5000000) / 10000000;
    دع الثواني: عدد = المئات / 100;
    دع الكسر: عدد = المئات % 100;
    دع كسر_نصي: متغير نص = رقم_نصا(الكسر مثل طبيعي);
    إذا (الكسر < 10) { كسر_نصي := ضم([«0», كسر_نصي]); };
    دع العدد: نص = ضم([رقم_نصا(الثواني مثل طبيعي), «.», كسر_نصي]);
    أرجع رسالة(ضم([انسخ_نص(&العدد), « ث»]), ضم([العدد, «s»]));
}
