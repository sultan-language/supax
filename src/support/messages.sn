// لغة رسائل سوباكس: العربية افتراضيا، والإنجليزية مع SUPAX_LANG=en أو الخيار --lang=en.
// لا تؤثر اللغة في الملفات التي يكتبها سوباكس (Supax.lock وخريطة الاعتماديات)؛
// فهي واحدة لكل المستخدمين.
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.نصوص.مقارنة;

عام عرف بالإنجليزية(): منطقي {
    دع الاسم: نص = «SUPAX_LANG»;
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        دع إنجليزية: نص = «en»;
        أرجع نصان_متساويان(&القيمة, &إنجليزية);
    }
    | _ -> { أرجع خطأ; };
}

// الرسالة بلغة المستخدم.
عام عرف رسالة(العربية: نص, الإنجليزية: نص): نص {
    إذا (بالإنجليزية()) { أرجع الإنجليزية; };
    أرجع العربية;
}
