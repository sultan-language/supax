// يصل الأجزاء بلا فاصل.
عام عرف ضم(الأجزاء: متجه نص): نص {
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عام عرف طول_النص(النص: &نص): طبيعي {
    أرجع الطول(*النص) مثل طبيعي;
}

// البايتات من البداية إلى ما قبل النهاية.
عام عرف شريحة_نص(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية && ف < طول_النص(النص)) {
        ألحق(البايتات, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// موضع أول ظهور للبايت ابتداء من موضع، أو طول النص إن لم يظهر.
عام عرف موضع_بايت(النص: &نص, البايت: ط8, البداية: طبيعي): طبيعي {
    دع ف: متغير طبيعي = البداية;
    طالما (ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == البايت) { أرجع ف; };
        ف := ف + 1;
    }
    أرجع طول_النص(النص);
}

// رقم السطر (يبدأ من 1) لإزاحة بايت في نص.
عام عرف سطر_الإزاحة(النص: &نص, الإزاحة: طبيعي): طبيعي {
    دع السطر: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الإزاحة && ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == 10) { السطر := السطر + 1; };
        ف := ف + 1;
    }
    أرجع السطر;
}

عام عرف رقم_نصا(القيمة: طبيعي): نص {
    أرجع طبيعي_إلى_نص(القيمة);
}

// نص بين علامتي تنصيص بصيغة TOML الأساسية، مع تهريب ما يلزم.
عام عرف نص_تومل(القيمة: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    ألحق(البايتات, 34);
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(القيمة)) {
        دع ب: ط8 = (*القيمة)[ف];
        إذا (ب == 34 || ب == 92) {
            ألحق(البايتات, 92);
            ألحق(البايتات, ب);
        } وإلا إذا (ب == 10) {
            ألحق(البايتات, 92);
            ألحق(البايتات, 110);
        } وإلا إذا (ب == 9) {
            ألحق(البايتات, 92);
            ألحق(البايتات, 116);
        } وإلا إذا (ب == 13) {
            ألحق(البايتات, 92);
            ألحق(البايتات, 114);
        } وإلا {
            ألحق(البايتات, ب);
        };
        ف := ف + 1;
    }
    ألحق(البايتات, 34);
    أرجع من_بايتات(&البايتات);
}

// محرف السطر الجديد (السلاسل «» لا تفسر \n).
عام عرف سطر_جديد(): نص {
    دع البايتات: متجه ط8 = [10];
    أرجع من_بايتات(&البايتات);
}
