// أدوات نصية صغيرة تشترك فيها وحدات سوباكس.
استورد المكتبة.مجموعات.ترتيب;
استورد المكتبة.مجموعات.متجهات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.متغيرات;
استورد المكتبة.عمليات.الوسائط;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.اخرج;
استورد المكتبة.تومل.محلل;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.أذونات;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;

// يصل الأجزاء بلا فاصل.
عام عرف ضم(الأجزاء: متجه نص): نص {
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء، &الفاصل);
}

عام عرف طول_النص(النص: &نص): طبيعي {
    أرجع الطول(*النص) مثل طبيعي;
}

// البايتات من البداية إلى ما قبل النهاية.
عام عرف شريحة_نص(النص: &نص، البداية: طبيعي، النهاية: طبيعي): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية && ف < طول_النص(النص)) {
        ألحق(البايتات، (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// موضع أول ظهور للبايت ابتداء من موضع، أو طول النص إن لم يظهر.
عام عرف موضع_بايت(النص: &نص، البايت: ط8، البداية: طبيعي): طبيعي {
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == البايت) { أرجع ف; };
        ف := ف + 1;
    }
    أرجع طول_النص(النص);
}

// رقم السطر (يبدأ من 1) لإزاحة بايت في نص.
عام عرف سطر_الإزاحة(النص: &نص، الإزاحة: طبيعي): طبيعي {
    ليكن السطر: متغير طبيعي = 1;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الإزاحة && ف < طول_النص(النص)) {
        إذا ((*النص)[ف] == 10) { السطر := السطر + 1; };
        ف := ف + 1;
    }
    أرجع السطر;
}

عام عرف رقم_نصا(القيمة: طبيعي): نص {
    أرجع طبيعي_إلى_نص(القيمة);
}

// نص بين علامتي تنصيص بصيغة TOML الأساسية، مع تهريب ما يلزم.
عام عرف نص_تومل(القيمة: &نص): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ألحق(البايتات، 34);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < طول_النص(القيمة)) {
        ليكن ب: ط8 = (*القيمة)[ف];
        إذا (ب == 34 || ب == 92) {
            ألحق(البايتات، 92);
            ألحق(البايتات، ب);
        } وإلا إذا (ب == 10) {
            ألحق(البايتات، 92);
            ألحق(البايتات، 110);
        } وإلا إذا (ب == 9) {
            ألحق(البايتات، 92);
            ألحق(البايتات، 116);
        } وإلا إذا (ب == 13) {
            ألحق(البايتات، 92);
            ألحق(البايتات، 114);
        } وإلا {
            ألحق(البايتات، ب);
        };
        ف := ف + 1;
    }
    ألحق(البايتات، 34);
    أرجع من_بايتات(&البايتات);
}

// محرف السطر الجديد (السلاسل «» لا تفسر \n).
عام عرف سطر_جديد(): نص {
    ليكن البايتات: متجه ط8 = [10];
    أرجع من_بايتات(&البايتات);
}
